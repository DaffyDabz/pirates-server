+    def getOceanSpawnPointFromSphere(self, sx, sy, sz):
+        """
+        Convert a client-style local deploy-sphere center into an ocean-grid
+        spawn point, including a small random offset inside the sphere radius.
+        """
+        radius = self.getSpacing() / 2.0
+        localX = random.uniform(sx - radius, sx + radius)
+        localY = random.uniform(sy - radius, sy + radius)
+        # Keep the whole hull clear of the tangible shore barrier (minRadius):
+        # the ship's collider sits at the bow, so a berth drawn on the inner
+        # edge put the bow inside the barrier and the client shoved the ship
+        # about with "too close to shore" the moment it spawned.
+        dist = math.sqrt(localX * localX + localY * localY)
+        floor = self.minRadius + 2.0 * radius
+        if 0 < dist < floor:
+            localX *= floor / dist
+            localY *= floor / dist

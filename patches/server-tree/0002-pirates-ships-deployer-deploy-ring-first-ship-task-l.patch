         return newObj
 
+    # One deploy berth, i.e. the diameter of a single deploy sphere. A war
+    # sloop hull is a little over 200 units long, so 400 leaves a ship's
+    # width of clearance between neighbouring berths.
+    SHIP_DEPLOY_SLOT = 400.0
+
+    def collectShoreDistances(self, objects, offset=(0.0, 0.0), out=None):
+        """
+        Walk authored object data and return the distance from the island
+        origin of every object that sits on the water: the moored dinghies
+        and the port blocker. Child Pos is relative to its parent, so parent
+        offsets are accumulated on the way down.
+        """
+        if out is None:
+            out = []
+
+        for obj in list(objects.values()):
+            if not isinstance(obj, dict):
+                continue
+
+            pos = obj.get('Pos', (0, 0, 0))
+            x = offset[0] + pos[0]
+            y = offset[1] + pos[1]
+
+            objType = obj.get('Type')
+            if objType == 'Dinghy':
+                out.append((x * x + y * y) ** 0.5)
+            elif objType in ('Port Collision Sphere', ObjectList.PORT_COLLISION):
+                scale = obj.get('Scale', (0, 0, 0))
+                radius = scale[0] if scale else 0
+                out.append((x * x + y * y) ** 0.5 + radius)
+
+            children = obj.get('Objects')
+            if children:
+                self.collectShoreDistances(children, (x, y), out)
+
+        return out
+
+    def measureShipDeployRadii(self, islandWorldData, objKey=None):
+        """
+        Derive (minRadius, maxRadius, spacing) for the island's ship deployer
+        from the island's own authored water-level objects.
+
+        These three numbers used to be taken from the island's LOD Sphere
+        'Radi' - which are *visibility* ranges. For Port Royal that is
+        [11520, 12520, 13520], putting the deploy ring 18280 units out and
+        walling ships off 11520 from shore, because minRadius is a tangible
+        collision sphere on the client (bug 2b, 2026-09-17).
+
+        minRadius is the furthest authored water-level object from the island
+        origin plus one berth, so the barrier clears the moored dinghies;
+        the ring itself then lands half a berth beyond that. maxRadius is the
+        outer dock boundary, a full berth beyond the ring.
+        """
+        slot = self.SHIP_DEPLOY_SLOT
+        objects = dict(islandWorldData.get('Objects', {}))
+
+        # The dinghies and the port blocker live in the island's OWN file,
+        # not in its entry in the world file, and that entry does not always
+        # carry a 'File' key - ask the world creator by uid instead.
+        fileName = islandWorldData.get('File')
+        if not fileName and objKey:
+            fileName = self.air.worldCreator.getObjectFilenameByUid(objKey)
+
+        if fileName:
+            fileData = self.air.worldCreator.openFile(fileName + '.py')
+            if fileData:
+                objects.update(fileData.get('Objects', {}))
+
+        distances = self.collectShoreDistances(objects)
+        if not distances:
+            self.notify.warning('Island %s (file %s) has no authored '
+                'water-level objects; falling back to its LOD min radius '
+                'for the ship deploy ring.' % (objKey, fileName))
+            return (islandWorldData.get('Radi', [1000])[0], None, slot)
+
+        minRadius = max(distances) + slot
+        return (minRadius, minRadius + 2 * slot, slot)
+
     def createIsland(self, objectData, parent, parentUid, objKey, dynamic):
         from pirates.world.DistributedIslandAI import DistributedIslandAI
         islandWorldData = self.air.worldCreator.getIslandWorldDataByUid(objKey)
@@ -173,6 +251,10 @@ class ClientAreaBuilderAI(DirectObject):
         if portCollisionSpheres:
             island.setPortCollisionSpheres(portCollisionSpheres)
 

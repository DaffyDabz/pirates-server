diff --git a/pirates/shipparts/DistributedShippart.py b/pirates/shipparts/DistributedShippart.py
index 956d635..74b234d 100644
--- a/pirates/shipparts/DistributedShippart.py
+++ b/pirates/shipparts/DistributedShippart.py
@@ -17,6 +17,7 @@ class DistributedShippart(DistributedNode.DistributedNode):
         self.classType = 0
         self.lastZoneLevel = 0
         self.ship = None
+        self._whenLoaded = []
         self.geomParent = None
         self.flash = None
         self.sentReadyMessage = 0
@@ -34,10 +35,39 @@ class DistributedShippart(DistributedNode.DistributedNode):
     def announceGenerate(self):
         DistributedNode.DistributedNode.announceGenerate(self)
         #self.pendingShipRequest = base.cr.relatedObjectMgr.requestObjects([self.shipId], eachCallback=self.load)
-        self.ship = self.cr.doId2do[self.shipId]
-        self.load()
+        self.pendingShipRequest = None
+        self.ship = self.cr.doId2do.get(self.shipId)
+        if self.ship is not None:
+            self.load()
+        else:
+            # a part can arrive before its ship when interest opens next to other ships
+            # (seen arriving at Devil's Anvil); a KeyError here crashed the client
+            def shipArrived(ship):
+                self.pendingShipRequest = None
+                self.ship = ship
+                self.load()
+                waiting, self._whenLoaded = getattr(self, '_whenLoaded', []), []
+                for fn in waiting:
+                    fn()
+
+            self.pendingShipRequest = self.cr.relatedObjectMgr.requestObjects([self.shipId], eachCallback = shipArrived)
+
+    def whenLoaded(self, fn):
+        # Subclass set-up that needs self.ship / self.prop. While the part is
+        # still waiting for its ship (see announceGenerate) there is no prop
+        # yet, so the set-up waits too instead of crashing the client
+        # (DistributedMast 'NoneType has no mastsState', Tortuga 2026-09-22).
+        if getattr(self, 'pendingShipRequest', None) is None and self.prop is not None:
+            fn()
+        else:
+            self.__dict__.setdefault('_whenLoaded', []).append(fn)
 
     def disable(self):
+        self._whenLoaded = []
+        if getattr(self, 'pendingShipRequest', None):
+            self.cr.relatedObjectMgr.abortRequest(self.pendingShipRequest)
+            self.pendingShipRequest = None
+
         self.unload()
         DistributedNode.DistributedNode.disable(self)
 

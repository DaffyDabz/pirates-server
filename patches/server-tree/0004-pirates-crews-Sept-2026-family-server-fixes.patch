+    # family server (2026-09-16): crew ships. POC never sent offerBandOptions nor
+    # handled selectBandShip, so a crewmate's ship never appeared at the dinghy.
+    def getOfferBandOptions(self, avatar):
+        bandOptions = []
+        for member in self.air.bandManager.getCrewmateMembers(avatar.doId):
+            ship = self.air.bandManager.getDeployedShip(member.avatarId)
+            if not ship or not self.canSelectShip(ship):
+                continue
+
+            # the client's ShipDeployPanel reads the ship name/class off the
+            # member object, so it must be current before the offer lands
+            self.air.bandManager.updateShipInfo(member.avatarId, ship)
+            captain = self.air.doId2do.get(ship.getCaptainId())
+            bandOptions.append([
+                member.doId,
+                ship.doId,
+                ship.getHp(),
+                ship.getSp(),
+                len(ship.getCargo()),
+                len(ship.getCrew()),
+                1,
+                ship.getSiegeTeam(),
+                captain and captain.getName() or member.name
+            ])
+
+        return bandOptions
+
+    def d_offerBandOptions(self, avatarId, bandOptions):
+        self.sendUpdateToAvatarId(avatarId, 'offerBandOptions', [bandOptions])
+
     def handlePostRequestInteraction(self, avatar):

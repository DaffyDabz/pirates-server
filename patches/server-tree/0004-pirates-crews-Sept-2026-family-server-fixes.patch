diff --git a/pirates/band/DistributedPirateBandManagerAI.py b/pirates/band/DistributedPirateBandManagerAI.py
index 4c5097f..67ecc77 100644
--- a/pirates/band/DistributedPirateBandManagerAI.py
+++ b/pirates/band/DistributedPirateBandManagerAI.py
@@ -1,8 +1,247 @@
 from direct.distributed.DistributedObjectAI import DistributedObjectAI
 from direct.directnotify import DirectNotifyGlobal
 
+from otp.distributed.OtpDoGlobals import OTP_ZONE_ID_MANAGEMENT
+from pirates.band import BandConstance
+from pirates.band.DistributedBandMemberAI import DistributedBandMemberAI
+
+
 class DistributedPirateBandManagerAI(DistributedObjectAI):
+    """family server (2026-09-16): the crew (band) server side was never written in
+    POC - the client sent requestInvite and sat on "Seeing if X is available"
+    forever. This is the minimum crew: invite / cancel / accept / decline, a
+    roster of DistributedBandMember objects (what the crew HUD lists), leave and
+    kick, and the ship info the dock dinghy needs to list a crewmate's ship
+    (DistributedDinghyAI.getOfferBandOptions / selectBandShip). Not built: the
+    crew chat owner view and teleport-to-crewmate."""
     notify = DirectNotifyGlobal.directNotify.newCategory('DistributedPirateBandManagerAI')
 
     def __init__(self, air):
-        DistributedObjectAI.__init__(self, air)
\ No newline at end of file
+        DistributedObjectAI.__init__(self, air)
+
+        self.pending = {}      # inviterId -> inviteeId
+        self.bands = {}        # bandId -> {'manager': avatarId, 'members': {avatarId: DistributedBandMemberAI}}
+        self.avatar2band = {}  # avatarId -> bandId
+        self.nextBandId = 1
+
+    # --- helpers ---------------------------------------------------------
+
+    def getPlayer(self, avatarId):
+        from pirates.pirate.DistributedPlayerPirateAI import DistributedPlayerPirateAI
+        avatar = self.air.doId2do.get(avatarId)
+        if not isinstance(avatar, DistributedPlayerPirateAI):
+            return None
+
+        return avatar
+
+    def getBandOf(self, avatarId):
+        bandId = self.avatar2band.get(avatarId)
+        return bandId, self.bands.get(bandId)
+
+    def getMember(self, avatarId):
+        bandId, band = self.getBandOf(avatarId)
+        if not band:
+            return None
+
+        return band['members'].get(avatarId)
+
+    def areCrewmates(self, avatarId, otherId):
+        bandId = self.avatar2band.get(avatarId)
+        return bandId is not None and avatarId != otherId and self.avatar2band.get(otherId) == bandId
+
+    def getCrewmateMembers(self, avatarId):
+        bandId, band = self.getBandOf(avatarId)
+        if not band:
+            return []
+
+        return [member for memberId, member in band['members'].items() if memberId != avatarId]
+
+    @staticmethod
+    def asNumber(value):
+        if isinstance(value, (list, tuple)):
+            return value[0]
+
+        return value
+
+    def d_requestOutCome(self, avatarId, targetId, outcome):
+        self.sendUpdateToAvatarId(avatarId, 'requestOutCome', [targetId, outcome])
+
+    # --- client -> AI ----------------------------------------------------
+
+    def requestInvite(self, avatarId):
+        inviterId = self.air.getAvatarIdFromSender()
+        inviter = self.getPlayer(inviterId)
+        if not inviter:
+            return
+
+        target = self.getPlayer(avatarId)
+        if not target or avatarId == inviterId:
+            self.d_requestOutCome(inviterId, avatarId, BandConstance.outcome_not_online)
+            return
+
+        if avatarId in self.avatar2band:
+            self.d_requestOutCome(inviterId, avatarId, BandConstance.outcome_already_in_Band)
+            return
+
+        if inviterId in self.pending or avatarId in self.pending.values():
+            self.d_requestOutCome(inviterId, avatarId, BandConstance.outcome_already_invited)
+            return
+
+        bandId, band = self.getBandOf(inviterId)
+        if band and len(band['members']) >= BandConstance.MAX_BAND_MEMBERS:
+            self.d_requestOutCome(inviterId, avatarId, BandConstance.outcome_full)
+            return
+
+        self.pending[inviterId] = avatarId
+        self.notify.info('crew: %d invites %d' % (inviterId, avatarId))
+        self.sendUpdateToAvatarId(avatarId, 'invitationFrom', [inviterId, inviter.getName()])
+
+    def requestCancel(self, avatarId):
+        inviterId = self.air.getAvatarIdFromSender()
+        if self.pending.get(inviterId) != avatarId:
+            return
+
+        del self.pending[inviterId]
+        self.sendUpdateToAvatarId(avatarId, 'invitationCancel', [inviterId])
+
+    def invitationResponce(self, avatarId, responce):
+        inviteeId = self.air.getAvatarIdFromSender()
+        inviterId = avatarId
+        if self.pending.get(inviterId) != inviteeId:
+            return
+
+        del self.pending[inviterId]
+        invitee = self.getPlayer(inviteeId)
+        inviter = self.getPlayer(inviterId)
+        if not invitee or not inviter:
+            return
+
+        if responce != BandConstance.outcome_ok:
+            self.d_requestOutCome(inviterId, inviteeId, responce or BandConstance.outcome_declined)
+            return
+
+        if inviteeId in self.avatar2band:
+            self.d_requestOutCome(inviterId, inviteeId, BandConstance.outcome_already_in_Band)
+            return
+
+        bandId, band = self.getBandOf(inviterId)
+        if not band:
+            bandId = self.createBand(inviter)
+            band = self.bands[bandId]
+
+        if len(band['members']) >= BandConstance.MAX_BAND_MEMBERS:
+            self.d_requestOutCome(inviterId, inviteeId, BandConstance.outcome_full)
+            return
+
+        self.addMember(bandId, invitee, 0)
+        self.d_requestOutCome(inviterId, inviteeId, BandConstance.outcome_ok)
+
+    def requestRemove(self, avatarId):
+        senderId = self.air.getAvatarIdFromSender()
+        bandId, band = self.getBandOf(senderId)
+        if not band or avatarId not in band['members']:
+            return
+
+        # leave yourself, or the captain removes a crewmate
+        if avatarId != senderId and band['manager'] != senderId:
+            return
+
+        self.removeMember(avatarId)
+
+    def requestCrewIconUpdate(self, iconKey):
+        senderId = self.air.getAvatarIdFromSender()
+        self.sendUpdateToAvatarId(senderId, 'receiveUpdatedCrewIcon', [iconKey])
+
+    # --- membership ------------------------------------------------------
+
+    def createBand(self, manager):
+        bandId = self.nextBandId
+        self.nextBandId += 1
+        self.bands[bandId] = {'manager': manager.doId, 'members': {}}
+        self.addMember(bandId, manager, 1)
+        return bandId
+
+    def addMember(self, bandId, avatar, isManager):
+        band = self.bands[bandId]
+        member = DistributedBandMemberAI(self.air)
+        member.avatarId = avatar.doId
+        member.name = avatar.getName()
+        # DistributedBattleAvatarAI.getHp() returns [hp, quietly]; the roster wants the number
+        member.hp = self.asNumber(avatar.getHp())
+        member.maxHp = self.asNumber(avatar.getMaxHp())
+        member.bandManagerId = self.doId
+        member.bandId = bandId
+        member.isManager = isManager
+        member.generateWithRequired(OTP_ZONE_ID_MANAGEMENT)
+
+        band['members'][avatar.doId] = member
+        self.avatar2band[avatar.doId] = bandId
+        avatar.sendUpdate('setBandId', [self.doId, bandId])
+        self.updateShipInfo(avatar.doId)
+        self.notify.info('crew %d: %s (%d) joined%s' % (bandId, avatar.getName(), avatar.doId,
+            isManager and ' as captain' or ''))
+
+    def removeMember(self, avatarId):
+        bandId, band = self.getBandOf(avatarId)
+        if not band:
+            return
+
+        member = band['members'].pop(avatarId, None)
+        del self.avatar2band[avatarId]
+        if member:
+            member.requestDelete()
+
+        avatar = self.getPlayer(avatarId)
+        if avatar:
+            avatar.sendUpdate('setBandId', [0, 0])
+
+        self.notify.info('crew %d: %d left' % (bandId, avatarId))
+
+        # a crew of one is no crew; otherwise hand the captaincy on
+        if len(band['members']) < 2:
+            for otherId in list(band['members']):
+                self.removeMember(otherId)
+        elif band['manager'] == avatarId:
+            newManagerId = next(iter(band['members']))
+            band['manager'] = newManagerId
+            band['members'][newManagerId].b_setIsManager(1)
+
+        if bandId in self.bands and not band['members']:
+            del self.bands[bandId]
+
+    def avatarOffline(self, avatarId):
+        self.pending.pop(avatarId, None)
+        for inviterId, inviteeId in list(self.pending.items()):
+            if inviteeId == avatarId:
+                del self.pending[inviterId]
+
+        if avatarId in self.avatar2band:
+            self.removeMember(avatarId)
+
+    # --- ship info for the dinghy's crew list ------------------------------
+
+    def getDeployedShip(self, avatarId):
+        for ship in self.air.shipManager.getPlayerShips():
+            if ship.getCaptainId() == avatarId:
+                return ship
+
+        return None
+
+    def updateShipInfo(self, avatarId, ship=None):
+        member = self.getMember(avatarId)
+        if not member:
+            return
+
+        ship = ship or self.getDeployedShip(avatarId)
+        if ship:
+            shipInfo = [ship.doId, ship.getName(), ship.getShipClass(), []]
+            hasSpace = len(ship.getCrew()) < ship.getMaxCrew()
+        else:
+            shipInfo = [0, '', 0, []]
+            hasSpace = False
+
+        if shipInfo != member.shipInfo:
+            member.b_setShipInfo(*shipInfo)
+
+        if hasSpace != member.shipHasSpace:
+            member.b_setShipHasSpace(hasSpace)

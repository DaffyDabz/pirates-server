+    def _getAreaOf(self, obj):
+        from pirates.world.DistributedGameAreaAI import DistributedGameAreaAI
+        while obj is not None:
+            if isinstance(obj, DistributedGameAreaAI):
+                return obj
+            obj = obj.getParentObj() if hasattr(obj, 'getParentObj') else None
+        return None
+
+    def _getIslandOfArea(self, area):
+        # an island, or the island a cave / jungle hangs off through its tunnels
+        from pirates.world.DistributedIslandAI import DistributedIslandAI
+        if area is None or isinstance(area, DistributedIslandAI):
+            return area
+        tunnels = []
+        for obj in list(self.air.doId2do.values()):
+            if type(obj).__name__ != 'DistributedGATunnelAI':
+                continue
+            try:
+                tunnels.append([link[2] for link in obj.getLinks()[2]])
+            except Exception:
+                continue
+        seen = set([area.getUniqueId()])
+        frontier = [area.getUniqueId()]
+        for depth in range(4):
+            nxt = []
+            for uid in frontier:
+                for links in tunnels:
+                    if uid not in links:
+                        continue
+                    for other in links:
+                        if other in seen:
+                            continue
+                        seen.add(other)
+                        otherObj = self.air.uidMgr.justGetMeMeObject(other)
+                        if isinstance(otherObj, DistributedIslandAI):
+                            return otherObj
+                        nxt.append(other)
+            frontier = nxt
+        return None
+
+    def _getEnemyGoalUid(self, goal):
+        try:
+            level, targetType = goal._QuestGoal__goalData[0], goal._QuestGoal__goalData[1]
+        except Exception:
+            return None
+        if targetType == 'ship' or not hasattr(targetType, 'isA'):
+            return None
+        from pirates.battle.DistributedBattleNPCAI import DistributedBattleNPCAI
+        myArea = self._getAreaOf(self)
+        myIsland = self._getIslandOfArea(myArea)
+        islandCache = {}
+        best = None
+        for obj in list(self.air.doId2do.values()):
+            if not isinstance(obj, DistributedBattleNPCAI):
+                continue
+            try:
+                if not obj.getAvatarType().isA(targetType):
+                    continue
+                if level > 0 and level > obj.getLevel():
+                    continue
+                uid = obj.getUniqueId()
+            except Exception:
+                continue
+            if not uid:
+                continue
+            area = self._getAreaOf(obj)
+            if area is None:
+                continue
+            if area.doId not in islandCache:
+                islandCache[area.doId] = self._getIslandOfArea(area)
+            island = islandCache[area.doId]
+            dist = 0.0
+            if area is myArea:
+                rank = 0
+                try:
+                    dist = (obj.getPos(myArea) - self.getPos(myArea)).length()
+                except Exception:
+                    pass
+            elif island is not None and island is myIsland:
+                rank = 1
+            else:
+                rank = 2
+                try:
+                    dist = (island.getPos() - myIsland.getPos()).length()
+                except Exception:
+                    dist = 1e9
+            key = (rank, dist)
+            if best is None or key < best[0]:
+                best = (key, uid)
+        return best[1] if best else None
+
+    def _getStepPosHpr(self, obj, parentObj):
+        # the client applies posH relative to the origin object, but on the AI a
+        # spawned object's own transform is relative to whatever node it hangs
+        # under (e.g. a grid cell), so measure it against the origin explicitly
+        try:
+            if parentObj is not None and hasattr(parentObj, 'getPos') and not parentObj.isEmpty():
+                return obj.getPos(parentObj), obj.getHpr(parentObj)
+        except Exception:
+            pass
+
+        return obj.getPos(), obj.getHpr()
+
+    def _getQuestNodeStep(self, goalUid):
+        # fallback for goals getQuestStep can't resolve to a live object: world-data-only
+        # locators (Quest Node / Dinghy) and objects in an area that isn't spawned or isn't
+        # reachable by the parent walk (e.g. Tia Dalma in the jungle behind a tunnel)
+        worldCreator = getattr(self.air, 'worldCreator', None)
+        if not goalUid or not worldCreator:
+            return None
+
+        objInfo = worldCreator.getObjectDataByUid(goalUid)
+        if not objInfo:
+            return None
+
+        # the goal's area is the second-last key of its world-data path
+        parentUid = None
+        for fileData in list(worldCreator.fileDicts.values()):
+            path = fileData.get('ObjectIds', {}).get(goalUid)
+            if path:
+                keys = [k for k in re.findall(r'\["([^"]+)"\]', path) if k != 'Objects']
+                if len(keys) >= 2:
+                    parentUid = keys[-2]
+                break
+
+        parentObj = self.air.uidMgr.justGetMeMeObject(parentUid) if parentUid else None
+        myArea = self.getParentObj()
+        if parentObj and myArea is not None and myArea.doId == parentObj.doId:
+            # same area: point the beam at the goal's world-data position
+            pos, hpr = objInfo.get('Pos'), objInfo.get('Hpr', (0, 0, 0))
+            if pos is None:
+                return None
+            return [parentObj.doId, 0, QuestStep.STQuestNode, [pos[0], pos[1], pos[2], hpr[0]], goalUid]
+
+        # another area linked to ours by a tunnel: point at that tunnel
+        myUid = myArea.getUniqueId() if myArea is not None and hasattr(myArea, 'getUniqueId') else None
+        if parentUid and myUid:
+            for obj in list(self.air.doId2do.values()):
+                if type(obj).__name__ != 'DistributedGATunnelAI':
+                    continue
+                try:
+                    linkUids = [link[2] for link in obj.getLinks()[2]]
+                except Exception:
+                    continue
+                if parentUid in linkUids and myUid in linkUids:
+                    tunnelParent = obj.getParentObj()
+                    (x, y, z), (h, p, r) = self._getStepPosHpr(obj, tunnelParent)
+                    originDoId = tunnelParent.doId if tunnelParent else self.doId
+                    return [originDoId, obj.doId, QuestStep.STTunnel, [x, y, z, h], goalUid]
+
+        # the goal's area only hangs off another area through a tunnel (a cave or
+        # jungle behind an island we're not on, e.g. Barbossa's cave from the sea):
+        # lead the avatar to that neighbouring area first
+        if parentUid:
+            for obj in list(self.air.doId2do.values()):
+                if type(obj).__name__ != 'DistributedGATunnelAI':
+                    continue
+                try:
+                    linkUids = [link[2] for link in obj.getLinks()[2]]
+                except Exception:
+                    continue
+                if parentUid not in linkUids:
+                    continue
+                for uid in linkUids:
+                    if uid == parentUid or uid == myUid:

diff --git a/pirates/piratesgui/GameOptions.py b/pirates/piratesgui/GameOptions.py
index c280f28..45ee800 100644
--- a/pirates/piratesgui/GameOptions.py
+++ b/pirates/piratesgui/GameOptions.py
@@ -22,6 +22,26 @@ from pirates.piratesgui import GameOptionsMatrix
 from pirates.piratesgui.GameOptionsGui import *
 from libotp import NametagGlobals
 
+
+def desktopSize():
+    # The game never goes exclusive fullscreen (family rule 2026-09-22): it always opens a borderless
+    # window the size of the desktop, so clicking or alt-tabbing never flips it to fullscreen and back.
+    try:
+        import ctypes
+        user32 = ctypes.windll.user32
+        user32.SetProcessDPIAware()
+        w, h = user32.GetSystemMetrics(0), user32.GetSystemMetrics(1)
+        if w > 0 and h > 0:
+            return (w, h)
+    except Exception:
+        pass
+    try:
+        if base.pipe and base.pipe.getDisplayWidth() > 0:
+            return (base.pipe.getDisplayWidth(), base.pipe.getDisplayHeight())
+    except Exception:
+        pass
+    return (1280, 720)
+
 try:
     import embedded
 except:
@@ -422,19 +442,13 @@ class Options(OptionSpace):
         config_variable.setValue(self.textureCompressionRuntime)
 
     def getWidth(self):
-        if self.fullscreen_runtime:
-            return self.fullscreen_width
-        else:
-            return self.window_width
+        return desktopSize()[0]
 
     def getHeight(self):
-        if self.fullscreen_runtime:
-            return self.fullscreen_height
-        else:
-            return self.window_height
+        return desktopSize()[1]
 
     def getFullscreen(self):
-        return self.fullscreen_runtime
+        return 0
 
     def pipeOptionsToPrcData(self):
         string = None

diff --git a/pirates/distributed/PiratesClientRepository.py b/pirates/distributed/PiratesClientRepository.py
index 7133f03..f1eb84b 100644
--- a/pirates/distributed/PiratesClientRepository.py
+++ b/pirates/distributed/PiratesClientRepository.py
@@ -100,8 +100,29 @@ class PiratesClientRepository(OTPClientRepository):
     GameGlobalsId = OTP_DO_ID_PIRATES
     StopVisibilityEvent = 'pirates-stop-visibility'
 
+    def __handleAvatarZoneChanged(self, av, gridDoId, zoneId):
+        # Family patch: Panda3D 1.11's direct DistributedCartesianGrid sends this message instead of
+        # calling handleAvatarZoneChange, so without it the avatar never joins a grid zone.
+        grid = self.doId2do.get(gridDoId)
+        if grid is None:
+            return
+        grid.handleAvatarZoneChange(av, zoneId)
+        # Disney's grid also opened interest on the concentric cells around the avatar; the stock
+        # Panda3D grid only watches the avatar's own cell, so players a cell apart never see each other.
+        if av.isLocal() and hasattr(grid, 'getConcentricZones'):
+            zones = set([zoneId])
+            for radius in (1, 2, 3):
+                zones.update(grid.getConcentricZones(zoneId, radius))
+            zones = sorted(zones)
+            if getattr(grid, 'gridVisContext', None):
+                self.alterInterest(grid.gridVisContext, gridDoId, zones)
+            else:
+                grid.gridVisContext = self.addInterest(gridDoId, zones, grid.uniqueName('visibility'))
+            grid.visZone = zoneId
+
     def __init__(self, serverVersion, launcher=None):
         OTPClientRepository.__init__(self, serverVersion, launcher, playGame=PlayGame.PlayGame)
+        self.accept('avatarZoneChanged', self.__handleAvatarZoneChanged)
         self.createAvatarClass = DistributedPlayerPirate.DistributedPlayerPirate
         self.tradeManager = None
         self.pvpManager = None
diff --git a/pirates/effects/MuzzleFlame.py b/pirates/effects/MuzzleFlame.py
index e023fc4..77588a1 100644
--- a/pirates/effects/MuzzleFlame.py
+++ b/pirates/effects/MuzzleFlame.py
@@ -92,10 +92,22 @@ class MuzzleFlame(PooledEffect, EffectController):
         fadeBlast = self.flash.colorScaleInterval(0.2, Vec4(0, 0, 0, 0), startColorScale = self.startCol, blendType = 'easeOut')
         scaleBlast = self.flash.scaleInterval(0.2, 10, blendType = 'easeIn')
         self.playFlash = Sequence(Func(self.flash.show), Parallel(fadeBlast, scaleBlast), Func(self.flash.hide), Func(self.flash.setScale, 25), Func(self.flash.setColorScale, Vec4(1, 1, 1, 1)))
-        self.startEffect = Sequence(Func(self.p0.setBirthRate, 0.01), Func(self.p0.clearToInitial), Func(self.f.start, self, self.particleDummy))
+        self.startEffect = Sequence(Func(self.p0.setBirthRate, 0.01), Func(self.p0.clearToInitial), Func(self._startParticles))
         self.endEffect = Sequence(Func(self.p0.setBirthRate, 100), Wait(1.5), Func(self.cleanUpEffect))
         self.track = Parallel(Sequence(self.startEffect, Wait(0.15), self.endEffect), self.playFlash)
     
+    def _startParticles(self):
+        # a pooled flame reused while still attached elsewhere can make this reparent
+        # form a scene-graph cycle (seen when a Navy ship fires its broadside); an
+        # assertion here used to kill the whole interval loop, i.e. crash the game
+        try:
+            self.f.start(self, self.particleDummy)
+        except AssertionError:
+            try:
+                self.f.detachNode()
+            except Exception:
+                pass
+
     def cleanUpEffect(self):
         self.ignore('timeOfDayChange')
         self.detachNode()

diff --git a/pirates/world/DistributedDoorBase.py b/pirates/world/DistributedDoorBase.py
index 5d2bb63..ba64e87 100644
--- a/pirates/world/DistributedDoorBase.py
+++ b/pirates/world/DistributedDoorBase.py
@@ -47,6 +47,18 @@ class DistributedDoorBase(DistributedInteractive.DistributedInteractive):
             self.openOtherDoorIval.pause()
             self.openOtherDoorIval = None
         
+        # the door can leave interest while its enter/exit fade is still running (e.g. the
+        # pirate crossed a grid cell on the way in); stop the tracks so they don't call
+        # loadOtherSide/sendUpdate on a disabled door, and hand control back to the pirate
+        if self.fadeOutTrack and self.fadeOutTrack.isPlaying():
+            self.fadeOutTrack.pause()
+            if getattr(base, 'localAvatar', None) and localAvatar.gameFSM and localAvatar.gameFSM.state == 'DoorInteract':
+                base.transitions.fadeIn(0.5)
+                localAvatar.gameFSM.request('LandRoam')
+
+        if self.fadeInTrack and self.fadeInTrack.isPlaying():
+            self.fadeInTrack.finish()
+
         self.fadeOutTrack = None
         self.fadeInTrack = None
         if not self.noDoors:
diff --git a/pirates/world/DistributedGATunnel.py b/pirates/world/DistributedGATunnel.py
index 2332f1b..bc99517 100644
--- a/pirates/world/DistributedGATunnel.py
+++ b/pirates/world/DistributedGATunnel.py
@@ -129,6 +129,9 @@ class DistributedGATunnel(DistributedGAConnector.DistributedGAConnector, ClientA
                 
                 entranceNode = self.areaNode[areaIndex]
                 entryLocator = area.find('**/' + entranceNode + '*')
+                if entryLocator.isEmpty():
+                    self.notify.warning('no entry locator %s in %s; ignoring floor event' % (entranceNode, area))
+                    return None
                 camera.wrtReparentTo(render)
                 localAvatar.lookAt(entryLocator, -50, 0, localAvatar.getZ(entryLocator))
                 camera.wrtReparentTo(localAvatar)

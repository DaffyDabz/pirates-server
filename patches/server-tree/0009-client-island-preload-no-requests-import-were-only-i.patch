diff --git a/pirates/world/IslandPreload.py b/pirates/world/IslandPreload.py
new file mode 100644
index 0000000..8315ca1
--- /dev/null
+++ b/pirates/world/IslandPreload.py
@@ -0,0 +1,29 @@
+import os
+from direct.directnotify import DirectNotifyGlobal
+notify = DirectNotifyGlobal.directNotify.newCategory('IslandPreload')
+_started = False
+_models = None
+
+def start():
+    # Load every island model on the loader thread while the pirate chooser is up, so the island
+    # generates that follow hit the ModelPool instead of reading ~460 bam files on the main thread.
+    global _started
+    if _started:
+        return
+    _started = True
+    try:
+        fn = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'IslandPreload.txt')
+        with open(fn) as f:
+            paths = [l.strip() for l in f if l.strip() and not l.startswith('#')]
+    except Exception as e:
+        notify.warning('no preload list: %s' % e)
+        return
+    if not paths:
+        return
+    notify.info('preloading %d island models' % len(paths))
+    base.loader.loadModel(paths, callback=_done)
+
+def _done(*models):
+    global _models
+    _models = models
+    notify.info('preloaded %d island models' % len([m for m in models if m]))

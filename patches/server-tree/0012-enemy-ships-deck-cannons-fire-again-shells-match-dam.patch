+            if not target or not self._isValidTarget(target):
+                return Task.done
+            if not self.ship or self.ship.isEmpty() or cannonIndex >= len(self.ship.cannons):
+                return Task.done
+            cannon = self.ship.cannons[cannonIndex]
+
+            hitChance = 0.7 * max(0.3, 1.0 - (dist / 2000.0) * 0.4)
+            hit = random.random() < hitChance
+
+            # Aim on the hull for a hit, splash beside it for a miss
+            targetPos = target.getPos()
+            if hit:
+                offX = random.gauss(0, 8)
+                offY = random.gauss(0, 8)
+            else:
+                offX = random.choice((-1, 1)) * random.uniform(30, 70)
+                offY = random.choice((-1, 1)) * random.uniform(30, 70)
+            aimPos = Point3(targetPos.getX() + offX,
+                            targetPos.getY() + offY,
+                            targetPos.getZ() + random.gauss(0, 3))
+
+            # Fire the cannon (sends the shot to clients)
+            if hasattr(cannon, 'fireAtPosition'):
+                cannon.fireAtPosition(aimPos)
+
+            if not hit:
+                return Task.done
+            if getattr(target, 'hasSpawnBuff', lambda: False)():
+                return Task.done
+
+            levelMod = self._getLevelBasedDamageModifier(target)

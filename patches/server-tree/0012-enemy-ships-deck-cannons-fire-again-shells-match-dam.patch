From cb70b94c15f649ce245719477f9d1f65709bda6b Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Mon, 16 Nov 2026 13:23:19 -0800
Subject: [PATCH 012/371] enemy ships: deck cannons fire again, shells match
 damage, chase first

- GameFSMShipAI: the _fireIndividualCannon def line was lost, so every
  scheduled deck-cannon shot raised AttributeError (swallowed) and enemy
  deck cannons never fired. Restored with a distance-based hit roll and
  the right takeDamage argument order for NPC and player targets.
- DistributedShipBroadsideAI: hit or miss is decided once per cannon at
  fire time and used for both the shells clients see and the damage
  (before, the damage re-rolled 1-3 s later, unrelated to the splashes).
- Combat opens in CircleAttack only inside attack range; farther out it
  chases, and a target that pulls away is always chased (was a 10% roll).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/battle/DistributedShipBroadsideAI.py |  62 +++++-----
 pirates/ship/GameFSMShipAI.py                | 114 ++++++++++---------
 2 files changed, 97 insertions(+), 79 deletions(-)

diff --git a/pirates/battle/DistributedShipBroadsideAI.py b/pirates/battle/DistributedShipBroadsideAI.py
index 57c3688..d7ba01a 100644
--- a/pirates/battle/DistributedShipBroadsideAI.py
+++ b/pirates/battle/DistributedShipBroadsideAI.py
@@ -173,24 +173,31 @@ class DistributedShipBroadsideAI(DistributedWeaponAI):
                 self.notify.warning('No broadside cannons on side %d' % side)
                 return False
             
-            # Generate cannon delays and hit positions with spread
+            # Decide hit or miss per cannon now, so the shells the clients see
+            # are the shells that deal damage: a hit lands on the hull, a miss splashes beside it
+            hitChance = 0.7 * max(0.3, 1.0 - (dist / 2000.0) * 0.4)
             delays = []
             hitPosList = []
-            
+            hitsLanded = 0
+
             for i in range(numCannons):
                 delays.append(random.uniform(0, 0.5))
-                # Add spread for realism
-                spreadX = random.gauss(0, 25)
-                spreadY = random.gauss(0, 25)
-                spreadZ = random.gauss(0, 10)
+                if random.random() < hitChance:
+                    hitsLanded += 1
+                    spreadX = random.gauss(0, 8)
+                    spreadY = random.gauss(0, 8)
+                else:
+                    spreadX = random.choice((-1, 1)) * random.uniform(30, 70)
+                    spreadY = random.choice((-1, 1)) * random.uniform(30, 70)
+                spreadZ = random.gauss(0, 3)
                 hitPosList.append((relX + spreadX, relY + spreadY, relZ + spreadZ))
-            
+
             # Fire the broadside (visual)
             self.doBroadside(side, delays, hitPosList, zoneId, flightTime)
-            
+
             # Apply damage directly on server
             # AI broadsides apply damage after a delay matching flight time
-            self._applyBroadsideDamage(targetShip, numCannons, dist, flightTime)
+            self._applyBroadsideDamage(targetShip, numCannons, dist, flightTime, hitsLanded)
             
             return True
             
@@ -200,7 +207,7 @@ class DistributedShipBroadsideAI(DistributedWeaponAI):
             traceback.print_exc()
             return False
 
-    def _applyBroadsideDamage(self, targetShip, numCannons, distance, flightTime):
+    def _applyBroadsideDamage(self, targetShip, numCannons, distance, flightTime, hitsLanded=None):
         """
         Apply broadside damage to target ship after a delay.
         This handles server-side damage for AI ship attacks.
@@ -228,25 +235,24 @@ class DistributedShipBroadsideAI(DistributedWeaponAI):
                 maxRange = 2000.0
                 distanceMod = max(0.3, 1.0 - (distance / maxRange) * 0.5)
                 
-                # Calculate hit chance per cannon (accuracy decreases with distance)
-                baseAccuracy = 0.7  # 70% base accuracy
-                accuracyFalloff = max(0.3, 1.0 - (distance / maxRange) * 0.4)
-                hitChance = baseAccuracy * accuracyFalloff
-                
-                # Calculate total damage from cannons that hit
-                import random
-                totalDamage = 0
-                hitsLanded = 0
-                for i in range(numCannons):
-                    if random.random() < hitChance:
-                        cannonDamage = baseDamagePerCannon * npcDamageOut * distanceMod
-                        totalDamage += cannonDamage
-                        hitsLanded += 1
-                
-                if hitsLanded == 0:
+                # Cannons that hit were decided when the broadside was fired
+                # (fireAtTarget). Only roll here if the caller did not pass them.
+                hits = hitsLanded
+                if hits is None:
+                    # Hit chance per cannon (accuracy decreases with distance)
+                    baseAccuracy = 0.7  # 70% base accuracy
+                    accuracyFalloff = max(0.3, 1.0 - (distance / maxRange) * 0.4)
+                    hitChance = baseAccuracy * accuracyFalloff
+                    import random
+                    hits = 0
+                    for i in range(numCannons):
+                        if random.random() < hitChance:
+                            hits += 1
+
+                if hits == 0:
                     return task.done  # All shots missed
-                
-                totalDamage = int(totalDamage)

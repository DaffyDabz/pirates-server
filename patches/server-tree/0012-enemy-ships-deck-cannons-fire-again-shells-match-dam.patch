             return True
             
         except Exception as e:
+            self.notify.warning('Individual cannon salvo failed: %s' % str(e))
             return False
 
     def _checkCannonHit(self, fromPos, toPos, target):
@@ -2625,57 +2626,66 @@ class GameFSMShipAI(FSM.FSM):
             
         except Exception as e:
             return False
+
+    def _fireIndividualCannon(self, target, cannonIndex, dist):

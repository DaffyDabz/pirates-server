@@ -1034,6 +1092,333 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
 
         self.sendUpdate('recordSkillEvent', [skillId, ammoSkillId])
 
+    def _isAfloat(self):
+        if self.hp <= 0:
+            return False
+
+        return self.gameState[0] not in ('Sinking', 'Sunk', 'Off', 'PutAway')
+
+    # ------------------------------------------------------------------
+    # Ship skills: Full Sail, Come About and Ramming Speed
+    # ------------------------------------------------------------------
+
+    def grantShipSkill(self, avatar, skillId):
+        # Called from WeaponBaseAI.requestShipSkill. Nothing sent setSkillEffects for a
+        # ship skill before, so no ship ever got the Ramming Speed buff the client
+        # needs before it sends requestShipRam.
+        effectId = SHIP_SKILL_BUFFS.get(skillId)
+        if effectId is None:
+            return False
+
+        if avatar.doId not in self.crew or not self._isAfloat():
+            return False
+
+        now = globalClock.getFrameTime()
+        if now < self._shipSkillReadyAt.get(skillId, 0.0):
+            return False
+
+        try:
+            duration = WeaponGlobals.getAttackDuration(skillId)
+        except KeyError:
+            duration = 0
+
+        try:
+            recharge = WeaponGlobals.getAttackRechargeTime(skillId)
+        except KeyError:
+            recharge = 0.0
+
+        duration = int(max(1, round(duration or DEFAULT_SHIP_SKILL_SECONDS)))
+        # the client times its own recharge, so leave it a second of slack
+        self._shipSkillReadyAt[skillId] = now + max(0.0, recharge - 1.0)
+        self.addSkillEffect(effectId, duration, avatar.doId)
+        return True
+
+    def _consumeSkillEffect(self, effectId):
+        # remove one buff right away, and the timer that would have removed it later
+        for skillEffect in list(self.skillEffects):
+            if skillEffect[0] != effectId:
+                continue
+
+            self.skillEffects.remove(skillEffect)
+            taskName = self.uniqueName('ship-skill-effect-%s-%s' % (effectId, skillEffect[3]))
+            taskMgr.remove(taskName)
+            self._skillEffectTasks.pop(taskName, None)
+            self.d_setSkillEffects(self.skillEffects)
+            return True
+
+        return False
+
+    # ------------------------------------------------------------------
+    # Repair at sea
+    # ------------------------------------------------------------------
+
+    def _wantsRepairSpots(self):
+        return (not self.npcShip
+            and self.shipClass in REPAIR_SPOT_SHIP_CLASSES
+            and config.GetBool('want-ship-repair-spots', True))
+
+    def canUseRepairSpot(self, avatar, spot):
+        # Called by DistributedShipRepairSpotAI.handleRequestInteraction. The client
+        # sends requestInteraction whenever the avatar walks into a spot, so every rule
+        # the client shows a warning for is enforced here too.
+        if spot not in self.repairSpots or avatar.doId not in self.crew:
+            return False
+
+        if not self._isAfloat():
+            return False
+
+        # CannotRepairRepairedShipWarning
+        if self.hp >= self.maxHp and self.sp >= self.maxSp:
+            return False
+
+        # CannotRepairWhileWheelOccupiedWarning
+        if self.steeringWheel and self.steeringWheel.userId > 0:
+            return False
+
+        # someone else is on the spot (a user who left the crew is not holding it)
+        if spot.userId and spot.userId != avatar.doId and spot.userId in self.crew:
+            return False
+
+        for other in self.repairSpots:
+            if other is not spot and other.userId == avatar.doId:
+                return False
+
+        return True
+
+    def repairSpotsChanged(self):
+        # a spot was taken or left: make sure the healing task is running
+        if self._activeRepairers():
+            self._startRepairTask()
+
+    def _activeRepairers(self):
+        return [spot for spot in self.repairSpots if spot.userId and spot.userId in self.crew]
+
+    def _startRepairTask(self):
+        taskName = self.uniqueName('ship-repair-tick')
+        if taskMgr.hasTaskNamed(taskName):
+            return
+
+        period = max(0.5, float(ShipBalance.RepairPeriod.getValue()))
+        taskMgr.doMethodLater(period, self._repairTick, taskName)
+
+    def _repairTick(self, task):
+        repairers = self._activeRepairers()
+        if not repairers or not self._isAfloat():
+            return task.done
+
+        # same scale as the client's PVPGlobals: one repairer heals RepairRate per
+        # RepairPeriod, more repairers heal faster
+        multiplier = REPAIR_RATE_MULTIPLIERS[min(len(repairers), len(REPAIR_RATE_MULTIPLIERS)) - 1]
+        self._repairByAmount(float(ShipBalance.RepairRate.getValue()) * multiplier)
+        # keep ticking while somebody stays on a spot, so damage taken after the ship
+        # was fully repaired is healed too
+        return task.again
+
+    def _repairByAmount(self, amount):
+        amount = int(math.ceil(amount))
+        if amount <= 0 or self.maxHp <= 0:
+            return
+
+        if self.hp + amount >= self.maxHp:
+            self._restoreAll()
+            return
+
+        fraction = amount / float(self.maxHp)
+        self.b_setHp(self.hp + amount)
+        if self.sp < self.maxSp:
+            self.b_setSp(min(self.maxSp, self.sp + int(math.ceil(self.maxSp * fraction))))
+
+        self._healParts(fraction)
+
+    def _restoreAll(self):
+        # ship hull points, ship sail points, hull and mast sections, and every sail
+        self._healParts(1.0)
+        if self.sp < self.maxSp:
+            self.b_setSp(self.maxSp)
+
+        if self.hp < self.maxHp:
+            self.b_setHp(self.maxHp)
+
+    def _healParts(self, fraction):
+        # every part heals the same share of its own maximum as the ship did
+        if self.hull:
+            self._healArrayHp(self.hull, fraction)
+
+        for mast in self.masts:
+            self._healArrayHp(mast, fraction)
+
+        for sail in self.sails:
+            self._healSail(sail, fraction)
+
+    def _healArrayHp(self, part, fraction):
+        maxArrayHp = part.getMaxArrayHp()
+        arrayHp = list(part.getArrayHp())
+        changed = False
+        for index in range(min(len(arrayHp), len(maxArrayHp))):
+            if arrayHp[index] >= maxArrayHp[index]:
+                continue
+
+            arrayHp[index] = min(maxArrayHp[index], arrayHp[index] + int(math.ceil(maxArrayHp[index] * fraction)))
+            changed = True
+
+        if changed:
+            part.b_setArrayHp(arrayHp)
+
+    def _healSail(self, sail, fraction):
+        if sail.maxHp <= 0:
+            return
+
+        if sail.hp >= sail.maxHp and sail.animState != 'Falling':
+            return
+
+        # DistributedSailAI.setHp does not keep hp under maxHp, so clamp here
+        newHp = min(sail.maxHp, sail.hp + int(math.ceil(sail.maxHp * fraction)))
+        if newHp != sail.hp:
+            sail.b_setHp(newHp)
+
+        # the client sail respawns when its hp reaches the maximum, so a fallen
+        # sail is put back to its stowed state at the same moment
+        if newHp >= sail.maxHp and sail.animState == 'Falling':
+            sail.b_setAnimState('TiedUp')
+
+    def purchaseRepairAll(self):
+        # HighSeasScoreboard.payForShipRepairs -> DistributedShip.requestRepairAll
+        avatar = self.air.doId2do.get(self.air.getAvatarIdFromSender())
+        if not avatar or avatar.doId not in self.crew:
+            return
+
+        if not self._isAfloat():
+            return
+
+        cost = ShipGlobals.calcRepairCost(self.maxHp, self.hp, self.maxSp, self.sp,
+            ShipGlobals.getModelClass(self.shipClass))
+
+        if cost > 0:
+            inventory = self.air.inventoryManager.getInventory(avatar.doId)
+            if inventory is None:
+                return
+
+            gold = inventory.getGoldInPocket()
+            if gold < cost:
+                self.notify.debug('Avatar %d cannot afford to repair ship %d; cost=%d gold=%d' % (
+                    avatar.doId, self.doId, cost, gold))
+
+                return
+
+            inventory.setGoldInPocket(gold - cost)
+
+        self._restoreAll()
+        self.air.writeServerEvent('ship-repair-all', shipId=self.doId, avatarId=avatar.doId, cost=cost)
+
+    # ------------------------------------------------------------------
+    # Ramming
+    # ------------------------------------------------------------------
+
+    def _getRamTeam(self):
+        # player ships are on the player team, NPC ships on their own team
+        if not self.npcShip:
+            return PiratesGlobals.PLAYER_TEAM
+
+        if self.baseTeam != ShipGlobals.INVALID_TEAM:
+            return self.baseTeam
+
+        return ShipGlobals.getShipTeam(self.shipClass)
+
+    def _canRam(self, target):
+        myTeam = self._getRamTeam()
+        theirTeam = target._getRamTeam()
+        if ShipGlobals.INVALID_TEAM in (myTeam, theirTeam):
+            return False
+
+        # in a PVP match only the other team's ships can be rammed
+        myPvpTeam = self.getPVPTeam()
+        theirPvpTeam = target.getPVPTeam()
+        if myPvpTeam and theirPvpTeam:
+            return myPvpTeam != theirPvpTeam
+
+        from pirates.piratesbase import TeamUtils
+        return TeamUtils.teamStatus(myTeam, theirTeam) == PiratesGlobals.ENEMY
+
+    def _getRamDamage(self):
+        stats = ShipGlobals.getHullStats(self.shipClass) or ShipGlobals.getHullStats(
+            ShipGlobals.getModelClass(self.shipClass)) or {}
+
+        return max(1, int(stats.get('rammingPower', 1)))
+
+    def receiveRamDamage(self, damage, attackerShipId):
+        if damage <= 0 or not self._isAfloat() or self.hasSpawnBuff():
+            return
+
+        damage = int(damage)
+        takeDamage = getattr(self, 'takeDamage', None)
+        if takeDamage is not None:
+            # NPC ships track the attacker and sink themselves. The ram damage is
+            # already final, so skip the NPC input modifier where takeDamage has one
+            # (BlackPearlShipAI.takeDamage does not).
+            if 'applyModifiers' in inspect.signature(takeDamage).parameters:
+                takeDamage(damage, attackerShipId, applyModifiers=False)
+            else:
+                takeDamage(damage, attackerShipId)
+
+            return
+
+        # setHp sinks the ship at 0
+        self.b_setHp(max(0, self.hp - damage))
+        onDamageReceived = getattr(getattr(self, 'gameFSM', None), 'onDamageReceived', None)
+        if onDamageReceived is not None:
+            onDamageReceived(attackerShipId, damage)
+
+    def requestShipRam(self, targetId, pos, timestamp):
+        # Sent by the client of the ramming ship while it holds the Ramming Speed buff;
+        # it removes the buff on its own side. The ship position the AI knows is not
+        # reliable, so there is no distance check: the client's contact report is
+        # trusted, but only for an enemy ship, once per buff.
+        avatar = self.air.doId2do.get(self.air.getAvatarIdFromSender())
+        if not avatar or avatar.doId not in self.crew:
+            return
+
+        if not self.hasSkillEffect(WeaponGlobals.C_RAM):
+            return
+
+        target = self.air.doId2do.get(targetId)
+        if not isinstance(target, DistributedShipAI) or target is self:
+            return
+
+        if not self._isAfloat() or not target._isAfloat() or target.hasSpawnBuff():
+            return
+
+        if not self._canRam(target):
+            return
+
+        self._consumeSkillEffect(WeaponGlobals.C_RAM)
+
+        damage = self._getRamDamage()
+        targetWasAfloat = target._isAfloat()
+        target.receiveRamDamage(damage, self.doId)
+
+        # the ram's impact effect: the contact point is in the rammer's frame, so the
+        # target plays its own effect at its bow
+        try:
+            ramPos = tuple(pos)[:3]
+            if len(ramPos) != 3:
+                ramPos = (0, 0, 0)
+        except TypeError:
+            ramPos = (0, 0, 0)
+
+        self.sendUpdate('useShipRam', [ramPos])
+        target.sendUpdate('useShipRam', [(0, 0, 0)])
+
+        # a ram hurts the rammer too, but never sinks it
+        backlash = int(damage * RAM_BACKLASH)
+        if backlash > 0 and self._isAfloat():
+            self.b_setHp(max(1, self.hp - backlash))
+
+        if targetWasAfloat and not target._isAfloat():
+            try:
+                self.air.questMgr.shipDefeated(avatar, target)
+            except Exception as e:
+                self.notify.warning('Could not credit ship defeat for ram: %s' % str(e))
+
     def generateChildWithRequired(self, do, zoneId, optionalFields=[]):
         self.generateChildWithRequiredAndId(do, self.air.allocateChannel(), self.doId, zoneId, optionalFields)
 

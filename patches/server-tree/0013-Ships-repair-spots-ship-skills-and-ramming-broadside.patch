+++ b/pirates/shipparts/DistributedShipRepairSpotAI.py
@@ -24,6 +24,35 @@ class DistributedShipRepairSpotAI(DistributedInteractiveAI):
     def getShipId(self):
         return self.shipId
 
+    def getShip(self):
+        return self.air.doId2do.get(self.shipId)
+
+    def handleRequestInteraction(self, avatar, interactType, instant):
+        # the ship decides: crew only, something to repair, wheel free, spot free
+        ship = self.getShip()
+        if ship is None or not ship.canUseRepairSpot(avatar, self):
+            return self.DENY
+
+        return self.ACCEPT
+
+    def handlePostRequestInteraction(self, avatar):
+        # the user id is already set, so the ship can start healing
+        ship = self.getShip()
+        if ship is not None:
+            ship.repairSpotsChanged()
+
+    def handleRequestExit(self, avatar):
+        # only the avatar using the spot can leave it (a free spot has nothing to deny)
+        if self.userId and avatar.doId != self.userId:
+            return self.DENY
+
+        return self.ACCEPT
+
+    def handlePostRequestExit(self, avatar):
+        ship = self.getShip()
+        if ship is not None:
+            ship.repairSpotsChanged()
+
     def setIndex(self, index):
         self.index = index
 

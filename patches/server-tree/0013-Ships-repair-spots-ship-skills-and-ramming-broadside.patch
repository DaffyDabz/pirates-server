+# Ship skills the captain casts on the ship (the client sends requestShipSkill with the
+# ship as target): skill -> the buff the ship gets. Duration and recharge come from the
+# skill table in WeaponGlobals. OpenFire, TakeCover and PowerRecharge are not granted yet.
+SHIP_SKILL_BUFFS = {
+    InventoryType.SailFullSail: WeaponGlobals.C_FULLSAIL,
+    InventoryType.SailComeAbout: WeaponGlobals.C_COMEABOUT,
+    InventoryType.SailRammingSpeed: WeaponGlobals.C_RAM,
+}
+DEFAULT_SHIP_SKILL_SECONDS = 10.0
+
+# Repair at sea. The client builds repair spots (and the wood piles) only for these nine
+# player ship classes: PVPGlobals.ShipClass2repairLocators, which is not imported here
+# because that module needs the client's base at import time.
+REPAIR_SPOT_SHIP_CLASSES = (
+    ShipGlobals.INTERCEPTORL1, ShipGlobals.INTERCEPTORL2, ShipGlobals.INTERCEPTORL3,
+    ShipGlobals.MERCHANTL1, ShipGlobals.MERCHANTL2, ShipGlobals.MERCHANTL3,
+    ShipGlobals.WARSHIPL1, ShipGlobals.WARSHIPL2, ShipGlobals.WARSHIPL3)
+REPAIR_SPOT_COUNT = 4  # repair_spot_0 .. repair_spot_3 on every ship model
+# same as PVPGlobals.RepairRateMultipliers: one repairer, two, three, four
+REPAIR_RATE_MULTIPLIERS = (1.0, 2.0, 3.0, 4.0)
+
+# A ram costs the rammer this share of the damage it deals
+RAM_BACKLASH = 0.25
+
+
 class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectAI, Teamable):
     notify = DirectNotifyGlobal.directNotify.newCategory('DistributedShipAI')
 

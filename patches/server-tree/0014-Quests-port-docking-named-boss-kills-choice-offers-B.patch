     def shipDefeated(self, avatar, ship):
         # No AI code ever fired QuestEvent.ShipDefeated, so every sink / capture /
@@ -609,6 +617,45 @@ class QuestManagerAI(DirectObject):
 
         return self.completeTaskState(avatar, questEvent)
 
+    def dockedAtPort(self, avatar, island):
+        # No AI code ever fired QuestEvent.DockedAtPort, so MaroonNPC quests and the
+        # Deliver/Smuggle quests that ask for a port (no NPC) never progressed.
+        # The quest location of a port is the island's unique id.
+        questEvent = QuestEvent.DockedAtPort()
+        questEvent.setLocation(island.getUniqueId())
+
+        return self.completeTaskState(avatar, questEvent)
+
+    def npcDefeated(self, avatar, enemy):
+        # DefeatNPCTaskDNA.npcId is the world-data key of the (boss) spawn node. The enemy
+        # keeps it as spawnUid (a boss's uniqueId is '' so getUniqueId cannot be used).
+        npcId = getattr(enemy, 'spawnUid', '')
+        if not npcId:
+            spawnNode = enemy.getSpawnNode() if hasattr(enemy, 'getSpawnNode') else None
+            npcId = getattr(spawnNode, 'objKey', '')
+
+        if not npcId:
+            return
+
+        questEvent = QuestEvent.NPCDefeated()
+        parentObj = avatar.getParentObj()
+        if parentObj:
+            questEvent.setLocation(parentObj.getUniqueId())
+
+        questEvent.setNpcId(npcId)
+
+        return self.completeTaskState(avatar, questEvent)
+
+    def bossBattleCompleted(self, avatar, treasureMapId):
+        questEvent = QuestEvent.BossBattleCompleted()
+        parentObj = avatar.getParentObj()
+        if parentObj:
+            questEvent.setLocation(parentObj.getUniqueId())
+
+        questEvent.setTreasureMapId(treasureMapId)
+
+        return self.completeTaskState(avatar, questEvent)
+
     def pokerHandWon(self, avatar, gold):
         parentObj = avatar.getParentObj()
         if not parentObj:

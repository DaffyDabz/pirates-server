diff --git a/pirates/quest/DistributedQuestGiverAI.py b/pirates/quest/DistributedQuestGiverAI.py
index 1af4c17..c3b6a4b 100644
--- a/pirates/quest/DistributedQuestGiverAI.py
+++ b/pirates/quest/DistributedQuestGiverAI.py
@@ -58,6 +58,22 @@ class DistributedQuestGiverAI(DistributedObjectAI):
                 break
         return offers
 
+    def toQuestOffers(self, avatar, items):
+        # family server: the client is sent QuestOffer structs and setOfferResponse
+        # looks the pick up in pendingOffers, so both must hold the same QuestOffers.
+        # QuestStatus.getQuestOffersFromGiver (choice ladders) returns QuestContainers,
+        # which cannot be sent as a struct; turn each one into the offer for its first quest.
+        offers = []
+        for item in items or []:
+            if isinstance(item, QuestOffer):
+                offers.append(item)
+                continue
+            try:
+                offers.append(QuestOffer.create(item.getFirstQuestId(), avatar))
+            except Exception as e:
+                self.notify.warning('cannot turn %r into a quest offer: %r' % (item, e))
+        return offers
+
     def setOfferResponse(self, index, ladder):
         avId = self.air.getAvatarIdFromSender()
         offers = self.pendingOffers.pop(avId, [])
@@ -65,7 +81,7 @@ class DistributedQuestGiverAI(DistributedObjectAI):
         if not avatar or index == QuestConstants.CANCEL_QUEST:
             return
         if index < 0 or index >= len(offers):
-            self.notify.warning('bad offer index %d from %d' % (index, avId))
+            self.notify.warning('bad offer index %d from %d (%d offers pending, ladder=%r)' % (index, avId, len(offers), ladder))
             return
         self.air.questMgr.createQuest(avatar, offers[index].getQuestId())
 

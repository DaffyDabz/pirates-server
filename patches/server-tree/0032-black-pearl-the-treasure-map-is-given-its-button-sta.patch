+def giveTreasureMap(air, avatar, mapId=0):
+    """family server: give an avatar a treasure map (TreasureMapReward, and a pirate on a boss quest at login).
+    The map is not a database object: it lives under the inventory (zone 2, where the client looks) while the
+    avatar is on and is made again at the next login. One map per mapId; returns the map."""
+    inventory = avatar.getInventory()
+    if not inventory:
+        DistributedTreasureMapAI.notify.warning('giveTreasureMap: avatar %d has no inventory' % avatar.doId)
+        return None
+
+    live = [doId for doId in inventory.getDoIdListCategory(InventoryCategory.TREASURE_MAPS)
+            if isinstance(air.doId2do.get(doId), DistributedTreasureMapAI)]
+    for doId in live:
+        if air.doId2do[doId].getMapId() == mapId:
+            return air.doId2do[doId]
+
+    treasureMap = DistributedTreasureMapAI(air)
+    treasureMap.setOwnerId(avatar.doId)
+    treasureMap.setMapId(mapId)
+    treasureMap.generateWithRequiredAndId(air.allocateChannel(), inventory.doId, OTP_ZONE_ID_MANAGEMENT)
+    treasureMap.acceptOnce(avatar.getDeleteEvent(), treasureMap._ownerGone, extraArgs=[inventory])
+    inventory.b_setDoIdListCategory(InventoryCategory.TREASURE_MAPS, live + [treasureMap.doId])
+    DistributedTreasureMapAI.notify.info('gave treasure map %d (mapId %d) to avatar %d' % (
+        treasureMap.doId, mapId, avatar.doId))
+    return treasureMap
+
+
 @magicWord(category=CATEGORY_SYSTEM_ADMIN, types=[int])
 def treasuremap(mapId=0):
     """Start a treasure map instance"""

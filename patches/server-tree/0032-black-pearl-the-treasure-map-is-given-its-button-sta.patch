+        # family server: nothing told the instance when an attack ship sank (NPCShipAI.takeDamage only sets
+        # 'Sinking'), so stage two never ended. Watch the ships' hp (a task, so no state change inside this enter).
+        taskMgr.doMethodLater(2.0, self._checkAttackShips, self.uniqueName('checkAttackShips'))
+
+    def _checkAttackShips(self, task):
+        """Count each attack ship that has sunk (hp 0) or is gone; the last one ends stage two"""
+        for shipDoId, ship in zip(self.attackShipIds, self.attackShips):
+            if shipDoId in self.attackShipsSunkIds:
+                continue
+
+            if ship is None or ship.isDeleted() or ship.getHp() <= 0:
+                self.handleAttackShipDestroyed(shipDoId)
+
+        if len(self.attackShipsSunkIds) >= len(self.attackShipIds):
+            # also when no attack ship could be built (_createAttackShips skips a ship whose config fails)
+            self._allAttackShipsDestroyed()
+
+        if self.state != 'StageTwo':
+            return Task.done
+
+        return Task.again
 

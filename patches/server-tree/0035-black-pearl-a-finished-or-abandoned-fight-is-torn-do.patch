+    def _startBlackPearlWhenClear(self, avatarId, tries):
+        """Build a fresh Black Pearl once no torn-down one is left in the tables (Astron tells this AI about each
+        deleted object a moment after the delete is requested)"""
+        from pirates.ai import PiratesMagicWordManagerAI as bpHelpers
+        from pirates.treasuremap.TreasureMapBlackPearlAI import TreasureMapBlackPearlAI
+        avatar = self.air.doId2do.get(avatarId)
+        if not avatar:
+            return
+
+        old = [obj for obj in list(self.air.doId2do.values())
+               if isinstance(obj, TreasureMapBlackPearlAI) and obj.tornDown]
+        if old:
+            if tries >= 100:
+                self.notify.warning('Black Pearl %d is still deleting after 30 s, not starting a new one' % old[0].doId)
                 return
 
-            if obj.isReady:
-                bpHelpers._teleportToBlackPearl(self.air, avatar, obj)
-            else:
-                obj.pendingTeleportCallbacks.append(lambda: bpHelpers._teleportToBlackPearl(self.air, avatar, obj))
+            def retry(task):
+                self._startBlackPearlWhenClear(avatarId, tries + 1)
+                return task.done
 
+            taskMgr.doMethodLater(0.3, retry, self.uniqueName('startBlackPearl-%d' % avatarId))
             return
 
         bpHelpers._createBlackPearlInstance(self.air, avatar)

                 continue
 
-            if obj.state not in ('Off', 'WaitClientsReady', 'StageOne'):
-                # a finished instance is never deleted and its world uids stay taken: one fight per server run
-                self.notify.warning('Black Pearl %d is in %s, avatar %d cannot join' % (obj.doId, obj.state, avatarId))
+            if obj.isJoinable():

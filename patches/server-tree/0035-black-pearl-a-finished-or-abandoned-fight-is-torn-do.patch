         DistributedTreasureMapInstanceAI.delete(self)
 
+    # =========================================================================
+    # Teardown - a finished or abandoned fight gives its world back
+    # =========================================================================
+
+    def _isInside(self, avatar):
+        """True when the avatar is somewhere under this instance (its island, areas, ocean, a ship)"""
+        parentId = getattr(avatar, 'parentId', None)
+        for _ in range(10):
+            if not parentId:
+                return False
+
+            if parentId == self.doId:
+                return True
+
+            parent = self.air.doId2do.get(parentId)
+            parentId = getattr(parent, 'parentId', None)
+
+        return False
+
+    def hasPlayersInside(self):
+        """True when a pirate is inside (any pirate, not only the participants); also drops the participants who
+        left, logged out or never arrived"""
+        from pirates.pirate.DistributedPlayerPirateAI import DistributedPlayerPirateAI
+        inside = False
+        for obj in list(self.air.doId2do.values()):
+            if isinstance(obj, DistributedPlayerPirateAI) and self._isInside(obj):
+                inside = True
+                break
+
+        if inside:
+            self.lastActivity = time.time()
+        elif time.time() - self.lastActivity > self.MONITOR_INTERVAL * 2:
+            # not in yet (a teleport takes a few seconds) is fine; not in and not coming is not
+            for avatarId in list(self.participants):
+                self.removeParticipant(avatarId)
+
+        return inside
+
+    def isJoinable(self):
+        """A fight still at its start takes more pirates while someone is in it or it has just been started"""
+        if self.tornDown or self.state not in ('Off', 'WaitClientsReady', 'StageOne'):
+            return False
+
+        return self.hasPlayersInside() or time.time() - self.lastActivity < self.EMPTY_GRACE_TIME
+
+    def _monitorPlayers(self, task):
+        if self.tornDown:
+            return Task.done
+
+        if not self.hasPlayersInside():
+            if self.state == 'Completed':
+                self.notify.info('Black Pearl %d is over and empty, tearing it down' % self.doId)
+                self.teardown()
+                return Task.done
+
+            if time.time() - self.lastActivity > self.EMPTY_GRACE_TIME:
+                self.notify.info('Black Pearl %d (%s) has been empty for %d s, tearing it down' % (
+                    self.doId, self.state, self.EMPTY_GRACE_TIME))
+                self.teardown()
+                return Task.done
+
+        return Task.again
+
+    def teardown(self):
+        """Delete this instance and everything under it, and free its world uids so the next requestStart builds
+        a fresh one. Astron deletes the children when the instance goes and tells this AI about each one; callers
+        tear down only an instance nobody is inside."""
+        if self.tornDown:
+            return
+
+        self.tornDown = True
+        self.notify.info('Tearing down Black Pearl instance %d (state %s)' % (self.doId, self.state))
+        taskMgr.remove(self.uniqueName('monitorPlayers'))
+
+        # everything under the instance, found before the delete empties the tables
+        found = set([self.doId])
+        objects = list(self.air.doId2do.values())
+        grew = True
+        while grew:
+            grew = False
+            for obj in objects:
+                if obj.doId not in found and getattr(obj, 'parentId', None) in found:
+                    found.add(obj.doId)
+                    grew = True
+
+        # its world uids stay taken until freed: the next start would be handed this instance's old objects
+        uidMgr = self.air.uidMgr
+        for uid, doId in list(uidMgr.uid2doId.items()):
+            if doId in found:
+                taskMgr.remove('uidCallback-' + uid)
+                uidMgr.removeUid(uid)
+
+        for uid, obj in list(uidMgr.uid2obj.items()):
+            if getattr(obj, 'doId', None) in found:
+                uidMgr.removeUidObj(uid)
+
+        # the world creator and the ship manager follow the newest world: point them back at the main world
+        mainWorld = None
+        for obj in objects:
+            if isinstance(obj, DistributedInstanceBaseAI) and obj.doId not in found \
+                    and obj.getType() == PiratesGlobals.INSTANCE_MAIN:
+                mainWorld = obj
+                break
+
+        if mainWorld is not None:
+            if self.air.worldCreator.world is self:
+                self.air.worldCreator.world = mainWorld
+
+            if self.air.shipManager.world is self:
+                self.air.shipManager.world = mainWorld
+
+        self.requestDelete()
+
     # =========================================================================
     # Interest Management - Ensure clients see the Black Pearl
     # =========================================================================

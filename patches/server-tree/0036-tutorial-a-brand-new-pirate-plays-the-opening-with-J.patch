--- a/pirates/tutorial/DistributedPiratesTutorialAI.py
+++ b/pirates/tutorial/DistributedPiratesTutorialAI.py
@@ -1,6 +1,7 @@
 from direct.distributed.DistributedObjectAI import DistributedObjectAI
 from direct.directnotify import DirectNotifyGlobal
 from direct.fsm.FSM import FSM
+from direct.task import Task
 
 from pirates.piratesbase import PiratesGlobals
 from pirates.tutorial import TutorialGlobals
@@ -15,6 +16,12 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
         FSM.__init__(self, 'DistributedPiratesTutorialAI')
 
         self.avatarId = None
+        self._jackIntroStarted = False
+        self._jackIntroTries = 0
+
+    def delete(self):
+        taskMgr.remove(self.uniqueName('jackIntro'))
+        DistributedObjectAI.delete(self)
 
     def setAvatarId(self, avatarId):
         self.avatarId = avatarId
@@ -41,6 +48,46 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
 
         self.notify.info('Avatar %d entered Act0Tutorial' % self.avatarId)
         self.request('Act0Tutorial')
+        # family server: nothing started the first quest's jail scene (Jack Sparrow), so a new pirate sat in the
+        # dark jail forever. Give Chapter1.rung1 and play its first finalize scene; the client's
+        # 'doneJackIntro' (the scene's sendEvent) then opens Make-A-Pirate.
+        if avatar.getTutorial() == PiratesGlobals.TUT_STARTED and not self._jackIntroStarted:
+            self._jackIntroStarted = True
+            taskMgr.doMethodLater(1.0, self._startJackIntro, self.uniqueName('jackIntro'))
+
+    def _startJackIntro(self, task):
+        avatar = self.getAvatar()
+        if not avatar:
+            return Task.done
+
+        questMgr = self.air.questMgr
+        self._jackIntroTries += 1
+        if not avatar.getInventory() or avatar.doId in questMgr.avatar2fsm:
+            # the inventory or another quest job is not ready yet
+            if self._jackIntroTries > 60:
+                self.notify.warning('Avatar %d: gave up starting the Jack Sparrow intro' % avatar.doId)
+                return Task.done
+
+            return Task.again
+
+        def _play(quest):
+            if not quest:
+                self.notify.warning('Avatar %d: no %s quest for the Jack Sparrow intro' % (
+                    avatar.doId, TutorialGlobals.FIRST_QUEST))
+                return
+
+            self.notify.info('Avatar %d: playing the Jack Sparrow intro (quest %d)' % (avatar.doId, quest.doId))
+            # give the client a moment to generate its copy of the quest
+            taskMgr.doMethodLater(2.0, lambda task: questMgr.finalizeCutscene(avatar, quest, 0, npc=None),
+                self.uniqueName('jackIntro'))
+
+        quest = questMgr.getQuest(avatar, questId=TutorialGlobals.FIRST_QUEST)
+        if quest:
+            _play(quest)
+        else:
+            questMgr.createQuest(avatar, TutorialGlobals.FIRST_QUEST, callback=_play)
+
+        return Task.done
 
     def makeAPirateComplete(self):
         """Client finished the Make-A-Pirate customization screen.
@@ -57,6 +104,9 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
 
         # Mark customisation complete so later logins skip this step.
         avatar.b_setTutorial(PiratesGlobals.TUT_MADE_PIRATE)
+        # the rung1 jail scene '1.1.2' waits for this (QuestManagerAI finalizeCutscene waitEvent)
+        avatar.__dict__.setdefault('finalizeEventsSeen', set()).add('makeAPirateComplete')
+        messenger.send(avatar.uniqueName('makeAPirateComplete'))
 
         # Give the first tutorial quest (Jack Sparrow jail-break storyline).
         if not self.air.questMgr.hasQuest(avatar, questId=TutorialGlobals.FIRST_QUEST):
@@ -131,6 +181,9 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
 
         self.notify.info('Avatar %d finished target practice' % self.avatarId)
         self.request('TargetPracticeDone')
+        # the rung3 Jolly Roger scene '1.3' waits for this (QuestManagerAI finalizeCutscene waitEvent)

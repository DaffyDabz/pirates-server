+            # aboard to his return island, the way docking lands a crew, and is deleted
+            # only once nobody stands on it. (Asking the teleport manager instead never
+            # worked: it looks for the world above the pirate's parent, which is the
+            # ship, finds none and gives up; 2026-11-16.)
+            aboard = self.ship.getPiratesAboard()
+            if not aboard:
+                self.ship.requestDelete()
+                return Task.done
+
+            self._sunkTries += 1
+            if self._sunkTries <= 5:
+                for av in aboard:
                     try:
-                        uid = av.getReturnLocation() if hasattr(av, 'getReturnLocation') else ''
-                        self.air.teleportMgr.d_initiateTeleport(av, locationUid=uid or '1150922126.8dzlu')
+                        self.ship.sendCrewAshore(av)
                     except Exception as e:
                         self.notify.warning('sunk ship %s: could not send %s ashore: %s' % (self.ship.doId, av.doId, e))
-                return Task.again     # (leaving the ship puts it away and ends this task)
+            elif self._sunkTries == 6:
+                self.notify.warning('sunk ship %s: %s still aboard; it stays until they leave'
+                    % (self.ship.doId, [av.doId for av in aboard]))
 
-            self.ship.requestDelete()
-            return Task.done
+            task.delayTime = 15
+            return Task.again
 
-        self._sinkingTask = taskMgr.doMethodLater(60, _shipSunk, 
+        # the crew's sinking scene runs about 15 s and ends on a black screen
+        delay = 20 if self.ship.getPiratesAboard() else 60
+        self._sinkingTask = taskMgr.doMethodLater(delay, _shipSunk,
                                                    self.ship.uniqueName('shipSunk'))
     def exitSinking(self):
         if self._sinkingTask is not None:

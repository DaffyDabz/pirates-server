-            crew = [self.air.doId2do.get(avId) for avId in list(getattr(self.ship, 'crew', []) or [])]
-            crew = [av for av in crew if av is not None]
-            self._sunkTries = getattr(self, '_sunkTries', 0) + 1
-            if crew and self._sunkTries <= 3:
-                task.delayTime = 30
-                for av in crew:

@@ -302,6 +297,58 @@ class DistributedTeleportMgrAI(DistributedObjectAI):
 
         self.d_initiateTeleport(avatar, instanceType, instanceName, locationUid)
 
+    def teleportToFriend(self, avatar, friendDoId):
+        # family server (11-16): his client checked his own teleport flags; this checks the friend: in this
+        # district, on land in the main world, not busy, not where he is already. A refusal is sent back as the
+        # friend's own client would answer (teleportResponse with the reason's flag), so his client says why and
+        # lets go of its teleport lock
+        from pirates.ship.DistributedShipAI import DistributedShipAI
+        from pirates.world.DistributedJailInteriorAI import DistributedJailInteriorAI
+
+        friend = self.air.doId2do.get(friendDoId)
+        area = friend.getParentObj() if friend else None
+        world = self.getStandingWorld(friend) if area else None
+        refused = None
+        if isinstance(area, DistributedShipAI):
+            # the old way onto a friend's ship (_localTeleportToIdResponse) left him at his own last spawn point,
+            # still locked
+            refused = PiratesGlobals.TFOnShip
+        elif not isinstance(area, DistributedGameAreaAI) or not world or \
+                world.getType() != PiratesGlobals.INSTANCE_MAIN:
+            refused = PiratesGlobals.TFUnavailable
+        elif isinstance(area, DistributedJailInteriorAI):
+            refused = PiratesGlobals.TFInJail
+        elif hasattr(friend, 'getTeleportFlags'):
+            # not TFInInitTeleport: the AI starts every pirate with it and only hears it cleared from his client
+            busy = friend.getTeleportFlags() & ((PiratesGlobals.TFNoTeleport & ~PiratesGlobals.TFInInitTeleport) |
+                PiratesGlobals.TFInWelcomeWorld)
+            if not busy.isZero():
+                refused = busy
+
+        if refused is not None:
+            self.notify.info('Cannot teleport avatar %d to friend %d, flag %s' % (avatar.doId, friendDoId, refused))
+            self.d_teleportRefused(avatar, friendDoId, PiratesGlobals.encodeTeleportFlag(refused))
+            return
+
+        if avatar.getParentObj() is area:
+            # -1: he is where you are already (the client's own answers are 0 and the encoded flags, 1 and up)
+            self.d_teleportRefused(avatar, friendDoId, -1)
+            return
+
+        # three feet in front of the friend, facing him, when the AI has his position (else the island's spawn point)
+        spawnPt = None
+        pt = area.getRelativePoint(friend, Point3(0, 3, 0))
+        if area.isAncestorOf(friend) and friend.getPos() != Point3(0, 0, 0) and \
+                area.isValidZone(area.getZoneFromXYZ((pt[0], pt[1], pt[2]))):
+            spawnPt = (pt[0], pt[1], pt[2], friend.getH(area) + 180)
+
+        self.notify.info('Teleporting avatar %d to friend %d in %s, spawn %s' % (avatar.doId, friendDoId,
+            area.getUniqueId(), spawnPt))
+        self.d_initiateTeleport(avatar, world.getType(), world.getFileName(), area.getUniqueId(), spawnPt)
+
+    def d_teleportRefused(self, avatar, friendDoId, code):
+        avatar.sendUpdateToAvatarId(avatar.doId, 'teleportResponse', [friendDoId, code, 0, 0, 0])
+
     def requestTeleportToIsland(self, locationUid):

 pirates/ship/TutorialShipAI.py                | 82 +++++++++++++++++++
 .../tutorial/DistributedPiratesTutorialAI.py  | 21 +++++
 2 files changed, 103 insertions(+)

diff --git a/pirates/ship/TutorialShipAI.py b/pirates/ship/TutorialShipAI.py
index 074f7c8..3bd4eb1 100644
--- a/pirates/ship/TutorialShipAI.py
+++ b/pirates/ship/TutorialShipAI.py
@@ -1,13 +1,95 @@
+import math
+
 from direct.directnotify import DirectNotifyGlobal
+from direct.task import Task
 
 from pirates.ship.DistributedShipAI import DistributedShipAI
 from pirates.ship import ShipGlobals
 from pirates.battle.DistributedTutorialShipCannonAI import DistributedTutorialShipCannonAI
 
 
+# Bo Beck's sailing path in the tutorial, from RambleshackWorld: the boat's movement nodes (the boat links to the
+# first, then they loop). Same frame as the boat's dock spot (the ocean grid's).
+TUTORIAL_SAIL_PATH = [
+    (295.185, 181.66),
+    (672.532, 405.492),
+    (527.776, 787.869),
+    (101.138, 707.24),
+    (-18.992, 322.654),
+]
+TUTORIAL_SAIL_SPEED = 15.0      # units a second
+TUTORIAL_SAIL_TURN_RATE = 30.0  # degrees a second
+TUTORIAL_SAIL_ARRIVE = 40.0     # this close to a node counts as there
+TUTORIAL_SAIL_TICK = 0.2        # seconds between position updates
+
+
 class TutorialShipAI(DistributedShipAI):
     notify = DirectNotifyGlobal.directNotify.newCategory('TutorialShipAI')
 
+    def __init__(self, air):
+        DistributedShipAI.__init__(self, air)
+        self._sailNode = 0
+        self._sailing = False
+
+    def delete(self):
+        self.stopTutorialSail()
+        DistributedShipAI.delete(self)
+
+    def startTutorialSail(self):
+        # Target practice: the client makes the wreck and waits for the boat to sail past it. Nothing moved
+        # the boat, so it sat at the dock. Sail the world-data path: dock -> first node, then loop.
+        if self._sailing:
+            return
+
+        grid = self.air.doId2do.get(self.parentId)
+        if grid is None:
+            self.notify.warning('Tutorial boat %d has no ocean grid to sail on' % self.doId)
+            return
+
+        self._sailing = True
+        self._sailNode = 0
+        taskMgr.doMethodLater(TUTORIAL_SAIL_TICK, self.__sailTask, self.uniqueName('tutorialSail'),
+            extraArgs=[grid], appendTask=True)
+        self.notify.info('Tutorial boat %d sailing to the wreck' % self.doId)
+
+    def stopTutorialSail(self):
+        if self._sailing:
+            self.notify.info('Tutorial boat %d stopped sailing' % self.doId)
+        self._sailing = False
+        taskMgr.remove(self.uniqueName('tutorialSail'))
+
+    def __sailTask(self, grid, task):
+        if not self._sailing or self.isEmpty() or grid.isEmpty():
+            self._sailing = False
+            return Task.done
+
+        x, y, z = self.getPos(grid)
+        h = self.getH(grid)
+        tx, ty = TUTORIAL_SAIL_PATH[self._sailNode]
+        dx, dy = tx - x, ty - y
+        if dx * dx + dy * dy < TUTORIAL_SAIL_ARRIVE * TUTORIAL_SAIL_ARRIVE:
+            self._sailNode = (self._sailNode + 1) % len(TUTORIAL_SAIL_PATH)
+            tx, ty = TUTORIAL_SAIL_PATH[self._sailNode]
+            dx, dy = tx - x, ty - y
+
+        # Panda heading: 0 faces +Y; turn toward the node at a limited rate so the boat curves
+        want = math.degrees(math.atan2(-dx, dy))
+        turn = (want - h + 180.0) % 360.0 - 180.0
+        maxTurn = TUTORIAL_SAIL_TURN_RATE * TUTORIAL_SAIL_TICK
+        h += max(-maxTurn, min(maxTurn, turn))
+        step = TUTORIAL_SAIL_SPEED * TUTORIAL_SAIL_TICK
+        x -= math.sin(math.radians(h)) * step
+        y += math.cos(math.radians(h)) * step
+
+        self.setPos(grid, x, y, z)
+        self.setH(grid, h)
+        try:
+            self.sendCurrentPosition()
+        except Exception:
+            pass
+
+        return Task.again
+
     def _makeCannon(self, cannonType):
         # Stumpy's boat: cannon config [TUTORIAL_CANNON, 0]. The client tutorial takes the FIRST cannon in
         # its ship.cannons dict and switches it on, so the boat carries the tutorial cannon only: an extra
diff --git a/pirates/tutorial/DistributedPiratesTutorialAI.py b/pirates/tutorial/DistributedPiratesTutorialAI.py
index c96f37f..caee388 100644
--- a/pirates/tutorial/DistributedPiratesTutorialAI.py
+++ b/pirates/tutorial/DistributedPiratesTutorialAI.py
@@ -31,6 +31,18 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
             return self.air.doId2do.get(self.avatarId)
         return None
 
+    def getStumpyBoat(self):
+        # Bo Beck's boat for this pirate (the tutorial manager spawned it); else the ship the pirate stands on
+        manager = getattr(self.air, 'tutorialManager', None)
+        fsm = manager.avatar2fsm.get(self.avatarId) if manager else None
+        boat = getattr(fsm, 'stumpyBoat', None)
+        if boat is None:
+            avatar = self.getAvatar()
+            parent = self.air.doId2do.get(getattr(avatar, 'parentId', 0)) if avatar else None
+            if parent is not None and hasattr(parent, 'startTutorialSail'):
+                boat = parent
+        return boat
+
     # --------------------------------------------------
     # Client -> AI messages (airecv clsend)
     # --------------------------------------------------
@@ -172,6 +184,11 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
 
         self.notify.info('Avatar %d started sailing with Stumpy' % self.avatarId)
         self.request('Sailing')
+        boat = self.getStumpyBoat()
+        if boat is not None and hasattr(boat, 'startTutorialSail'):
+            boat.startTutorialSail()
+        else:
+            self.notify.warning('Avatar %d: no tutorial boat to sail' % self.avatarId)
 
     def targetPracticeDone(self):
         """Client finished cannon target practice."""
@@ -181,6 +198,10 @@ class DistributedPiratesTutorialAI(DistributedObjectAI, FSM):
 
         self.notify.info('Avatar %d finished target practice' % self.avatarId)
         self.request('TargetPracticeDone')
+        # the Jolly Roger scene plays on its own stand-in boat; hold the real one still under it
+        boat = self.getStumpyBoat()
+        if boat is not None and hasattr(boat, 'stopTutorialSail'):
+            boat.stopTutorialSail()
         # the rung3 Jolly Roger scene '1.3' waits for this (QuestManagerAI finalizeCutscene waitEvent)
         avatar.__dict__.setdefault('finalizeEventsSeen', set()).add('tutorialJROnStage')
         messenger.send(avatar.uniqueName('tutorialJROnStage'))

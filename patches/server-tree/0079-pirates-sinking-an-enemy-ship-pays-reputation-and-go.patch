From 25d1eba1fda29cd6171d346fa616c90c1b1cccd3 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 15:28:51 -0800
Subject: [PATCH 079/371] pirates: sinking an enemy ship pays reputation and
 gold to the pirates who hurt it, and a ship's hp stays within its max, as
 server-tree patch 0093 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/DistributedShipAI.py      |   7 +-
 pirates/ship/NPCShipAI.py              | 127 +++++++++++++++++++++++++
 pirates/shipparts/DistributedHullAI.py |   6 ++
 3 files changed, 137 insertions(+), 3 deletions(-)

diff --git a/pirates/ship/DistributedShipAI.py b/pirates/ship/DistributedShipAI.py
index b16218d..1bd5533 100644
--- a/pirates/ship/DistributedShipAI.py
+++ b/pirates/ship/DistributedShipAI.py
@@ -789,8 +789,9 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
 
     def setHp(self, hp):
         oldHp = self.hp
-        self.hp = min(hp, self.maxHp)
-        self.hp = max(hp, 0)
+        # the second clamp used the raw hp, so a hit or repair could leave a ship
+        # above its max hp; int, since a hull hit sends a float to an int16 field
+        self.hp = int(max(min(hp, self.maxHp), 0))
         DidChange = oldHp != self.hp
         if self.hp == 0 and DidChange:
             self.b_setGameState('Sinking', 0)
@@ -800,7 +801,7 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
 
     def b_setHp(self, hp):
         self.setHp(hp)
-        self.d_setHp(hp)
+        self.d_setHp(self.hp)
 
     def getHp(self):
         return self.hp

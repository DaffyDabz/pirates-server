From d680a0cec53eabfe59c972e288e3fbd7d4b8ec8a Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 16:06:51 -0800
Subject: [PATCH 081/371] pirates: sinking an enemy ship drops plunder that the
 crew can sell, as server-tree patch 0095 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/DistributedShipAI.py | 76 +++++++++++++++++++++++++++++++
 pirates/ship/NPCShipAI.py         | 48 +++++++++++++++++++
 2 files changed, 124 insertions(+)

diff --git a/pirates/ship/DistributedShipAI.py b/pirates/ship/DistributedShipAI.py
index 1bd5533..7340784 100644
--- a/pirates/ship/DistributedShipAI.py
+++ b/pirates/ship/DistributedShipAI.py
@@ -793,6 +793,9 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
         # above its max hp; int, since a hull hit sends a float to an int16 field
         self.hp = int(max(min(hp, self.maxHp), 0))
         DidChange = oldHp != self.hp
+        if self.hp == 0 and DidChange and self.cargo and not self.npcShip:
+            self.b_setCargo([])  # the plunder in the hold goes down with the ship
+
         if self.hp == 0 and DidChange:
             self.b_setGameState('Sinking', 0)
 
@@ -871,6 +874,73 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
     def getCargo(self):
         return self.cargo
 
+    def addPlunder(self, items):
+        """
+        A sunk enemy ship's crates and chests (EconomyGlobals ItemId.CARGO_*) go
+        into this ship's hold, as far as it has room, and its crew sees the loot
+        pop-up. Returns what fitted.
+        """
+        if self.npcShip or not items:
+            return []
+
+        cargo = list(self.cargo or [])
+        room = max(0, int(self.maxCargo or 0) - len(cargo))
+        taken = list(items[:room])
+        if not taken:
+            for avId in self.crew:
+                avatar = self.air.doId2do.get(avId)
+                if avatar is not None and hasattr(avatar, 'd_setSystemMessage'):
+                    avatar.d_setSystemMessage(0, 'Your hold is full! Drop anchor at a port to sell your plunder.')
+
+            return []
+
+        self.b_setCargo(cargo + taken)
+        self.sendUpdate('notifyReceivedLoot', [taken])
+        self.notify.info('ship %s: plunder %s into the hold (%d/%d)' % (
+            self.doId, taken, len(self.cargo), self.maxCargo))
+        return taken
+
+    def sellPlunder(self):
+        """
+        Dropping anchor at a port sells the hold: each crate or chest is opened
+        into one of its goods (EconomyGlobals' cargo table, by rarity) and the
+        gold is shared by the crew aboard, the captain taking the client's
+        captain bonus (CAPTAIN_LOOT_MULTIPLIER) when he has a crew.
+        """
+        from pirates.economy import EconomyGlobals
+        import random
+
+        cargo = list(self.cargo or [])
+        if self.npcShip or not cargo:
+            return
+
+        value = 0
+        for container in cargo:
+            goods = EconomyGlobals.getAllCargoType(container)
+            if not goods:
+                continue
+
+            weights = [EconomyGlobals.getCargoRarity(good) or 1 for good in goods]
+            value += EconomyGlobals.getCargoValue(random.choices(goods, weights)[0]) or 0
+
+        self.b_setCargo([])
+        crew = [self.air.doId2do.get(avId) for avId in self.crew]
+        crew = [avatar for avatar in crew if avatar is not None and avatar.getInventory()]
+        if not crew or value <= 0:
+            return
+
+        share = max(1, value // len(crew))
+        for avatar in crew:
+            gold = share
+            if len(crew) > 1 and avatar.doId == self.getOwnerId():
+                gold += int(share * EconomyGlobals.CAPTAIN_LOOT_MULTIPLIER)
+
+            avatar.getInventory().addGoldInPocket(gold)
+            avatar.d_setSystemMessage(0, 'You sold your plunder for %d gold!' % gold)
+
+        self.notify.info('ship %s: sold %d containers of plunder for %d gold, %d crew' % (
+            self.doId, len(cargo), value, len(crew)))
+
     def setMaxCrew(self, maxCrew):
         self.maxCrew = maxCrew
 
@@ -957,6 +1027,12 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
         assert(parentObj is not None)
         spawnPt = parentObj.getSpawnPt(island.getUniqueId())
 
+        # plunder in the hold is sold at the port, before the crew goes ashore
+        try:
+            self.sellPlunder()
+        except Exception as e:
+            self.notify.warning('ship %s: could not sell plunder: %r' % (self.doId, e))
+
         # send everyone on the ship to the island
         for avatarId in self.crew:
             avatar = self.air.doId2do.get(avatarId)
diff --git a/pirates/ship/NPCShipAI.py b/pirates/ship/NPCShipAI.py
index 0f3fd75..189656c 100644
--- a/pirates/ship/NPCShipAI.py
+++ b/pirates/ship/NPCShipAI.py
@@ -1,3 +1,5 @@
+import random
+
 from direct.directnotify import DirectNotifyGlobal
 
 from pirates.ship.DistributedShipAI import DistributedShipAI
@@ -8,6 +10,26 @@ from pirates.battle import WeaponGlobals
 from pirates.pirate import AvatarTypes
 from pirates.piratesbase import Freebooter
 from pirates.uberdog.UberDogGlobals import InventoryType
+from pirates.economy import EconomyGlobals
+from pirates.economy.EconomyGlobals import ItemId
+
+# the odds of each plunder container a sunk ship drops into its sinkers' hold
+# (EconomyGlobals' crate table: crate 50, chest 45, royal chest 5)
+PLUNDER_WEIGHTS = getattr(EconomyGlobals, '__crateCargoList', None) or {
+    ItemId.CARGO_CRATE: 50,
+    ItemId.CARGO_CHEST: 45,
+    ItemId.CARGO_SKCHEST: 5}
+
+
+def rollPlunder(level):
+    """
+    The containers one sunk ship drops: one, plus one for every ten levels,
+    up to four, each a crate, a chest or (rarely) a royal chest
+    """
+    count = max(1, min(4, 1 + int(level) // 10))
+    kinds = sorted(PLUNDER_WEIGHTS)
+    weights = [PLUNDER_WEIGHTS[kind] for kind in kinds]
+    return [random.choices(kinds, weights)[0] for _ in range(count)]
 
 # the enemy faction a ship's team counts as, for its gold drop (the same map
 # QuestManagerAI.shipDefeated uses for quest credit)
@@ -207,6 +229,32 @@ class NPCShipAI(DistributedShipAI):
             except Exception as e:
                 self.notify.warning('Could not pay pirate %d for sinking ship %d: %s' % (avId, self.doId, e))
 
+        try:
+            self._givePlunder(credit, level)
+        except Exception as e:
+            self.notify.warning('Could not give plunder for ship %d: %s' % (self.doId, e))
+
+    def _givePlunder(self, credit, level):
+        """
+        Plunder: the sunk ship's crates and chests go into the hold of each
+        pirate ship whose crew hurt it. The hold, its meter and the loot pop-up
+        were all on the client, but nothing ever filled the hold (2026-11-17).
+        The cargo is sold for gold when the ship drops anchor at a port
+        (DistributedShipAI.sellPlunder) and lost if the ship sinks.
+        """
+        ships = {}
+        for avId in credit:
+            avatar = self.air.doId2do.get(avId)
+            shipId = getattr(avatar, 'getCrewShipId', lambda: 0)() if avatar else 0
+            ship = self.air.doId2do.get(shipId) if shipId else None
+            if ship is None or isinstance(ship, NPCShipAI) or not hasattr(ship, 'addPlunder'):
+                continue
+
+            ships[ship.doId] = ship
+
+        for ship in ships.values():
+            ship.addPlunder(rollPlunder(level))
+

+    # family server: the store showed (and the client checked) cost x pack size, but the AI charged the cost once, so
+    # ammo and potion packs were nearly free and a fractional cost (0.3 a shot) turned gold into a float. A ship was
+    # created before the overflow check and before gold was taken, and got a junk inventory stack. Pouches never
+    # raised the ammo limits. Selling paid the full price (the store shows half) and returned no answer, so the
+    # client never heard back.
+    def _itemPrice(self, itemId, itemQuantity):
+        cost = EconomyGlobals.getItemCost(itemId)
+        if cost is None or itemQuantity < 1:
+            return None
+        if not cost:
+            return 0
+        # the same sum the store shows: int(cost x quantity), at least 1 gold
+        return max(int(cost * itemQuantity), 1)
+

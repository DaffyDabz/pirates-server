 from direct.distributed.DistributedObjectAI import DistributedObjectAI
 from direct.directnotify import DirectNotifyGlobal
 from otp.uberdog.RejectCode import RejectCode
 from pirates.economy import EconomyGlobals
 from pirates.makeapirate import BarberGlobals
+from pirates.makeapirate import ClothingGlobals, JewelryGlobals, TattooGlobals
 from pirates.uberdog.UberDogGlobals import InventoryType, InventoryCategory
 
+# family server: clothing / tattoo / jewelry stores. Owned items ("wardrobes") are not in the dc, so they are kept
+# in one small json file per avatar under the AI's working directory (wardrobe/<avId>.json). What the pirate
+# wears is always counted as owned, and is added to the file the first time a store list is asked for.
+WARDROBE_DIR = 'wardrobe'
+SELL_FRACTION = 0.25
+FEMALE_UID_START = 80000
+TATTOO_FIELDS = ['Chest', 'Zone2', 'Zone3', 'Zone4', 'Zone5', 'Zone6', 'Zone7', 'Zone8']
+# jewelry type (JewelryGlobals) -> dna zone number (setJewelryZoneN), exactly as JewelryStoreGUI.closePanel maps them
+JEWELRY_ZONE = {
+    JewelryGlobals.RBROW: 4, JewelryGlobals.LBROW: 3, JewelryGlobals.LEAR: 1, JewelryGlobals.REAR: 2,
+    JewelryGlobals.NOSE: 5, JewelryGlobals.MOUTH: 6, JewelryGlobals.LHAND: 7, JewelryGlobals.RHAND: 8}
+JEWELRY_TYPE_OF_ZONE = dict((zone, jtype) for jtype, zone in JEWELRY_ZONE.items())
+
+_clothesLookup = None
+_tattooLookup = None
+_jewelryLookup = None
+
+
+def _wardrobePath(avId):
+    return os.path.join(WARDROBE_DIR, '%d.json' % int(avId))
+
+
+def _loadWardrobe(avId):
+    data = None
+    try:
+        with io.open(_wardrobePath(avId), 'r', encoding='utf-8') as f:
+            data = json.load(f)
+    except (IOError, OSError, ValueError):
+        data = None
+    if not isinstance(data, dict):
+        data = {}
+    wardrobe = {'clothes': [], 'tattoos': [], 'jewelry': []}
+    try:
+        wardrobe['clothes'] = [[int(e[0]), int(e[1]), int(e[2])] for e in data.get('clothes', [])]
+        wardrobe['tattoos'] = [int(e) for e in data.get('tattoos', [])]
+        wardrobe['jewelry'] = [int(e) for e in data.get('jewelry', [])]
+    except (TypeError, ValueError, IndexError):
+        wardrobe = {'clothes': [], 'tattoos': [], 'jewelry': []}
+    return wardrobe
+
+
+def _saveWardrobe(avId, wardrobe):
+    path = _wardrobePath(avId)
+    tmp = path + '.tmp'
+    try:
+        if not os.path.isdir(WARDROBE_DIR):
+            os.makedirs(WARDROBE_DIR)
+        with io.open(tmp, 'w', encoding='utf-8') as f:
+            f.write(json.dumps(wardrobe))
+        os.replace(tmp, path)
+        return True
+    except (IOError, OSError):
+        return False
+
+
+def _clothesUid(female, ctype, model, tex):
+    global _clothesLookup
+    if _clothesLookup is None:
+        lookup = {}
+        for uid in sorted(ClothingGlobals.UNIQUE_ID):
+            item = ClothingGlobals.UNIQUE_ID[uid]
+            lookup.setdefault((uid >= FEMALE_UID_START, item[0], item[1], item[2]), uid)
+        _clothesLookup = lookup
+    return _clothesLookup.get((female, ctype, model, tex))
+
+
+def _tattooUid(zone, tattooId):
+    global _tattooLookup
+    if _tattooLookup is None:
+        lookup = {}
+        for uid in sorted(TattooGlobals.tattoos):
+            item = TattooGlobals.tattoos[uid]
+            lookup.setdefault((item[0], item[1]), uid)
+        _tattooLookup = lookup
+    return _tattooLookup.get((zone, tattooId))
+
+
+def _jewelryUid(female, jtype, idx, primary, secondary):
+    global _jewelryLookup
+    if _jewelryLookup is None:
+        lookup = {}
+        for uid in sorted(JewelryGlobals.jewelry_id):
+            item = JewelryGlobals.jewelry_id[uid]
+            lookup.setdefault((uid >= FEMALE_UID_START, item[1], item[0], item[4], item[5]), uid)
+        _jewelryLookup = lookup
+    return _jewelryLookup.get((female, jtype, idx, primary, secondary))
+
+
+def _clothesPrice(item, color):
+    scaler = ClothingGlobals.colorCostScaler.get(color)
+    cost = item[5]
+    if scaler:
+        cost = int(cost * scaler)
+    return int(cost)
+
+
+def _clamp(value, low, high):
+    return int(max(low, min(high, value)))
+
+
 class DistributedShopKeeperAI(DistributedObjectAI):
     notify = DirectNotifyGlobal.directNotify.newCategory('DistributedShopKeeperAI')
 

+    def _avatarUnexpectedExit(self, avatar):
+        seatIndex = self.getAvatarSeatIndex(avatar)
+        DistributedGameTableAI._avatarUnexpectedExit(self, avatar)
+        if seatIndex is not None:
+            self._totalWinnings[seatIndex] = PlayingCardGlobals.PlayerInactive
+            self._chipsCount = self._normalizeChipsCount(self._chipsCount)
+            self._chipsCount[seatIndex] = 0
+            self._seatLeft(seatIndex)
+
+    def _seatLeft(self, seatIndex):
+        # A player left (stood up or logged out): fold him out of the running hand
+        # at once instead of waiting 30 seconds for his turn to time out.
+        if not self._handActive or seatIndex not in self._activeBettors:
+            return
+        wasHead = bool(self._bettingOrder) and self._bettingOrder[0] == seatIndex
+        self._activeBettors.remove(seatIndex)
+        while seatIndex in self._bettingOrder:
+            self._bettingOrder.remove(seatIndex)
+        self._playerActions[seatIndex] = [PlayingCardGlobals.Fold, 0]
+        self._broadcastPlayerActions()
+        if len(self._activeBettors) <= 1 or not self._hasHuman():
+            self._endHand()
+        elif wasHead:
+            self._nextBettingAction()
+
+    def _humanInv(self, seatIndex):
+        seat = self.seats[seatIndex]
+        if seat is None or seat in (0, 1):
+            return None
+        return self.air.inventoryManager.getInventory(seat.doId)
+
+    def _hasHuman(self):
+        for seat in self.seats:
+            if seat is not None and seat not in (0, 1):
+                return True
+        return False
 

+        if seatIndex is not None:
+            if seatIndex < len(self._chipsCount):
+                self._chipsCount[seatIndex] = 0
+            self._seatLeft(seatIndex)
+
+    def _seatLeft(self, seatIndex):
+        # A player left (stood up or logged out). His bid is forfeited (the stake is
+        # already out of his pocket) and the round must not wait for him.
+        self._bids.pop(seatIndex, None)
+        self._stakes.pop(seatIndex, None)
+        wasWaiting = seatIndex in self._waitingBids
+        self._waitingBids.discard(seatIndex)
+        wasHead = bool(self._actionQueue) and self._actionQueue[0] == seatIndex
+        self._actionQueue = [s for s in self._actionQueue if s != seatIndex]
+        if wasWaiting:
+            self._checkAllBidsIn()
+        elif wasHead:
+            self._nextPlayerAction()
+
+    def _hasHuman(self):
+        for seat in self.seats:
+            if seat is not None and seat not in (0, 1):
+                return True
+        return False
 
     # ------------------------------------------------------------------
     # Game lifecycle

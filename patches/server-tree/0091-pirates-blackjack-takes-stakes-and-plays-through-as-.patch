+        taskMgr.remove(self.uniqueName('bj-action'))
+        self._applyBlackjackAction(seatIndex, actionCode, amount)
 
     def _applyBlackjackAction(self, seatIndex, actionCode, amount):
         if not self._actionQueue or self._actionQueue[0] != seatIndex:
             return
 
         hand = self._getCurrentHand(seatIndex)
+
+        if actionCode in (PlayingCardGlobals.DoubleDown, PlayingCardGlobals.Split):
+            # Both cost one more bid. Doubling is only for a single two-card hand.
+            inv = self._humanInv(seatIndex)
+            extra = self._bids.get(seatIndex, 0)
+            ok = len(hand) == 2
+            if actionCode == PlayingCardGlobals.DoubleDown and len(self._allHands[seatIndex]) != 1:
+                ok = False
+            if ok and inv and inv.getGoldInPocket() < extra:
+                ok = False
+            if not ok:
+                # Refused: ask the same player again
+                taskMgr.doMethodLater(0.5, self._nextPlayerAction, self.uniqueName('bj-action'))
+                return
+            if inv:
+                gold = inv.getGoldInPocket()
+                inv.setGoldInPocket(gold - extra)
+                self._stakes[seatIndex] = self._stakes.get(seatIndex, 0) + extra
+                self._chipsCount[seatIndex] = gold - extra
+
         self.sendUpdate('setEvent', [seatIndex, [actionCode, amount]])
 
         if actionCode == PlayingCardGlobals.Hit:

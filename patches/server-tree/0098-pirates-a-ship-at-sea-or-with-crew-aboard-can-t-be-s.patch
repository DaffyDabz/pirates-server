From 3e28af31dfa2235b42d0096f76b0be5b6ba97b9f Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 16:54:31 -0800
Subject: [PATCH 098/371] pirates: a ship at sea or with crew aboard can't be
 sold, as server-tree patch 0112 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/economy/DistributedShopKeeperAI.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/pirates/economy/DistributedShopKeeperAI.py b/pirates/economy/DistributedShopKeeperAI.py
index 70c3c24..8b12166 100644
--- a/pirates/economy/DistributedShopKeeperAI.py
+++ b/pirates/economy/DistributedShopKeeperAI.py
@@ -887,6 +887,22 @@ class DistributedShopKeeperAI(DistributedObjectAI):
         from pirates.economy import EconomyGlobals
 
         def _got(avatar, inventory, dclass, fields):
+            # a ship out at sea (or with anyone aboard) cannot be sold: it was
+            # taken off the pirate's list and paid for while it kept sailing,
+            # crew and all, as a ship nobody owned (2026-11-17)
+            ship = self.air.doId2do.get(shipId)
+            if ship is not None:
+                crew = list(getattr(ship, 'crew', None) or [])
+                state = getattr(ship, 'gameState', None) or ['Off']
+                state = state[0] if isinstance(state, (list, tuple)) else state
+                if crew or state not in ('Off', 'PutAway', 'Sunk'):
+                    self.notify.info('pirate %d may not sell ship %d: state %r, crew %s' % (
+                        avatar.doId, shipId, state, crew))
+                    if hasattr(avatar, 'd_setSystemMessage'):
+                        avatar.d_setSystemMessage(0, 'Bring your ship into port and put it away before you sell it.')
+                    self.d_makeSaleResponse(avatar.doId, 0)
+                    return
+
             shipClass, = fields['setShipClass']
             price = int(EconomyGlobals.getItemCost(ShipGlobals.getModelClass(shipClass)) / 2)
             ships = [s for s in inventory.getShipDoIdList() if s != shipId]

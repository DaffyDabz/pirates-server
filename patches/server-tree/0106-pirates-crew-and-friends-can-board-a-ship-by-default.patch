From 08fbefdafa10151ea7436e8cb1734c18aab3e4fb Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 17:53:20 -0800
Subject: [PATCH 106/371] pirates: crew and friends can board a ship by default
 and the Crew tick works at the dock, as server-tree patch 0120 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/PlayerShipAI.py         |  8 ++++++--
 pirates/world/DistributedDinghyAI.py | 10 ++++++++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/pirates/ship/PlayerShipAI.py b/pirates/ship/PlayerShipAI.py
index 2e6882d..4a0f26a 100644
--- a/pirates/ship/PlayerShipAI.py
+++ b/pirates/ship/PlayerShipAI.py
@@ -10,8 +10,12 @@ class PlayerShipAI(DistributedShipAI):
     def __init__(self, air):
         DistributedShipAI.__init__(self, air)
 
-        self.allowCrewState = False
-        self.allowFriendState = False
+        # the captain's Boarding Permissions panel starts from these (required
+        # broadcast fields): the original game, and this client's own PlayerShip,
+        # let his crew and his friends aboard unless he unticks them. Both were
+        # off, so every new ship showed "Crew" unticked
+        self.allowCrewState = True
+        self.allowFriendState = True
         self.allowGuildState = False
         self.allowPublicState = False
 
diff --git a/pirates/world/DistributedDinghyAI.py b/pirates/world/DistributedDinghyAI.py
index 35675ac..077fd0a 100644
--- a/pirates/world/DistributedDinghyAI.py
+++ b/pirates/world/DistributedDinghyAI.py
@@ -61,7 +61,7 @@ class DistributedDinghyAI(DistributedInteractiveAI):
         bandOptions = []
         for member in self.air.bandManager.getCrewmateMembers(avatar.doId):
             ship = self.air.bandManager.getDeployedShip(member.avatarId)
-            if not ship or not self.canSelectShip(ship):
+            if not ship or not self.canSelectShip(ship) or not self.allowsCrew(ship):
                 continue
 
             # the client's ShipDeployPanel reads the ship name/class off the
@@ -106,6 +106,12 @@ class DistributedDinghyAI(DistributedInteractiveAI):
 
         return True
 
+    def allowsCrew(self, ship):
+        # the captain unticked "Crew" in his Boarding Permissions panel: his
+        # crewmates' dinghy no longer offers his ship (the tick did nothing)
+        getAllowCrewState = getattr(ship, 'getAllowCrewState', None)
+        return getAllowCrewState is None or bool(getAllowCrewState())
+
     def selectBandShip(self, shipDoId):
         avatar = self.air.doId2do.get(self.air.getAvatarIdFromSender())
         if not avatar:
@@ -116,7 +122,7 @@ class DistributedDinghyAI(DistributedInteractiveAI):
             self.d_sendAvatarToShip(avatar.doId, 0)
             return
 
-        if not self.air.bandManager.areCrewmates(avatar.doId, ship.getCaptainId()):
+        if not self.air.bandManager.areCrewmates(avatar.doId, ship.getCaptainId()) or not self.allowsCrew(ship):
             self.d_sendAvatarToShip(avatar.doId, 0)
             return
 
-- 
2.53.0


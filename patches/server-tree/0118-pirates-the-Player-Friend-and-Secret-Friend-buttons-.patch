From 0eaf9376ce83e35a564bfeebb69773328e9459a0 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:57:24 -0800
Subject: [PATCH 118/371] pirates: the Player Friend and Secret Friend buttons
 no longer throw the pirate back to the login screen, as server-tree patch
 0132 (1 client file)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 otp/friends/PlayerFriendsManager.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/otp/friends/PlayerFriendsManager.py b/otp/friends/PlayerFriendsManager.py
index 2f87fb1..e31b97e 100644
--- a/otp/friends/PlayerFriendsManager.py
+++ b/otp/friends/PlayerFriendsManager.py
@@ -15,6 +15,14 @@ class PlayerFriendsManager(DistributedObjectGlobal):
     def delete(self):
         self.ignoreAll()
 
+    def sendUpdate(self, fieldName, args=[], sendToId=None):
+        # Family server: no PlayerFriendsManager runs on the server (4687 is
+        # not an uberdog in astrond.yml), and Astron disconnects a client that
+        # sends to an object it does not know. The 'Player Friend' and
+        # 'Secret Friend' buttons sent here and threw the player back to the
+        # login screen, so the request is dropped instead.
+        self.notify.warning('No player friends on this server: %s dropped' % fieldName)
+
     def sendRequestInvite(self, playerId):
         self.sendUpdate('requestInvite', [
             0,

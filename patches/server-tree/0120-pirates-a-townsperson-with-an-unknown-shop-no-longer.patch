Subject: [PATCH 120/371] pirates: a townsperson with an unknown shop no longer
 breaks his island's spawning, as server-tree patch 0134 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/battle/DistributedEnemySpawnerAI.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pirates/battle/DistributedEnemySpawnerAI.py b/pirates/battle/DistributedEnemySpawnerAI.py
index f64256e..fdbe870 100644
--- a/pirates/battle/DistributedEnemySpawnerAI.py
+++ b/pirates/battle/DistributedEnemySpawnerAI.py
@@ -358,7 +358,7 @@ class TownfolkSpawnNode(SpawnNodeBase):
     def setNPCAttributes(self, npc):
         shopId = self.objectData.get('ShopID', 'PORT_ROYAL_DEFAULTS')
         if not hasattr(PiratesGlobals, shopId):
-            self.notify.warning('Failed to spawn Townfolk (%s); Unknown shopId: %s' % (self.objKey, shopid))
+            self.notify.warning('Failed to spawn Townfolk (%s); Unknown shopId: %s' % (self.objKey, shopId))
         npc.setShopId(getattr(PiratesGlobals, shopId, 0))
 
         helpId = self.objectData.get('HelpID', 'NONE')

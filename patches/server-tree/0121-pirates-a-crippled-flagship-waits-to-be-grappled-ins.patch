From b371ab6e2a8746d25a90576ece6f0348b8598fc5 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:57:25 -0800
Subject: [PATCH 121/371] pirates: a crippled flagship waits to be grappled
 instead of sinking at once, as server-tree patch 0135 (AI only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/DistributedShipAI.py | 36 ++++++++++++
 pirates/ship/GameFSMShipAI.py     | 41 ++++++++++----
 pirates/ship/NPCShipAI.py         | 93 +++++++++++++++++++++++++++++++
 3 files changed, 160 insertions(+), 10 deletions(-)

diff --git a/pirates/ship/DistributedShipAI.py b/pirates/ship/DistributedShipAI.py
index 0e77682..87c659e 100644
--- a/pirates/ship/DistributedShipAI.py
+++ b/pirates/ship/DistributedShipAI.py
@@ -87,6 +87,11 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
         self.badge = [0, 0]
         self.isInBoardingPosition = 0
         self.landedGrapples = []
+        # flagship boarding (2026-11-17): on a crippled flagship, the pirate ship
+        # that may board it; on that pirate ship, the flagship. The client's grapple
+        # targets, ropes and "Board?" panel all key off it
+        self.boardableShipId = 0
+        self.sinkTimer = [0, 0]
         self.wishName = ''
         self.wishNameState = ''
         self.clientControllerDoId = 0
@@ -1158,6 +1163,37 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
     def getIsInBoardingPosition(self):
         return self.isInBoardingPosition
 
+    def setBoardableShipId(self, shipId):
+        self.boardableShipId = shipId
+
+    def d_setBoardableShipId(self, shipId):
+        self.sendUpdate('setBoardableShipId', [shipId])
+
+    def b_setBoardableShipId(self, shipId):
+        self.setBoardableShipId(shipId)
+        self.d_setBoardableShipId(shipId)
+
+    def getBoardableShipId(self):
+        return self.boardableShipId
+
+    def setSinkTimer(self, duration, timestamp):
+        self.sinkTimer = [duration, timestamp]
+
+    def d_setSinkTimer(self, duration, timestamp):
+        self.sendUpdate('setSinkTimer', [duration, timestamp])
+
+    def b_setSinkTimer(self, duration, timestamp=0):
+        # the client counts down from the timestamp (its target panel, and the
+        # captain's "Board?" panel)
+        if not timestamp:
+            timestamp = globalClockDelta.getRealNetworkTime(bits=16)
+
+        self.setSinkTimer(duration, timestamp)
+        self.d_setSinkTimer(duration, timestamp)
+
+    def getSinkTimer(self):
+        return self.sinkTimer
+
     def setLandedGrapples(self, landedGrapples):
         self.landedGrapples = landedGrapples
 
diff --git a/pirates/ship/GameFSMShipAI.py b/pirates/ship/GameFSMShipAI.py
index f34621f..46b3de9 100644

                 self.request('Sinking')
-            return Task.done
-        
+                return Task.done
+
+            if globalClock.getFrameTime() >= self._crippledDeadline:
+                ship.sinkFlagship('the %d s ran out' % timeout)
+                return Task.done
+
+            if ship.getBoarderShip() is None:
+                ship.sinkFlagship('pirate ship %s gone, sunk or empty' % ship._boarderShipId)

From a80155a60236dfad066ef2efe437f659b48c0eef Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:56:14 -0800
Subject: [PATCH 127/371] pirates: crippling a flagship no longer closes the
 pirate's game when the grapple targets come up, and barrels, ship flags, ship
 decor, the kraken, the radar and the bank no longer can either, as
 server-tree patch 0141 (8 client files)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/destructibles/DistributedBarrel.py | 2 +-
 pirates/flag/Flag.py                       | 8 ++++----
 pirates/kraken/Grabber.py                  | 2 +-
 pirates/kraken/TentacleUtils.py            | 2 +-
 pirates/piratesgui/RadarUtil.py            | 8 ++++----
 pirates/pvp/DistributedBank.py             | 2 +-
 pirates/ship/GameFSMShip.py                | 2 +-
 pirates/shipparts/ShipDecor.py             | 2 +-
 8 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/pirates/destructibles/DistributedBarrel.py b/pirates/destructibles/DistributedBarrel.py
index 67b8cb4..fa2a109 100644
--- a/pirates/destructibles/DistributedBarrel.py
+++ b/pirates/destructibles/DistributedBarrel.py
@@ -29,7 +29,7 @@ class DistributedBarrel(DistributedDestructibleObject.DistributedDestructibleObj
 
     def loadModel(self):
         self.prop = loader.loadModel('models/props/barrel')
-        self.coll = self.prop.findAllMatches('**/collision*').asList()
+        self.coll = list(self.prop.findAllMatches('**/collision*'))
         for c in self.coll:
             self.curMask = c.node().getIntoCollideMask()
             c.setCollideMask(PiratesGlobals.AmmoBitmask | self.curMask)

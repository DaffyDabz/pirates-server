diff --git a/pirates/ship/StarterWaters.py b/pirates/ship/StarterWaters.py
new file mode 100644
index 0000000..187dcfa
--- /dev/null
+++ b/pirates/ship/StarterWaters.py
@@ -0,0 +1,123 @@
+"""
+Starter waters (2026-11-17): the sea round the islands a new pirate sails from
+first (Port Royal and Tortuga). Enemy ships there stay at starter levels:
+
+- a regular enemy ship that spawns there is drawn only from the low-level
+  classes (level npcship-starter-level-max or lower; 12 = the Navy Ferret,
+  Bulwark and Panther, the EITC Sea Viper and the Navy Greyhound);
+- a flagship never spawns there (unless a test knob spawns it near an island);
+- a ship above starter level never picks a patrol, wander or flee point inside
+  those waters, or a straight course through them;
+- a starter ship that spawned there keeps its patrol points there.
+
+The open-source spawn code drew any of its 27 regular classes (levels 2-44)
+anywhere on the ocean and sent each ship to random points anywhere, so a new
+pirate leaving Port Royal met mostly level 16-44 ships (SMOKE-shipfight
+2026-11-17: 12 of 13 ships seen were level 18-32).
+
+Configs: npcship-starter-islands (island uids, space separated), npcship-
+starter-radius (feet from each island's centre; 0 turns the rule off),
+npcship-starter-level-max.
+"""
+import math
+
+from direct.directnotify import DirectNotifyGlobal
+
+from pirates.ship import ShipGlobals
+
+notify = DirectNotifyGlobal.directNotify.newCategory('StarterWaters')
+
+ISLANDS = config.GetString('npcship-starter-islands',
+                           '1150922126.8dzlu 1156207188.95dzlu').split()
+RADIUS = config.GetFloat('npcship-starter-radius', 9000.0)
+LEVEL_MAX = config.GetInt('npcship-starter-level-max', 12)
+
+_centers = None
+
+
+def enabled():
+    return RADIUS > 0 and bool(ISLANDS)
+
+
+def centers(air):
+    """(x, y) of each starter island that is generated here."""
+    global _centers
+    if _centers is not None:
+        return _centers
+    found = []
+    for uid in ISLANDS:
+        try:
+            t = air.uidMgr.justGetMeMeObject(uid).getIslandTransform()
+            found.append((float(t[0]), float(t[1])))
+        except Exception:
+            continue
+    if len(found) == len(ISLANDS):
+        _centers = found
+        notify.warning('TEMP-DIAG starter waters: %d islands at %s, radius %d, enemy ship level max %d'
+                       % (len(found), ', '.join('(%d, %d)' % c for c in found), RADIUS, LEVEL_MAX))
+    return found
+
+
+def classLevel(shipClass):
+    try:
+        return int(ShipGlobals.getShipLevel(shipClass) or 1)
+    except Exception:
+        return 1
+
+
+def isStarterClass(shipClass):
+    return classLevel(shipClass) <= LEVEL_MAX
+
+
+def starterClasses(classes):
+    return [c for c in classes if isStarterClass(c)]
+
+
+def inStarterWaters(air, x, y):
+    if not enabled():
+        return False
+    for cx, cy in centers(air):
+        if math.hypot(x - cx, y - cy) < RADIUS:
+            return True
+    return False
+
+
+def _segDist(px, py, x0, y0, x1, y1):
+    dx, dy = x1 - x0, y1 - y0
+    L = dx * dx + dy * dy
+    t = 0.0 if L <= 0 else max(0.0, min(1.0, ((px - x0) * dx + (py - y0) * dy) / L))
+    return math.hypot(px - (x0 + t * dx), py - (y0 + t * dy))
+
+
+def crossesStarterWaters(air, x0, y0, x1, y1):
+    if not enabled():
+        return False
+    for cx, cy in centers(air):
+        if _segDist(cx, cy, x0, y0, x1, y1) < RADIUS:
+            return True
+    return False
+
+
+def pointOkForShip(air, ship, x, y, fromXY=None, toXY=None):
+    """
+    May this ship sail to (x, y)? Always yes for a starter-level ship or a test
+    spawn. Otherwise the point must be outside starter waters, and so must the
+    straight course from fromXY (unless fromXY is itself inside, so a ship that
+    chased a player in can still leave) and on to toXY.
+    """
+    if not enabled() or getattr(ship, '_starterExempt', False):
+        return True
+    if getattr(ship, '_starterHome', False):
+        # a starter ship that spawned here patrols here, so the waters do not
+        # empty as ships wander off (only spawns would refill them)
+        return inStarterWaters(air, x, y)
+    if isStarterClass(getattr(ship, 'shipClass', 0)):
+        return True
+    if inStarterWaters(air, x, y):
+        return False
+    for other in (fromXY, toXY):
+        if other is None or inStarterWaters(air, other[0], other[1]):
+            continue
+        if crossesStarterWaters(air, other[0], other[1], x, y):
+            return False
+    return True

diff --git a/pirates/ship/ShipGlobals.py b/pirates/ship/ShipGlobals.py
index 987e686..d226fb1 100644
--- a/pirates/ship/ShipGlobals.py
+++ b/pirates/ship/ShipGlobals.py
@@ -6795,6 +6795,17 @@ def getRepairCost(ship, hull = None, cabin = None, masts = [], sails = [], prow
     return calcRepairCost(ship.maxHp, ship.Hp, ship.maxSp, ship.Sp, ship.modelClass)
 
 
+def getRepairPrice(cost, gold):
+    # family server (11-18): what a pirate pays for a ship repair. A pirate whose gold is below the price gets
+    # it free, so nobody is ever left without a ship that sails (a sunk ship with 4 gold against an 8 gold
+    # repair soft-locked the story, whose c3visitJack quest needs sailing). Everyone else pays the full price.
+    cost = int(cost)
+    if cost <= 0 or gold < cost:
+        return 0
+
+    return cost
+
+
 def calcRepairCost(maxHp, Hp, maxSp, Sp, modelClass):
     totalCost = 0
     totalCost += (maxHp - Hp) + (maxSp - Sp) / 2

diff --git a/pirates/ship/DistributedShipAI.py b/pirates/ship/DistributedShipAI.py
index 8a24477..f0c891f 100644
--- a/pirates/ship/DistributedShipAI.py
+++ b/pirates/ship/DistributedShipAI.py
@@ -1162,6 +1162,36 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
         self._leaveOceanGrid()
         self.b_setLocation(self.parentId, 0)
         self.notify.warning('sunk ship %s: put away sunk, a shipwright can repair it' % self.doId)
+        # an owner who cannot pay the shipwright gets it mended now, so the dinghy can launch it again
+        self.mendFreeIfOwnerCannotPay('sank')
+
+    def mendFreeIfOwnerCannotPay(self, why):
+        # family server (11-18): a sunk ship whose owner's gold is below the repair price
+        # (ShipGlobals.getRepairPrice) is mended free, the way the shipwright mends it. True when it was.
+        if self.hp > 0:
+            return False
+
+        ownerId = self.getOwnerId()
+        inventory = self.air.inventoryManager.getInventory(ownerId) if ownerId else None
+        if inventory is None:
+            # owner not on this district: his next visit to a shipwright mends it free instead
+            return False
+
+        cost = ShipGlobals.calcRepairCost(self.maxHp, self.hp, self.maxSp, self.sp,
+            ShipGlobals.getModelClass(self.shipClass))
+        gold = inventory.getGoldInPocket()
+        if ShipGlobals.getRepairPrice(cost, gold):
+            return False
+
+        self.shipwrightRepaired()
+        self.air.writeServerEvent('ship-repair-free', shipId=self.doId, avatarId=ownerId, cost=cost, gold=gold, why=why)
+        self.notify.info('sunk ship %s mended free (%s): owner %d has %d gold, repair costs %d' % (
+            self.doId, why, ownerId, gold, cost))
+        owner = self.air.doId2do.get(ownerId)
+        if owner is not None and hasattr(owner, 'd_setSystemMessage'):
+            owner.d_setSystemMessage(0, 'Your ship sank, and the shipwright mended it for free. It is ready to sail again!')
+
+        return True
 
     def shipwrightRepaired(self):
         # the shipwright's repair on a ship the AI holds: hull, sails and every part
@@ -1547,12 +1577,13 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
                 return
 
             gold = inventory.getGoldInPocket()
-            if gold < cost:
-                self.notify.debug('Avatar %d cannot afford to repair ship %d; cost=%d gold=%d' % (
+            # family server (11-18): a pirate who cannot pay gets the repair free
+            price = ShipGlobals.getRepairPrice(cost, gold)
+            if price < cost:
+                self.notify.info('Avatar %d repairs ship %d free; cost=%d gold=%d' % (
                     avatar.doId, self.doId, cost, gold))
 
-                return
-

From 580397d4307ea581c43e29b81cdebe34630b2fdc Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Wed, 18 Nov 2026 08:39:38 -0800
Subject: [PATCH 148/371] pirates: no mercenary-job kick for pirates at levels
 44-50 (0170)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/quest/QuestTaskDNA.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/pirates/quest/QuestTaskDNA.py b/pirates/quest/QuestTaskDNA.py
index 08b5008..f8a1b50 100644
--- a/pirates/quest/QuestTaskDNA.py
+++ b/pirates/quest/QuestTaskDNA.py
@@ -2435,7 +2435,13 @@ class RandomizedDefeatTaskDNA(DefeatTaskDNA):
 
     def getInitialTaskState(self, holder):
         state = DefeatTaskDNA.getInitialTaskState(self, holder)
-        (enemyType, num) = EnemyGlobals.getRandomEncounter(holder.getLevel())
+        level = holder.getLevel()
+        (enemyType, num) = EnemyGlobals.getRandomEncounter(level)
+        while not enemyType and level > 1:
+            # no enemy averages within 6 levels of a level 44-50 pirate; the empty roll (0, 0) made the
+            # offer unpackable and kicked the pirate, so roll for the nearest lower level that has enemies
+            level -= 1
+            (enemyType, num) = EnemyGlobals.getRandomEncounter(level)
         state.setEnemyType(enemyType)
         state.setGoal(num)
         return state
-- 

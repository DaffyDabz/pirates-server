From c0df9520b70528563955eea727b9eb1fbf75ca0d Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Wed, 18 Nov 2026 08:39:38 -0800
Subject: [PATCH 149/371] pirates: quest givers never offer Ship PvP quests
 (0171)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/quest/DistributedQuestGiverAI.py | 34 ++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/pirates/quest/DistributedQuestGiverAI.py b/pirates/quest/DistributedQuestGiverAI.py
index c3b6a4b..2d667a6 100644
--- a/pirates/quest/DistributedQuestGiverAI.py
+++ b/pirates/quest/DistributedQuestGiverAI.py
@@ -18,6 +18,37 @@ def _getLadderMaps():
     return _questDependency, _questDynMap
 
 
+_shipPvpQuestIds = None
+
+
+def _getShipPvpQuestIds():
+    # family server (2026-11-18): Ship PvP steps (ShipPVPDefeat) count kills in Ship PvP games, which this
+    # server does not run, so they never progress. Every quest of a ladder that holds one is left out of the
+    # offers (the Ship PvP bread crumb at O'Malley, Darby Drydock, Balthasar, and the Garcia / Pierre ladders).
+    global _shipPvpQuestIds
+    if _shipPvpQuestIds is None:
+        from pirates.quest import QuestLadderDB
+        from pirates.quest.QuestTaskDNA import ShipPVPDefeatTaskDNA
+
+        def questIds(c, out):
+            if type(c).__name__ == 'QuestDNA':
+                out.append(c.getQuestId())
+                return out
+            for k in c.containers:
+                questIds(k, out)
+            return out
+
+        pvp = set(qid for qid, dna in QuestDB.QuestDict.items()
+                  if any(isinstance(t, ShipPVPDefeatTaskDNA) for t in dna.getTaskDNAs()))
+        for ladderDict in (QuestLadderDB.FameQuestLadderDict, QuestLadderDB.FortuneQuestLadderDict):
+            for ladder in ladderDict.values():
+                ids = questIds(ladder, [])
+                if pvp.intersection(ids):
+                    pvp.update(ids)
+        _shipPvpQuestIds = pvp
+    return _shipPvpQuestIds
+
+
 class DistributedQuestGiverAI(DistributedObjectAI):
     notify = DirectNotifyGlobal.directNotify.newCategory('DistributedQuestGiverAI')
 
@@ -36,9 +67,12 @@ class DistributedQuestGiverAI(DistributedObjectAI):
         ladderHistory = avatar.getQuestLadderHistory()
         heldIds = [q.getQuestId() for q in inventory.getQuestList()]
         offers = []
+        shipPvp = _getShipPvpQuestIds()
         for questId, questDNA in list(QuestDB.QuestDict.items()):
             if questId in heldIds or avatar.questStatus.hasLadderQuestId(questId):
                 continue
+            if questId in shipPvp:
+                continue
             weapCheck = questDNA.weapLvlType != None and questDNA.minWeapLevel > 0
             for prereq in questDNA.getPrereqs():
                 if not (prereq.giverMatters() and prereq.giverCanGive(giverId)):

From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:07:25 -0800
Subject: [PATCH 152/371] pirates: a new pirate in the starter waters is fought
 by one enemy ship at a time, not a gang of Ferrets, server-tree patch 0166

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/GameFSMShipAI.py | 11 ++++-
 pirates/ship/ShipManagerAI.py | 16 +++++++
 pirates/ship/StarterWaters.py | 78 ++++++++++++++++++++++++++++++++++-
 3 files changed, 102 insertions(+), 3 deletions(-)

diff --git a/pirates/ship/GameFSMShipAI.py b/pirates/ship/GameFSMShipAI.py
index a30f47d..cb1a7af 100644
--- a/pirates/ship/GameFSMShipAI.py
+++ b/pirates/ship/GameFSMShipAI.py
@@ -985,9 +985,16 @@ class GameFSMShipAI(FSM.FSM):
         return True
 
     def _starterTargetOk(self, target):
-        """May this ship engage target where it is (StarterWaters.targetOkForShip)?"""
+        """May this ship engage target where it is (StarterWaters.targetOkForShip),
+        and is there room on it (patch 0166: one enemy ship at a time on a pirate
+        in starter waters, StarterWaters.attackerOk)?"""
         try:
-            return StarterWaters.targetOkForShip(self.air, self.ship, target.getX(), target.getY())
+            if not StarterWaters.targetOkForShip(self.air, self.ship, target.getX(), target.getY()):
+                return False
+        except Exception:
+            return True
+        try:
+            return StarterWaters.attackerOk(self.air, self, target)
         except Exception:
             return True
 

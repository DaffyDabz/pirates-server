+    def _splitPot(self, scores):
+        # scores: live seat -> hand score. Each layer of the pot, up to what an
+        # all-in seat put in, goes to the best hand among the seats that put in that
+        # much; a tie splits it (the odd coin to the lowest seat). A layer only one
+        # seat paid into (a bet nobody called) goes back to him.
+        # Returns (won, back): gold won, and gold handed back, per live seat.
+        won = dict((s, 0) for s in scores)
+        back = dict((s, 0) for s in scores)
+        contrib = self._contrib
+        prev = 0
+        paidOut = 0
+        top = []
+        for level in sorted(set(contrib.get(s, 0) for s in scores)):
+            if level <= prev:
+                continue
+            amount = 0
+            payers = 0
+            for c in contrib.values():
+                part = max(0, min(c, level) - prev)
+                amount += part
+                if part > 0:
+                    payers += 1
+            contenders = [s for s in scores if contrib.get(s, 0) >= level]
+            if payers > 1:
+                best = max(scores[s] for s in contenders)
+                top = sorted(s for s in contenders if scores[s] == best)
+                share, odd = divmod(amount, len(top))
+                for s in top:
+                    won[s] += share
+                won[top[0]] += odd
+            else:
+                back[contenders[0]] += amount
+            paidOut += amount
+            prev = level
+        rest = self.potSize - paidOut
+        if rest > 0:
+            # Gold put in above every live seat's stake (by players who left or folded)
+            if not top:
+                best = max(scores.values())
+                top = sorted(s for s in scores if scores[s] == best)
+            won[top[0]] += rest
+        return won, back
+
+    def _payoutWinners(self, won, back):
+        for s in sorted(won):
+            gain = won[s] + back.get(s, 0)
+            seat = self.seats[s]
+            if seat and seat not in (0, 1):
+                inv = self.air.inventoryManager.getInventory(seat.doId)
+                if inv:
+                    # setGoldInPocket, not addGoldInPocket: the stake already left his
+                    # pocket, and addGoldInPocket would double it on a gold holiday.
+                    if gain:
+                        inv.setGoldInPocket(inv.getGoldInPocket() + gain)
+                    if won[s] > self._contrib.get(s, 0):
+                        # A real win (more back than he put in): quest hook and reputation
+                        if hasattr(self.air, 'questMgr'):
+                            self.air.questMgr.pokerHandWon(seat, won[s])
+                        current = dict(inv.getAccumulators()).get(InventoryType.PokerGame, 0)
+                        inv.b_setAccumulator(InventoryType.PokerGame,
+                            min(current + won[s], 9999))
+            elif seat == 1:
+                # AI winners keep chips on the table stack.
+                self._chipsCount = self._normalizeChipsCount(self._chipsCount)
+                self._chipsCount[s] += gain
+            self._totalWinnings[s] = won[s] if won[s] > 0 else PlayingCardGlobals.PlayerLost
 
         # Human stacks always mirror the gold in their pocket
         self._chipsCount = self._normalizeChipsCount(self._chipsCount)

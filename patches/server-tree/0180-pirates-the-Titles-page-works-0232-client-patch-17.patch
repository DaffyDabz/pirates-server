         print('Land', self.panelIndex, ' is ', self.landActive)
@@ -121,6 +134,9 @@ class TitlePanel(DirectFrame):
             self.titlesPage.setLandActive(self.panelIndex, self.landActive)
 
     def seaToggle(self, notifyParent = 1):
+        if notifyParent and not self.seaActive and self.rank < 1:
+            return  # family server (0232): nothing to show until he earns rank 1
+
         print('Toggling sea')
         self.seaActive = 1 - self.seaActive
         print('Sea ', self.seaActive)
@@ -182,7 +198,17 @@ class TitlesPage(InventoryPage.InventoryPage):
         self.titles = None
         InventoryPage.InventoryPage.destroy(self)
 
+    def refresh(self):
+        # family server (0232): GuiManager.showTitlesPanel (the B key) calls this; it was missing
+        for panel in self.titles or []:
+            panel.refresh()
+
     def show(self):
+        # family server (0232): switch on the badges he has saved
+        badge = getattr(localAvatar, 'badge', None)
+        self.initLandTitleActive(badge[0] if badge else -1)
+        shipBadge = getattr(localAvatar, 'shipBadge', None)
+        self.initSeaTitleActive(shipBadge[0] if shipBadge else -1)
         for panel in self.titles:
             panel.refresh()
         
@@ -235,17 +261,34 @@ class TitlesPage(InventoryPage.InventoryPage):
             
             self.selectedSeaIndex = panelIndex
 
+        # family server (0232): the sea badge is sent too (it flies on his ship)
+        if self.selectedSeaIndex < 0:
+            localAvatar.sendRequestSetShipBadgeIcon(-1, -1)
+        else:
+            titlePanel = self.titles[self.selectedSeaIndex]
+            localAvatar.sendRequestSetShipBadgeIcon(titlePanel.titleId, titlePanel.rank)
+
     def initLandTitleActive(self, titleId):
-        if titleId < 0:
-            return
-        
-        if self.selectedLandIndex >= 0:
-            return
-        
-        for panel in self.titles:
-            if panel.titleId == titleId:
-                if not panel.landActive:
-                    panel.landToggle()
-        
+        # family server (0232): the server says which badge is saved (after every
+        # request too, so a refused one is switched back off); match the page to it
+        self.selectedLandIndex = self.syncActive(titleId, 'landActive', 'landButton')
+
+    def initSeaTitleActive(self, titleId):
+        # family server (0232): LocalPirate.setShipBadgeIcon calls this; it was missing
+        self.selectedSeaIndex = self.syncActive(titleId, 'seaActive', 'seaButton')
+
+    def syncActive(self, titleId, activeName, buttonName):
+        selected = -1
+        for index, panel in enumerate(self.titles or []):
+            active = int(titleId > 0 and panel.titleId == titleId)
+            setattr(panel, activeName, active)
+            button = getattr(panel, buttonName, None)
+            if button:
+                button['image'] = [
+                    panel.iconInvisible,
+                    panel.iconVisible][active]
 
+            if active:
+                selected = index
 
+        return selected

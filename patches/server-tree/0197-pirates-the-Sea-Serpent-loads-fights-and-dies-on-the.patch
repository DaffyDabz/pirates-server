+        return Sequence(Wait(0.5), Parallel(Func(playSfx), Sequence(self.actorInterval(animName, blendOutT = 0.0), Func(self.disableMixing), Func(self.pose, animName, frames - 1, blendT = 0.0)), Sequence(Wait(duration / 3.0), Func(self.setTransparency, 1), LerpColorScaleInterval(self, duration / 4.0, Vec4(0.55, 0.7, 0.2, 1.0), startColorScale = Vec4(1)), Wait(duration / 3.0), Func(startVFX), LerpColorScaleInterval(self, 0.5, Vec4(0.0, 0.0, 0.0, 0.0), startColorScale = Vec4(0.55, 0.7, 0.2, 1.0)), Func(self.hide), Func(self.clearTransparency), Func(self.clearColorScale)), Func(self._noInteract)))
 
     def getExitDeathTrack(self):
         return Sequence(Func(self.show))
 
+    # DistributedCreature calls these on its creature; the 2008 sea monsters never had them (patch 0222)
+    def _noInteract(self):
+        if hasattr(self, 'setAllowInteract'):
+            self.setAllowInteract(False)
+
+    def setLevel(self, level):
+        self.level = level
+
+    def getLevel(self):
+        return self.level
+
+    def getSfx(self, name):
+        return self.sfx.get(name)
+
+    def getNameText(self):
+        return self.nameText
+
     def getAnimInfo(self, state):
         return self.animInfo.get(state, self.FailsafeAnims)
 

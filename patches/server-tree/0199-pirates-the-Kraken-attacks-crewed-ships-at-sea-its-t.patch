new file mode 100644
index 0000000..e38a475
--- /dev/null
+++ b/pirates/kraken/KrakenManagerAI.py
@@ -0,0 +1,121 @@
+"""
+Sends the Kraken after pirate ships out in the deep water (patch 0221, 2026-11-18).
+
+Every kraken-check-period seconds (60) each crewed pirate ship that is sailing
+outside the starter waters has a kraken-chance (0.15) of being attacked, at most
+kraken-max (2) Krakens at once in the world, and a ship that just met one is
+left alone for kraken-cooldown seconds (900). want-kraken 0 turns it all off.
+"""
+import random
+
+from direct.directnotify import DirectNotifyGlobal
+
+from pirates.kraken.KrakenAI import KrakenAI, whyNotTarget, _knob
+
+
+class KrakenManagerAI:
+    notify = DirectNotifyGlobal.directNotify.newCategory('KrakenManagerAI')
+
+    TASK_NAME = 'kraken-manager-upkeep'
+
+    def __init__(self, air, shipManager=None):
+        self.air = air
+        self.shipManager = shipManager
+        self.krakens = {}
+        self.lastAttack = {}
+        self.random = random.Random()
+
+    @staticmethod
+    def wantKraken():
+        return _knob('bool', 'want-kraken', True)
+
+    @staticmethod
+    def checkPeriod():
+        return max(5.0, _knob('float', 'kraken-check-period', 60.0))
+
+    @staticmethod
+    def chance():
+        return min(1.0, max(0.0, _knob('float', 'kraken-chance', 0.15)))
+
+    @staticmethod
+    def maxKrakens():
+        return max(0, _knob('int', 'kraken-max', 2))
+
+    @staticmethod
+    def cooldown():
+        return max(0.0, _knob('float', 'kraken-cooldown', 900.0))
+
+    def start(self):
+        if not self.wantKraken():
+            self.notify.info('want-kraken is off')
+            return
+        taskMgr.doMethodLater(self.checkPeriod(), self.__upkeep, self.TASK_NAME)
+
+    def stop(self):
+        taskMgr.remove(self.TASK_NAME)
+        for kraken in list(self.krakens.values()):
+            kraken.finish('stopped')
+
+    def candidateShips(self):
+        ships = []
+        if self.shipManager is not None and hasattr(self.shipManager, 'getPlayerShips'):
+            ships = list(self.shipManager.getPlayerShips())
+        if not ships:
+            from pirates.ship.DistributedShipAI import DistributedShipAI
+            ships = [do for do in list(self.air.doId2do.values()) if isinstance(do, DistributedShipAI)]
+        return ships
+
+    def whyNot(self, ship, now=None, ignoreStarterWaters=False, ignoreCooldown=False):
+        why = whyNotTarget(self.air, ship, ignoreStarterWaters)
+        if why:
+            return why
+        if len(self.krakens) >= self.maxKrakens():
+            return 'already %d Krakens out' % len(self.krakens)
+        if not ignoreCooldown:
+            now = globalClock.getFrameTime() if now is None else now
+            last = self.lastAttack.get(ship.doId)
+            if last is not None and now - last < self.cooldown():
+                return 'met a Kraken %d s ago' % int(now - last)
+        return ''
+
+    def __upkeep(self, task):
+        try:
+            self.upkeep()
+        except Exception as e:
+            self.notify.warning('Kraken upkeep failed: %r' % (e,))
+        task.delayTime = self.checkPeriod()
+        return task.again
+
+    def upkeep(self):
+        if not self.wantKraken():
+            return []
+        started = []
+        now = globalClock.getFrameTime()
+        for ship in self.candidateShips():
+            if self.whyNot(ship, now):
+                continue
+            if self.random.random() >= self.chance():
+                continue
+            if self.attack(ship):
+                started.append(ship.doId)
+        return started
+
+    def attack(self, ship):
+        kraken = KrakenAI(self.air)
+        kraken.onDone = self.__krakenDone
+        if not kraken.attackShip(ship):
+            return None
+        self.krakens[kraken.doId] = kraken
+        self.lastAttack[ship.doId] = globalClock.getFrameTime()
+        return kraken
+
+    def __krakenDone(self, kraken):
+        self.krakens.pop(kraken.doId, None)
+        self.lastAttack[kraken.shipId] = globalClock.getFrameTime()
+
+    def summon(self, ship):
+        """The ~kraken magic word: skips the chance, the cooldown and the starter waters rule."""
+        why = self.whyNot(ship, ignoreStarterWaters=True, ignoreCooldown=True)
+        if why:
+            return None, why
+        return self.attack(ship), ''

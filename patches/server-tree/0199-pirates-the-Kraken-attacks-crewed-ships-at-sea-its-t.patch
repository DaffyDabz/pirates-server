index d306845..fd7d8e1 100644
--- a/pirates/ai/PiratesMagicWordManagerAI.py
+++ b/pirates/ai/PiratesMagicWordManagerAI.py
@@ -186,6 +186,55 @@ def bpdestroy(barricadeId=0):
     return "Destroyed barricade %d" % barricadeId
 
 
+@magicWord(category=CATEGORY_SYSTEM_ADMIN, types=[str])
+def kraken(what='attack'):
+    """
+    The Kraken (patch 0221): 'attack' sends one at the ship you are on now (even in the starter waters),
+    'why' says whether it may attack your ship by itself, 'beat' knocks every tentacle down, 'off' sends it away.
+    """
+    invoker = spellbook.getInvoker()
+    air = spellbook.getManager().air
+    shipMgr = getattr(air, 'shipManager', None)
+    krakenMgr = getattr(shipMgr, 'krakenMgr', None)
+    if krakenMgr is None:
+        from pirates.kraken.KrakenManagerAI import KrakenManagerAI
+        krakenMgr = KrakenManagerAI(air, shipMgr)
+        if shipMgr is not None:
+            shipMgr.krakenMgr = krakenMgr
+
+    from pirates.ship.DistributedShipAI import DistributedShipAI
+    ship = None
+    for shipId in (getattr(invoker, 'getActiveShipId', lambda: 0)(), getattr(invoker, 'getCrewShipId', lambda: 0)(),
+                   getattr(invoker, 'parentId', 0)):
+        obj = air.doId2do.get(shipId)
+        if isinstance(obj, DistributedShipAI):
+            ship = obj
+            break
+    if ship is None:
+        return "You are not on a ship"
+
+    if what == 'why':
+        return "Kraken on ship %d: %s" % (ship.doId, krakenMgr.whyNot(ship) or 'it may attack now')
+    if what in ('beat', 'off'):
+        kraken = getattr(ship, 'kraken', None)
+        if kraken is None:
+            return "No Kraken on ship %d" % ship.doId
+        if what == 'off':
+            kraken.finish('magic word')
+            return "The Kraken leaves ship %d" % ship.doId
+        tentacles = kraken.livingTentacles()
+        for tentacle in tentacles:
+            tentacle.b_setHp(0)
+        return "Knocked down %d tentacles" % len(tentacles)
+    if what != 'attack':
+        return "Valid: attack, why, beat, off"
+
+    kraken, why = krakenMgr.summon(ship)
+    if kraken is None:
+        return "No Kraken: %s" % why
+    return "The Kraken attacks ship %d with %d tentacles" % (ship.doId, len(kraken.tentacles))
+
+

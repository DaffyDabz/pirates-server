@@ -1,8 +1,336 @@
+"""
+The Kraken (patch 0221, 2026-11-18). The 2008 game shipped the art and a client
+prototype but no server side; this is a kid-friendly first version.
+
+One Kraken attacks one pirate ship out in the deep water (never in the starter
+waters round Port Royal and Tortuga):
+
+- it rises as 4 or 6 grabber tentacles round the hull (one per side for each
+  entry in ShipGlobals.KrakenLocators; only the ship classes in that table);
+- every few seconds each tentacle still up squeezes the hull for a small
+  share of its max hull points, so a ship that does nothing sinks in about
+  four minutes, and the client plays the old Kraken sink cutscene;
+- the crew beats it with the cannons (or guns and swords): each tentacle has
+  a fixed, small health bar, a cannonball always takes the same bite;
+- when the last tentacle goes down every pirate aboard gets gold and the hold
+  gets a chest and a royal chest (the loot pop-up shows them);
+- the tentacles never grab a pirate or a mast in this version;
+- it gives up and sinks back after a time limit, and goes away if the ship
+  sinks, docks or is put away.
+
+Every number is a config knob (see KrakenKnobs below).
+"""
 from direct.distributed.DistributedObjectAI import DistributedObjectAI
 from direct.directnotify import DirectNotifyGlobal
 
+from pirates.piratesbase import PiratesGlobals
+from pirates.ship import ShipGlobals
+
+
+def _knob(kind, name, default):
+    try:
+        cfg = config
+    except NameError:
+        return default
+    try:
+        if kind == 'bool':
+            return bool(cfg.GetBool(name, default))
+        if kind == 'int':
+            return int(cfg.GetInt(name, default))
+        return float(cfg.GetFloat(name, default))
+    except Exception:
+        return default
+
+
+class KrakenKnobs:
+    # read on use, so a test or a magic word sees the current value
+    @staticmethod
+    def tentacleHp():
+        return max(1, _knob('int', 'kraken-tentacle-hp', 400))
+
+    @staticmethod
+    def tentacleLevel():
+        return max(1, _knob('int', 'kraken-tentacle-level', 10))
+
+    @staticmethod
+    def cannonDamage():
+        return max(0, _knob('int', 'kraken-cannon-damage', 100))
+
+    @staticmethod
+    def weaponDamage():
+        return max(0, _knob('int', 'kraken-weapon-damage', 25))
+
+    @staticmethod
+    def squeezePercent():
+        # share of the ship's max hull points one tentacle takes per squeeze
+        return max(0.0, _knob('float', 'kraken-tentacle-damage-percent', 0.5))
+
+    @staticmethod
+    def squeezePeriod():
+        return max(1.0, _knob('float', 'kraken-attack-period', 5.0))
+
+    @staticmethod
+    def emergeDelay():
+        return max(0.0, _knob('float', 'kraken-emerge-delay', 3.0))
+
+    @staticmethod
+    def timeLimit():
+        return max(10.0, _knob('float', 'kraken-time-limit', 300.0))
+
+    @staticmethod
+    def hullFloorPercent():
+        # 0: the Kraken can sink the ship; 25: it never takes the hull below a quarter
+        return min(100.0, max(0.0, _knob('float', 'kraken-hull-floor-percent', 0.0)))
+
+    @staticmethod
+    def gold():
+        return max(0, _knob('int', 'kraken-gold', 500))
+
+    @staticmethod
+    def sinkLinger():
+        # the client's sink cutscene (doom tentacle) needs the Kraken object for about 10 s
+        return max(0.0, _knob('float', 'kraken-sink-linger', 15.0))
+
+    @staticmethod
+    def cleanupDelay():
+        return max(0.0, _knob('float', 'kraken-cleanup-delay', 4.0))
+
+
+KRAKEN_SHIP_STATES_BLOCKED = ('Off', 'Spawn', 'Docked', 'Sinking', 'Sunk', 'PutAway', 'RecoverFromSunk',
+                              'InBoardingPosition', 'WaitingForGrapple', 'GrappleLerping', 'InPosition',
+                              'Boarded', 'Defeated', 'Parley')
+
+
+def tentacleCount(shipClass):
+    return 2 * len(ShipGlobals.KrakenLocators.get(shipClass, ()))
+
+
+def whyNotTarget(air, ship, ignoreStarterWaters=False):
+    """'' when a Kraken may attack this ship now, else the reason it may not."""
+    if ship is None or getattr(ship, 'air', None) is None:
+        return 'no ship'
+    if getattr(ship, 'npcShip', 0):
+        return 'an enemy ship'
+    if not tentacleCount(ship.getShipClass()):
+        return 'ship class %s has no Kraken locators' % ship.getShipClass()
+    if getattr(ship, 'kraken', None) is not None:
+        return 'already has a Kraken'
+    afloat = getattr(ship, '_isAfloat', None)
+    if afloat is not None and not afloat():
+        return 'not afloat'
+    state = (getattr(ship, 'gameState', None) or ['Off'])[0]
+    if state in KRAKEN_SHIP_STATES_BLOCKED:
+        return 'ship state %s' % state
+    if not ship.getPiratesAboard():
+        return 'nobody aboard'
+    if not ignoreStarterWaters:
+        from pirates.ship import StarterWaters
+        if StarterWaters.inStarterWaters(air, ship.getX(), ship.getY()):
+            return 'in the starter waters'
+    return ''
+
+
 class KrakenAI(DistributedObjectAI):
     notify = DirectNotifyGlobal.directNotify.newCategory('KrakenAI')
 
     def __init__(self, air):
-        DistributedObjectAI.__init__(self, air)
\ No newline at end of file
+        DistributedObjectAI.__init__(self, air)
+        self.shipId = 0
+        self.tentacles = {}
+        self.state = 'Off'
+        self.startTime = 0.0
+        self.attackers = set()
+        self.squeezeTotal = 0
+        self.onDone = None
+
+    # ---- dc fields
+    def setShipId(self, shipId):
+        self.shipId = shipId
+
+    def d_setShipId(self, shipId):
+        self.sendUpdate('setShipId', [shipId])
+
+    def b_setShipId(self, shipId):
+        self.setShipId(shipId)
+        self.d_setShipId(shipId)
+
+    def getShipId(self):
+        return self.shipId
+
+    def getShip(self):
+        if self.air is None:
+            return None
+        return self.air.doId2do.get(self.shipId)
+
+    # ---- life
+    def attackShip(self, ship):
+        """Generate this Kraken on the ship and raise its tentacles. Returns True when it started."""
+        from pirates.kraken.GrabberTentacleAI import GrabberTentacleAI
+        self.setShipId(ship.doId)
+        ship.generateChildWithRequired(self, PiratesGlobals.ShipZoneSilhouette)
+        ship.kraken = self
+        self.startTime = globalClock.getFrameTime()
+        self.state = 'Rising'
+        for locatorId in range(tentacleCount(ship.getShipClass())):
+            tentacle = GrabberTentacleAI(self.air)
+            tentacle.setupTentacle(self, locatorId)
+            ship.generateChildWithRequired(tentacle, PiratesGlobals.ShipZoneSilhouette)
+            tentacle.b_setGameState('Idle')
+            self.tentacles[locatorId] = tentacle
+
+        self._tellCrew(ship, 'The Kraken is attacking! Shoot its tentacles with the cannons!')
+        taskMgr.doMethodLater(KrakenKnobs.emergeDelay(), self._emerge, self.uniqueName('kraken-emerge'))
+        self.notify.info('Kraken %s attacks ship %s (class %s) with %d tentacles' % (
+            self.doId, ship.doId, ship.getShipClass(), len(self.tentacles)))
+        return True
+
+    def _emerge(self, task):
+        for tentacle in self.livingTentacles():
+            tentacle.b_emerge(1)
+        self.state = 'Attacking'
+        taskMgr.doMethodLater(KrakenKnobs.squeezePeriod(), self._squeeze, self.uniqueName('kraken-squeeze'))
+        return task.done
+
+    def livingTentacles(self):
+        return [t for t in self.tentacles.values() if t is not None and t.isAlive()]
+
+    def _squeeze(self, task):
+        if self.state != 'Attacking':
+            return task.done
+        try:
+            ship = self.getShip()
+            why = self._shipGoneReason(ship)
+            if why:
+                self.finish(why)
+                return task.done
+
+            if globalClock.getFrameTime() - self.startTime >= KrakenKnobs.timeLimit():
+                self._tellCrew(ship, 'The Kraken gives up and sinks back into the deep.')
+                self.finish('time limit')
+                return task.done
+
+            squeezers = [t for t in self.livingTentacles() if t.emerged]
+            maxHp = max(1, int(ship.getMaxHp() or 1))
+            bite = max(1, int(round(maxHp * KrakenKnobs.squeezePercent() / 100.0)))
+            damage = bite * len(squeezers)
+            floor = int(maxHp * KrakenKnobs.hullFloorPercent() / 100.0)
+            hp = int(ship.getHp() or 0)
+            newHp = max(floor, hp - damage) if hp > floor else hp
+            if damage and newHp != hp:
+                self.squeezeTotal += hp - newHp
+                ship.b_setHp(newHp)   # 0 sinks the ship; the next squeeze sees it and lingers for the cutscene
+        except Exception as e:
+            self.notify.warning('Kraken %s squeeze failed: %r' % (self.doId, e))
+            self.finish('error')
+            return task.done
+
+        task.delayTime = KrakenKnobs.squeezePeriod()
+        return task.again
+
+    def _shipGoneReason(self, ship):
+        if ship is None or getattr(ship, 'air', None) is None:
+            return 'ship gone'
+        afloat = getattr(ship, '_isAfloat', None)
+        if afloat is not None and not afloat():
+            return 'ship sunk'
+        state = (getattr(ship, 'gameState', None) or ['Off'])[0]
+        if state in ('Docked', 'PutAway', 'Off'):
+            return 'ship left'
+        return ''
+
+    def tentacleHit(self, tentacle, avatar):
+        if avatar is not None:
+            self.attackers.add(avatar.doId)
+
+    def tentacleDied(self, tentacle):
+        if self.state not in ('Rising', 'Attacking'):
+            return
+        if self.livingTentacles():
+            return
+        ship = self.getShip()
+        if ship is not None and not self._shipGoneReason(ship):
+            self._reward(ship)
+        self.finish('beaten')
+
+    def _reward(self, ship):
+        from pirates.economy.EconomyGlobals import ItemId
+        gold = KrakenKnobs.gold()
+        paid = []
+        pirates = {av.doId: av for av in ship.getPiratesAboard()}
+        for avId in self.attackers:
+            av = self.air.doId2do.get(avId)
+            if av is not None and avId not in pirates and hasattr(av, 'getInventory'):
+                pirates[avId] = av
+        for avId, av in pirates.items():
+            try:
+                inventory = av.getInventory()
+                if inventory is not None and gold:
+                    inventory.addGoldInPocket(gold)
+                paid.append(avId)
+            except Exception as e:
+                self.notify.warning('Kraken %s: could not pay %s: %r' % (self.doId, avId, e))
+        try:
+            if hasattr(ship, 'addPlunder'):
+                ship.addPlunder([ItemId.CARGO_CHEST, ItemId.CARGO_SKCHEST])
+        except Exception as e:
+            self.notify.warning('Kraken %s: no plunder for ship %s: %r' % (self.doId, ship.doId, e))
+        self._tellCrew(ship, 'You beat the Kraken! %d gold each, and a treasure chest in the hold!' % gold)
+        self.notify.info('Kraken %s beaten on ship %s: %d gold to %s' % (self.doId, ship.doId, gold, sorted(paid)))
+        self.rewarded = paid
+
+    def _tellCrew(self, ship, text):
+        try:
+            for av in ship.getPiratesAboard():
+                if hasattr(av, 'd_setSystemMessage'):
+                    av.d_setSystemMessage(0, text)
+        except Exception:
+            pass
+
+    def finish(self, reason):
+        if self.state in ('Leaving', 'Off'):
+            return
+        self.notify.info('Kraken %s on ship %s ends: %s (hull taken %d)' % (self.doId, self.shipId, reason, self.squeezeTotal))
+        self.state = 'Leaving'
+        self.endReason = reason
+        taskMgr.remove(self.uniqueName('kraken-emerge'))
+        taskMgr.remove(self.uniqueName('kraken-squeeze'))
+        if reason == 'ship sunk':
+            delay = KrakenKnobs.sinkLinger()
+        else:
+            delay = KrakenKnobs.cleanupDelay()
+            for tentacle in self.livingTentacles():
+                tentacle.b_emerge(0)
+        if reason == 'ship gone':
+            delay = 0.0
+        taskMgr.doMethodLater(delay, self._cleanup, self.uniqueName('kraken-cleanup'))
+
+    def _cleanup(self, task=None):
+        for locatorId, tentacle in list(self.tentacles.items()):
+            if tentacle is not None and tentacle.air is not None:
+                tentacle.requestDelete()
+        self.tentacles = {}
+        ship = self.getShip()
+        if ship is not None and getattr(ship, 'kraken', None) is self:
+            ship.kraken = None
+        self.state = 'Off'
+        if self.onDone is not None:
+            onDone, self.onDone = self.onDone, None
+            onDone(self)
+        if self.air is not None:
+            self.requestDelete()
+        return None if task is None else task.done
+
+    def delete(self):
+        taskMgr.remove(self.uniqueName('kraken-emerge'))
+        taskMgr.remove(self.uniqueName('kraken-squeeze'))
+        taskMgr.remove(self.uniqueName('kraken-cleanup'))
+        if self.state != 'Off':
+            self.state = 'Off'
+            ship = self.getShip()
+            if ship is not None and getattr(ship, 'kraken', None) is self:
+                ship.kraken = None
+            if self.onDone is not None:
+                onDone, self.onDone = self.onDone, None
+                onDone(self)
+        self.tentacles = {}
+        DistributedObjectAI.delete(self)

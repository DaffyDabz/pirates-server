+    # ---- life
+    def attackShip(self, ship, side=1):
+        """Generate this serpent beside the ship, under water. Returns True when it started."""
+        self.setupSerpent(ship, side)
+        ship.generateChildWithRequired(self, PiratesGlobals.ShipZoneSilhouette)
+        ship.serpent = self
+        self.startTime = globalClock.getFrameTime()
+        self.phase = 'Rising'
+        self.b_setGameState('Off')
+        self._tellCrew(ship, 'A Sea Serpent is coming! Shoot it with the cannons when it rises!')
+        self._later(SerpentKnobs.emergeDelay(), self._emerge)
+        taskMgr.doMethodLater(SerpentKnobs.timeLimit(), self._timeUp, self.uniqueName('serpent-timeout'))
+        self.notify.info('Sea Serpent %s attacks ship %s (class %s)' % (self.doId, ship.doId, ship.getShipClass()))

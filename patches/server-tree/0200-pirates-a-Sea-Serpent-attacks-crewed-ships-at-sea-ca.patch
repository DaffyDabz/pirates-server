+"""
+Sends the Sea Serpent after pirate ships out in the deep water (patch 0223, 2026-11-19).
+
+The same rules as the Kraken (patch 0221): every serpent-check-period seconds
+(60) each crewed pirate ship that is sailing outside the starter waters has a
+serpent-chance (0.15) of being attacked, at most serpent-max (2) serpents at
+once in the world, a ship that just met one is left alone for serpent-cooldown
+seconds (900), and a ship never has a Kraken and a Sea Serpent at once.
+want-serpent 0 turns it all off.
+"""
+import random
+
+from direct.directnotify import DirectNotifyGlobal
+
+from pirates.creature.DistributedSeaSerpentAI import DistributedSeaSerpentAI, whyNotTarget, _knob
+
+
+class SeaSerpentManagerAI:
+    notify = DirectNotifyGlobal.directNotify.newCategory('SeaSerpentManagerAI')
+
+    TASK_NAME = 'serpent-manager-upkeep'
+
+    def __init__(self, air, shipManager=None):
+        self.air = air
+        self.shipManager = shipManager
+        self.serpents = {}
+        self.lastAttack = {}
+        self.random = random.Random()
+
+    @staticmethod
+    def wantSerpent():
+        return _knob('bool', 'want-serpent', True)
+
+    @staticmethod
+    def checkPeriod():
+        return max(5.0, _knob('float', 'serpent-check-period', 60.0))
+
+    @staticmethod
+    def chance():
+        return min(1.0, max(0.0, _knob('float', 'serpent-chance', 0.15)))
+
+    @staticmethod
+    def maxSerpents():
+        return max(0, _knob('int', 'serpent-max', 2))
+
+    @staticmethod
+    def cooldown():
+        return max(0.0, _knob('float', 'serpent-cooldown', 900.0))
+
+    def start(self):
+        if not self.wantSerpent():
+            self.notify.info('want-serpent is off')
+            return
+        # half a period later than the Kraken's check, so the two never pick the same ship in one frame
+        taskMgr.doMethodLater(self.checkPeriod() * 1.5, self.__upkeep, self.TASK_NAME)
+
+    def stop(self):
+        taskMgr.remove(self.TASK_NAME)
+        for serpent in list(self.serpents.values()):
+            serpent.finish('stopped')
+
+    def candidateShips(self):
+        ships = []
+        if self.shipManager is not None and hasattr(self.shipManager, 'getPlayerShips'):
+            ships = list(self.shipManager.getPlayerShips())
+        if not ships:
+            from pirates.ship.DistributedShipAI import DistributedShipAI
+            ships = [do for do in list(self.air.doId2do.values()) if isinstance(do, DistributedShipAI)]
+        return ships
+
+    def whyNot(self, ship, now=None, ignoreStarterWaters=False, ignoreCooldown=False):
+        why = whyNotTarget(self.air, ship, ignoreStarterWaters)
+        if why:
+            return why
+        if len(self.serpents) >= self.maxSerpents():
+            return 'already %d Sea Serpents out' % len(self.serpents)
+        if not ignoreCooldown:
+            now = globalClock.getFrameTime() if now is None else now
+            last = self.lastAttack.get(ship.doId)
+            if last is not None and now - last < self.cooldown():
+                return 'met a Sea Serpent %d s ago' % int(now - last)
+        return ''
+
+    def __upkeep(self, task):
+        try:
+            self.upkeep()
+        except Exception as e:
+            self.notify.warning('Sea Serpent upkeep failed: %r' % (e,))
+        task.delayTime = self.checkPeriod()
+        return task.again
+
+    def upkeep(self):
+        if not self.wantSerpent():
+            return []
+        started = []
+        now = globalClock.getFrameTime()
+        for ship in self.candidateShips():
+            if self.whyNot(ship, now):
+                continue
+            if self.random.random() >= self.chance():
+                continue
+            if self.attack(ship):
+                started.append(ship.doId)
+        return started
+
+    def attack(self, ship, side=None):
+        serpent = DistributedSeaSerpentAI(self.air)
+        serpent.onDone = self.__serpentDone
+        if side is None:
+            side = self.random.choice((1, -1))
+        if not serpent.attackShip(ship, side):
+            return None
+        self.serpents[serpent.doId] = serpent
+        self.lastAttack[ship.doId] = globalClock.getFrameTime()
+        return serpent
+
+    def __serpentDone(self, serpent):
+        self.serpents.pop(serpent.doId, None)
+        self.lastAttack[serpent.shipId] = globalClock.getFrameTime()
+
+    def summon(self, ship):
+        """The ~serpent magic word: skips the chance, the cooldown and the starter waters rule."""
+        why = self.whyNot(ship, ignoreStarterWaters=True, ignoreCooldown=True)
+        if why:
+            return None, why
+        return self.attack(ship), ''

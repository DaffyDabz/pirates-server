+def whyNotTarget(air, ship, ignoreStarterWaters=False):
+    """'' when a Sea Serpent may attack this ship now, else the reason it may not."""
+    if ship is None or getattr(ship, 'air', None) is None:
+        return 'no ship'
+    if getattr(ship, 'npcShip', 0):
+        return 'an enemy ship'
+    if ship.getShipClass() not in HULL_HALF_WIDTH:
+        return 'ship class %s is not a serpent target' % ship.getShipClass()
+    if getattr(ship, 'serpent', None) is not None:
+        return 'already has a Sea Serpent'
+    if getattr(ship, 'kraken', None) is not None:
+        return 'already has a Kraken'
+    afloat = getattr(ship, '_isAfloat', None)
+    if afloat is not None and not afloat():
+        return 'not afloat'
+    state = (getattr(ship, 'gameState', None) or ['Off'])[0]
+    if state in SERPENT_SHIP_STATES_BLOCKED:
+        return 'ship state %s' % state
+    if not ship.getPiratesAboard():
+        return 'nobody aboard'
+    if not ignoreStarterWaters:
+        from pirates.ship import StarterWaters
+        if StarterWaters.inStarterWaters(air, ship.getX(), ship.getY()):
+            return 'in the starter waters'
+    return ''
+

+
+    def _later(self, delay, fn):
+        taskMgr.remove(self.uniqueName('serpent-step'))
+        taskMgr.doMethodLater(delay, fn, self.uniqueName('serpent-step'))
+
+    def _timeUp(self, task=None):
+        # the time limit lands even while it waits between bites
+        if self.phase in ('Rising', 'Attacking'):
+            self._checkShip()
+        return None if task is None else task.done
+
+    def _checkShip(self):
+        """The ship, or None after ending the fight because it is gone, sunk, docked or the time is up."""
+        ship = self.getShip()
+        why = self._shipGoneReason(ship)
+        if why:
+            self.finish(why)
+            return None
+        if globalClock.getFrameTime() - self.startTime >= SerpentKnobs.timeLimit():
+            self._tellCrew(ship, 'The Sea Serpent gives up and swims away.')
+            self.finish('time limit')
+            return None
+        return ship
+
+    def _emerge(self, task=None):
+        if self.phase in ('Leaving', 'Off') or self._checkShip() is None:
+            return None if task is None else task.done
+        self.phase = 'Attacking'
+        self.bitesThisSide = 0
+        self.b_setGameState('Emerge')
+        self._later(EMERGE_TIME, self._settle)
+        return None if task is None else task.done
+
+    def _settle(self, task=None):
+        if self.phase != 'Attacking' or self._checkShip() is None:
+            return None if task is None else task.done
+        self.b_setGameState('Idle')
+        self._later(SerpentKnobs.attackPeriod(), self._lunge)
+        return None if task is None else task.done
+
+    def _lunge(self, task=None):
+        if self.phase != 'Attacking' or self._checkShip() is None:
+            return None if task is None else task.done
+        self.b_setGameState('Attack')
+        self._later(BITE_DELAY, self._bite)
+        return None if task is None else task.done
+
+    def _bite(self, task=None):
+        if self.phase != 'Attacking':
+            return None if task is None else task.done
+        ship = self._checkShip()
+        if ship is None:
+            return None if task is None else task.done
+        try:
+            maxHp = max(1, int(ship.getMaxHp() or 1))
+            bite = max(1, int(round(maxHp * SerpentKnobs.damagePercent() / 100.0)))
+            floor = int(maxHp * SerpentKnobs.hullFloorPercent() / 100.0)
+            hp = int(ship.getHp() or 0)
+            newHp = max(floor, hp - bite) if hp > floor else hp
+            self.bites += 1
+            self.bitesThisSide += 1
+            if newHp != hp:
+                self.hullTaken += hp - newHp
+                ship.b_setHp(newHp)   # 0 sinks the ship; the next step sees it and leaves
+        except Exception as e:
+            self.notify.warning('Sea Serpent %s bite failed: %r' % (self.doId, e))
+            self.finish('error')
+            return None if task is None else task.done
+
+        swapEvery = SerpentKnobs.swapEvery()
+        if swapEvery and self.bitesThisSide >= swapEvery:
+            self._later(ATTACK_TIME - BITE_DELAY, self._dive)
+        else:
+            self._later(ATTACK_TIME - BITE_DELAY, self._settle)
+        return None if task is None else task.done
+
+    def _dive(self, task=None):
+        if self.phase != 'Attacking' or self._checkShip() is None:
+            return None if task is None else task.done
+        self.b_setGameState('Submerge')
+        self._later(SUBMERGE_TIME, self._swapSides)
+        return None if task is None else task.done
+
+    def _swapSides(self, task=None):
+        if self.phase != 'Attacking':
+            return None if task is None else task.done
+        ship = self._checkShip()
+        if ship is None:
+            return None if task is None else task.done
+        self.side = -self.side
+        x, y, z, h = self.sidePos(ship.getShipClass(), self.side)
+        self.b_setXYZH(x, y, z, h)   # it is hidden under water while it moves
+        self._later(UNDER_WATER_TIME, self._emerge)
+        return None if task is None else task.done
+
+    def _shipGoneReason(self, ship):
+        if ship is None or getattr(ship, 'air', None) is None:
+            return 'ship gone'
+        afloat = getattr(ship, '_isAfloat', None)
+        if afloat is not None and not afloat():
+            return 'ship sunk'
+        state = (getattr(ship, 'gameState', None) or ['Off'])[0]
+        if state in ('Docked', 'PutAway', 'Off'):
+            return 'ship left'
+        return ''
+
+    # ---- hits: a fixed bite, so kids always see the bar go down the same amount
+    def takeKrakenHit(self, avatar, isCannon):
+        """WeaponBaseAI's sea-monster hook (patch 0221). Returns the damage done (0 under water or when down)."""
+        if not self.isAlive() or self.phase != 'Attacking':
+            return 0
+        if self.gameFSM.getCurrentOrNextState() not in self.HITTABLE_STATES:
+            return 0
+        damage = SerpentKnobs.cannonDamage() if isCannon else SerpentKnobs.weaponDamage()
+        damage = min(damage, self.hp)
+        if damage <= 0:
+            return 0
+        if avatar is not None:
+            self.attackers.add(avatar.doId)
+        self.b_setHp(self.hp - damage)
+        return damage
+
+    def serpentDied(self):
+        self.dead = True
+        if self.phase not in ('Rising', 'Attacking'):
+            return
+        taskMgr.remove(self.uniqueName('serpent-step'))
+        ship = self.getShip()
+        if ship is not None and not self._shipGoneReason(ship):
+            self._reward(ship)
+        self.finish('beaten')
+
+    def _reward(self, ship):
+        from pirates.economy.EconomyGlobals import ItemId
+        gold = SerpentKnobs.gold()
+        paid = []
+        pirates = {av.doId: av for av in ship.getPiratesAboard()}
+        for avId in self.attackers:
+            av = self.air.doId2do.get(avId)
+            if av is not None and avId not in pirates and hasattr(av, 'getInventory'):
+                pirates[avId] = av
+        for avId, av in pirates.items():
+            try:
+                inventory = av.getInventory()
+                if inventory is not None and gold:
+                    inventory.addGoldInPocket(gold)
+                paid.append(avId)
+            except Exception as e:
+                self.notify.warning('Sea Serpent %s: could not pay %s: %r' % (self.doId, avId, e))
+        try:
+            if hasattr(ship, 'addPlunder'):
+                ship.addPlunder([ItemId.CARGO_CHEST, ItemId.CARGO_SKCHEST])
+        except Exception as e:
+            self.notify.warning('Sea Serpent %s: no plunder for ship %s: %r' % (self.doId, ship.doId, e))
+        self._tellCrew(ship, 'You beat the Sea Serpent! %d gold each, and a treasure chest in the hold!' % gold)
+        self.notify.info('Sea Serpent %s beaten on ship %s: %d gold to %s' % (self.doId, ship.doId, gold, sorted(paid)))
+        self.rewarded = paid
+
+    def _tellCrew(self, ship, text):
+        try:
+            for av in ship.getPiratesAboard():
+                if hasattr(av, 'd_setSystemMessage'):
+                    av.d_setSystemMessage(0, text)
+        except Exception:

+@magicWord(category=CATEGORY_SYSTEM_ADMIN, types=[str])
+def serpent(what='attack'):
+    """
+    The Sea Serpent (patch 0223): 'attack' sends one at the ship you are on now (even in the starter waters),
+    'why' says whether it may attack your ship by itself, 'beat' knocks it down, 'off' sends it away.
+    """
+    invoker = spellbook.getInvoker()
+    air = spellbook.getManager().air
+    shipMgr = getattr(air, 'shipManager', None)
+    serpentMgr = getattr(shipMgr, 'serpentMgr', None)
+    if serpentMgr is None:
+        from pirates.creature.SeaSerpentManagerAI import SeaSerpentManagerAI
+        serpentMgr = SeaSerpentManagerAI(air, shipMgr)
+        if shipMgr is not None:
+            shipMgr.serpentMgr = serpentMgr
+
+    from pirates.ship.DistributedShipAI import DistributedShipAI
+    ship = None
+    for shipId in (getattr(invoker, 'getActiveShipId', lambda: 0)(), getattr(invoker, 'getCrewShipId', lambda: 0)(),
+                   getattr(invoker, 'parentId', 0)):
+        obj = air.doId2do.get(shipId)
+        if isinstance(obj, DistributedShipAI):
+            ship = obj
+            break
+    if ship is None:
+        return "You are not on a ship"
+
+    if what == 'why':
+        return "Sea Serpent on ship %d: %s" % (ship.doId, serpentMgr.whyNot(ship) or 'it may attack now')
+    if what in ('beat', 'off'):
+        serpent = getattr(ship, 'serpent', None)
+        if serpent is None:
+            return "No Sea Serpent on ship %d" % ship.doId
+        if what == 'off':
+            serpent.finish('magic word')
+            return "The Sea Serpent leaves ship %d" % ship.doId
+        if not serpent.isAlive():
+            return "The Sea Serpent is already down"
+        serpent.b_setHp(0)
+        return "Knocked the Sea Serpent down"
+    if what != 'attack':
+        return "Valid: attack, why, beat, off"
+
+    serpent, why = serpentMgr.summon(ship)
+    if serpent is None:
+        return "No Sea Serpent: %s" % why
+    return "A Sea Serpent attacks ship %d" % ship.doId
+
+

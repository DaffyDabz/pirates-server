+# half the hull's width in feet, measured from the High hull models (tools/serpent_measure.py)
+HULL_HALF_WIDTH = {
+    ShipGlobals.INTERCEPTORL1: 22, ShipGlobals.INTERCEPTORL2: 37, ShipGlobals.INTERCEPTORL3: 45,
+    ShipGlobals.MERCHANTL1: 30, ShipGlobals.MERCHANTL2: 43, ShipGlobals.MERCHANTL3: 52,
+    ShipGlobals.WARSHIPL1: 26, ShipGlobals.WARSHIPL2: 43, ShipGlobals.WARSHIPL3: 54,
+}
+
+# seconds the client animations take (24 fps): emerge 118 frames, attack 30, submerge 37
+EMERGE_TIME = 5.0
+BITE_DELAY = 0.9
+ATTACK_TIME = 1.3
+SUBMERGE_TIME = 1.6
+UNDER_WATER_TIME = 3.0
+
+SERPENT_SHIP_STATES_BLOCKED = ('Off', 'Spawn', 'Docked', 'Sinking', 'Sunk', 'PutAway', 'RecoverFromSunk',
+                               'InBoardingPosition', 'WaitingForGrapple', 'GrappleLerping', 'InPosition',
+                               'Boarded', 'Defeated', 'Parley')

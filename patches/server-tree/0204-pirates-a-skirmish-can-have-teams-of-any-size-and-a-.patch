From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:28:02 -0800
Subject: [PATCH 204/371] pirates: a skirmish can have teams of any size, and a
 pirate who leaves a Lookout fight is out (0270)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/pvp/PVPManagerAI.py  |  34 +++++++-
 pirates/pvp/PVPSkirmishAI.py | 148 +++++++++++++++++++++++++++++------
 2 files changed, 155 insertions(+), 27 deletions(-)

diff --git a/pirates/pvp/PVPManagerAI.py b/pirates/pvp/PVPManagerAI.py
index 57a021b..ec4967e 100644
--- a/pirates/pvp/PVPManagerAI.py
+++ b/pirates/pvp/PVPManagerAI.py
@@ -232,6 +232,35 @@ class PVPManagerAI(DistributedObjectAI):
         skirmish.start()
         return skirmish
 
+    def startTeamSkirmish(self, teamLists, parentId=None, winScore=None):
+        # family server (11-19, 0270): a Lookout match (DistributedMatchMakerAI): teamLists are lists of pirates
+        members = set([avatar.doId for team in teamLists for avatar in team])
+        for otherChallengerId, otherInviteeId in list(self.pending.items()):
+            if otherChallengerId in members:
+                self.clearPending(otherChallengerId)
+                self.takeBack(otherInviteeId)
+            elif otherInviteeId in members:
+                self.clearPending(otherChallengerId)
+                self.reject(otherChallengerId, RejectCode.PVP_OTHER_IN_BATTLE)
+
+        skirmish = PVPSkirmishAI(self, self.nextSkirmishId, teamLists=teamLists, parentId=parentId,
+            winScore=winScore)
+        self.nextSkirmishId += 1
+        self.skirmishes[skirmish.skirmishId] = skirmish
+        for avId in skirmish.getMemberIds():
+            self.avatar2skirmish[avId] = skirmish
+            self.recentlyEnded.pop(avId, None)
+
+        skirmish.start()
+        return skirmish
+
+    def memberLeft(self, skirmish, avId, opponents):
+        # one pirate is out of a Lookout skirmish that goes on without him
+        if self.avatar2skirmish.get(avId) is skirmish:
+            del self.avatar2skirmish[avId]
+
+        self.recentlyEnded[avId] = (set(opponents), self.now())
+
     def skirmishOver(self, skirmish):
         self.skirmishes.pop(skirmish.skirmishId, None)
         now = self.now()
@@ -239,8 +268,7 @@ class PVPManagerAI(DistributedObjectAI):
             if self.avatar2skirmish.get(avId) is skirmish:
                 del self.avatar2skirmish[avId]
 

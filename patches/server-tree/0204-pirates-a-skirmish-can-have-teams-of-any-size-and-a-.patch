+    def memberStop(self, avId, reason, name):
+        # a Lookout match: he is out, the others play on while two teams still have pirates
+        team = self.getTeamOf(avId)
+        if not team:
+            return
+
+        opponents = self.getOpponentIds(avId)
+        self.teams[team].remove(avId)
+        if reason == 'left':
+            self.gone.add(avId)
+        else:
+            avatar = self.getAvatar(avId)
+            if avatar is not None and avatar.getPVPTeam():
+                avatar.b_setPVPTeam(0)
+
+        self.manager.memberLeft(self, avId, opponents)
+        if reason == 'left':
+            text = '%s left the skirmish.' % name
+        elif reason == 'moved':
+            text = '%s went somewhere else and is out of the skirmish.' % name
+        else:
+            text = '%s stopped playing.' % name
+
+        if reason != 'left':
+            self.tell('You left the skirmish.', [avId])
+
+        if len(self.liveTeams()) < 2:
+            self.finish(None, '%s Not enough pirates are left. The skirmish is over.' % text)
+        else:
+            self.tell(text)

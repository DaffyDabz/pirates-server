+# family server (11-19, 0272): the Lookout's match maker. The Lookout panel (the spyglass) sends a pirate's
+# request here, and this finds him a game:
+#   PvP Skirmish / Team Battle  a queue per game type; a match forms from 2 to 8 pirates, the pirates are moved to
+#                               one island and fight a Skirmish there (PVPSkirmishAI, the same rules as Crew Battle)
+#   PvP Sea Battle              picks the smaller side and moves him to that side's dock (SeaBattleManagerAI)
+#   Parlor games                "find a table": the blackjack or poker table with the most pirates and a free seat
+#   Treasure map with crew      the captain and the crewmates who said yes start the map's voyage together
+#
+# The client side is the old game's, unchanged (LookoutRequestLVL1):
+#   avatar.requestActivity / requestInvites   client -> the pirate's own object (DistributedPlayerPirateAI hands
+#                                              them to this object)
+#   requestActivityAccepted, lookoutFeedback(chance), requestInvitesResp(invitees, failed), requestLookoutInvite,
+#   lookoutMatchFound(seconds, matchId), lookoutMatchFailed(restart)   AI -> the pirate
+#   requestJoin(matchId), skipJoin(matchId, stop), cancelRequest(matchId)   client -> this object (doId 4700)
+# This is a global object (every district has one on the same doId); each one only acts on pirates in its own
+# district.
+
+# GameTypeGlobals (pirates.world) imports the GUI, so its option keys and chance levels are copied here
+OPTION_MIN_PLAYERS = 7
+OPTION_DESIRED_PLAYERS = 8
+OPTION_MAX_PLAYERS = 9
+OPTION_VIP_PASS = 12
+OPTION_TM_ID = 14
+CHANCE_LOW = 1
+CHANCE_MODERATE = 25
+CHANCE_HIGH = 75
+
+PVP_MAX_PLAYERS = 8
+SEARCH_TIMEOUT = 600.0      # seconds a PvP search waits for other pirates
+ARRIVAL_TIMEOUT = 60.0      # seconds the pirates of a match have to reach the island or the voyage
+MEETING_UIDS = ['1150922126.8dzlu',     # Port Royal
+                '1156207188.95dzlu',    # Tortuga
+                '1160614528.73sdnaik',  # Cuba
+                '1142018473.22dxschafe']  # Isla del Fuego
+LOOKOUT_WIN_SCORE = 5       # knockouts to win a Lookout skirmish with more than two pirates
+

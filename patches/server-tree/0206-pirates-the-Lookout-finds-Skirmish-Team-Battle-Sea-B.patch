+class LookoutRequest:
+    # one search: a pirate alone, or a captain with the crewmates who said yes to his invite
+    def __init__(self, members, style, category, options, shipIds):
+        self.leaderId = members[0]
+        self.members = list(members)
+        self.style = style
+        self.category = category
+        self.options = options
+        self.shipIds = shipIds
+        self.declined = set()   # PvP: leaders he said no to; parlor: tables he said no to
+        self.match = None
+        minPlayers = intOption(options, OPTION_MIN_PLAYERS, 2)
+        self.minPlayers = min(max(2, minPlayers), PVP_MAX_PLAYERS)
+
+    def size(self):
+        return len(self.members)
+
+
+class LookoutMatch:
+    def __init__(self, matchId, kind, requests, data):
+        self.matchId = matchId
+        self.kind = kind        # 'pvp', 'table', 'sea' or 'tm'
+        self.requests = list(requests)
+        self.data = data
+        self.joined = set()
+        self.launched = False
+
+    def memberIds(self):
+        ids = []
+        for request in self.requests:
+            ids.extend(request.members)
+
+        return ids
+
+
+class LookoutInvite:
+    # a captain asked his crew or friends along; they say yes or no on their own Lookout panel
+    def __init__(self, leaderId, category, style, options, rawOptions, invitees):
+        self.leaderId = leaderId
+        self.category = category
+        self.style = style
+        self.options = options
+        self.rawOptions = rawOptions
+        self.pending = set(invitees)
+        self.accepted = []
+        self.leaderRequest = None   # (style, category, options, shipIds) once his client sends it
+        self.timedOut = False
+
+
+def parseOptions(options):
+    parsed = {}
+    for pair in options or []:
+        try:
+            parsed[int(pair[0])] = str(pair[1])
+        except (ValueError, TypeError, IndexError):
+            continue
+
+    return parsed
+
+
+def intOption(options, key, default=0):
+    try:
+        return int(options.get(key, default))
+    except (ValueError, TypeError):
+        return default
+

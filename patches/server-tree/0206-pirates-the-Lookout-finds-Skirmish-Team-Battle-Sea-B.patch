+    def requestLeftMatch(self, match, request):
+        # a captain (or a pirate alone) left a match that has not launched yet
+        if match.launched or self.matches.get(match.matchId) is not match:
+            if request in match.requests:
+                match.requests.remove(request)
+            return
+
+        others = [other for other in match.requests if other is not request]
+        if match.kind == 'pvp' and others:
+            self.detachMatch(match)
+            for other in others:
+                self.requeue(other)
+            self.formMatches(match.requests[0].style)
+            return
+
+        self.detachMatch(match)
+
+    def requeue(self, request):
+        for avId in request.members:
+            self.fail(avId, True)
+
+        self.enqueue(request, announce=False)
+
+    def __joinTimedOut(self, matchId):
+        match = self.matches.get(matchId)
+        if match is None or match.launched:
+            return
+
+        for request in list(match.requests):
+            for avId in list(request.members):
+                if avId in match.joined:
+                    continue
+
+                if avId == request.leaderId:
+                    match.requests.remove(request)
+                    request.match = None
+                    self.removeRequest(request)
+                    for otherId in request.members:
+                        if otherId == avId:
+                            self.fail(otherId, False, 'You did not answer in time, so the search ended.')
+                        else:
+                            self.fail(otherId, False, 'Your captain did not answer in time.')
+                    break
+
+                self.leaveParty(request, avId)
+                self.fail(avId, False, 'You did not answer in time, so you stayed behind.')
+
+        if not match.requests:
+            self.detachMatch(match)
+            return
+
+        if match.kind == 'pvp':
+            style = match.requests[0].style
+            if self.groupWorks(match.requests, style):
+                match.data['teams'] = self.splitTeams(match.requests, style)
+                self.launch(match)
+                return
+
+            requests = list(match.requests)
+            self.detachMatch(match)
+            for request in requests:
+                self.requeue(request)
+            self.formMatches(style)
+            return
+
+        self.launch(match)
+
+    def launch(self, match):
+        match.launched = True
+        taskMgr.remove(self.taskName('join', match.matchId))
+        if match.kind == 'pvp':
+            self.launchSkirmish(match)
+        elif match.kind == 'table':
+            self.launchTable(match)
+        elif match.kind == 'sea':
+            self.launchSeaBattle(match)
+        elif match.kind == 'tm':
+            self.launchTreasureMap(match)
+
+    def moveTo(self, avatar, uid, spawnPt=None, world=None):
+        teleportMgr = self.air.teleportMgr
+        world = world or teleportMgr.getMainWorld()
+        if world is None:
+            return False
+
+        teleportMgr.d_initiateTeleport(avatar, world.getType(), world.getFileName(), uid, spawnPt)
+        return True

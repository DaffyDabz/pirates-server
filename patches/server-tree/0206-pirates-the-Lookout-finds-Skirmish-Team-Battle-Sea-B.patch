+    # --- PvP Skirmish and Team Battle: the queue ---
+
+    def enqueue(self, request, announce=True):
+        queue = self.queues.setdefault(request.style, [])
+        if request not in queue:
+            queue.append(request)
+
+        taskMgr.remove(self.taskName('search', request.leaderId))
+        taskMgr.doMethodLater(SEARCH_TIMEOUT, self.__searchTimedOut, self.taskName('search', request.leaderId),
+            extraArgs=[request])
+        if announce:
+            self.tell(request.leaderId, 'You will be notified when a match is found.')
+
+        self.sendFeedback(request.style)
+        self.formMatches(request.style)
+
+    def __searchTimedOut(self, request):
+        if request.match is not None or request not in self.queues.get(request.style, []):
+            return
+
+        self.endRequest(request, 'Nobody else is looking for that game right now. Try again later!')
+
+    def sendFeedback(self, style):
+        queue = self.queues.get(style, [])
+        total = sum([request.size() for request in queue])
+        for request in queue:
+            if total >= request.minPlayers and len(queue) > 1:
+                chance = CHANCE_HIGH
+            elif len(queue) > 1:
+                chance = CHANCE_MODERATE
+            else:
+                chance = CHANCE_LOW
+            for avId in request.members:
+                self.send(avId, 'lookoutFeedback', [chance])
+
+    def conflicts(self, group, request):
+        for other in group:
+            if other.leaderId in request.declined or request.leaderId in other.declined:
+                return True
+
+        return False
+
+    def groupWorks(self, group, style):
+        total = sum([request.size() for request in group])
+        if len(group) < 2 or total > PVP_MAX_PLAYERS:
+            return False
+
+        return total >= max([request.minPlayers for request in group])
+
+    def formMatches(self, style):
+        # oldest search first: add every other search that fits (up to 8 pirates), and drop the ones that want
+        # more pirates than came together
+        while True:
+            queue = list(self.queues.get(style, []))
+            found = None
+            for seed in queue:
+                if seed.size() > PVP_MAX_PLAYERS:
+                    continue
+
+                group = [seed]
+                total = seed.size()
+                for other in queue:
+                    if other is seed or self.conflicts(group, other):
+                        continue
+                    if total + other.size() <= PVP_MAX_PLAYERS:
+                        group.append(other)
+                        total += other.size()
+
+                while len(group) > 1 and not self.groupWorks(group, style):
+                    extra = [other for other in group[1:] if other.minPlayers > total]
+                    if not extra:
+                        break
+                    drop = max(extra, key=lambda other: other.minPlayers)
+                    group.remove(drop)
+                    total -= drop.size()
+
+                if self.groupWorks(group, style):
+                    found = group
+                    break
+
+            if found is None:
+                return
+
+            self.makeMatch('pvp', found, teams=self.splitTeams(found, style))
+
+    def splitTeams(self, group, style):
+        # a team battle: two teams as even as can be, a crew never split; a free-for-all: one team per crew
+        if style != PiratesGlobals.GAME_STYLE_TEAM_BATTLE:
+            return [list(request.members) for request in group]
+
+        teams = [[], []]
+        for request in sorted(group, key=lambda request: -request.size()):
+            smaller = 0 if len(teams[0]) <= len(teams[1]) else 1
+            teams[smaller].extend(request.members)
+
+        return teams
+
+    def pickIsland(self, avIds):
+        counts = dict([(uid, 0) for uid in MEETING_UIDS])
+        for avId in avIds:
+            avatar = self.getPlayer(avId)
+            uid = self.areaUidOf(avatar, MEETING_UIDS) if avatar is not None else None
+            if uid:
+                counts[uid] += 1
+
+        return max(MEETING_UIDS, key=lambda uid: (counts[uid], -MEETING_UIDS.index(uid)))
+
+    def launchSkirmish(self, match):
+        members = [avId for avId in match.memberIds() if self.getPlayer(avId) is not None]
+        uid = self.pickIsland(members)
+        islandDoId = self.air.uidMgr.getDoId(uid)
+        if not islandDoId or self.air.teleportMgr.getMainWorld() is None:
+            for avId in members:
+                self.fail(avId, False, 'The skirmish island is not ready. Try again later.')
+            self.closeMatch(match)
+            return
+
+        match.data['islandDoId'] = islandDoId
+        match.data['waitStart'] = self.now()
+        for avId in members:
+            avatar = self.getPlayer(avId)
+            if avatar.parentId == islandDoId:
+                self.fail(avId, False, 'You\'re already here: the skirmish starts when everyone arrives.')
+            elif not self.canMove(avatar):
+                self.leaveParty(self.avatar2request[avId], avId)
+                self.fail(avId, False, 'You can\'t be moved from where you are, so you were left out of the skirmish.')
+            else:
+                self.moveTo(avatar, uid)
+                self.tell(avId, 'Off to the skirmish! It starts when everyone arrives.')
+
+        self.checkArrivals(match.matchId)
+
+    def checkArrivals(self, matchId):
+        match = self.matches.get(matchId)
+        if match is None:
+            return
+
+        islandDoId = match.data['islandDoId']
+        teams = []
+        waiting = False
+        for team in match.data['teams']:
+            here = []
+            for avId in team:
+                avatar = self.getPlayer(avId)
+                if avatar is None or self.avatar2request.get(avId) is None:
+                    continue
+                if avatar.parentId == islandDoId:
+                    here.append(avatar)
+                else:
+                    waiting = True
+            teams.append(here)
+
+        if waiting and self.now() - match.data['waitStart'] < ARRIVAL_TIMEOUT:
+            taskMgr.doMethodLater(1.0, self.checkArrivals, self.taskName('arrive', matchId), extraArgs=[matchId])
+            return
+
+        self.closeMatch(match)
+        teams = [[avatar for avatar in team if not self.inSkirmish(avatar.doId)] for team in teams]
+        teams = [team for team in teams if team]
+        pvpManager = getattr(self.air, 'pvpManager', None)
+        if len(teams) < 2 or pvpManager is None:
+            for team in teams:
+                for avatar in team:
+                    self.tell(avatar.doId, 'Not enough pirates made it, so the skirmish is off.')
+            return
+
+        total = sum([len(team) for team in teams])
+        pvpManager.startTeamSkirmish(teams, parentId=islandDoId,
+            winScore=LOOKOUT_WIN_SCORE if total > 2 else None)
+
+    # --- PvP Sea Battle ---
+
+    def findSeaBattle(self, request):
+        manager = getattr(self.air, 'seaBattleMgr', None)
+        hqUids = getattr(manager, 'hqUids', None) if manager is not None else None
+        if not hqUids:
+            self.endRequest(request, 'The Sea Battle isn\'t running right now.')
+            return
+
+        from pirates.pvp import SeaBattleManagerAI
+        members = getattr(manager, 'members', {})
+        team = members.get(request.leaderId)
+        if team:
+            self.endRequest(request, 'Your captain is already in the Sea Battle.',
+                'You are already in the Sea Battle for the %s.' % SeaBattleManagerAI.TEAM_NAMES.get(team, 'other side'))
+            return
+
+        counts = {SeaBattleManagerAI.FRENCH: 0, SeaBattleManagerAI.SPANISH: 0}
+        for side in members.values():
+            if side in counts:
+                counts[side] += 1
+
+        team = SeaBattleManagerAI.FRENCH
+        if counts[SeaBattleManagerAI.SPANISH] < counts[SeaBattleManagerAI.FRENCH]:
+            team = SeaBattleManagerAI.SPANISH
+        if not hqUids.get(team):
+            team = SeaBattleManagerAI.otherTeam(team)
+
+        hqUid = hqUids.get(team)
+        teamName = SeaBattleManagerAI.TEAM_NAMES.get(team, 'your side')
+        for avId in list(request.members):
+            avatar = self.getPlayer(avId)
+            if avatar is not None and self.areaUidOf(avatar, [hqUid]):
+                text = 'You\'re at the %s dock: launch a ship from the dinghy here to join the Sea Battle.' % teamName
+                if avId == request.leaderId:
+                    self.endRequest(request, text, text)
+                    return
+                self.leaveParty(request, avId)
+                self.fail(avId, False, text)
+
+        self.makeMatch('sea', [request], team=team, hqUid=hqUid)
+
+    def launchSeaBattle(self, match):
+        from pirates.pvp import SeaBattleManagerAI
+        team = match.data['team']
+        hqUid = match.data['hqUid']
+        teamName = SeaBattleManagerAI.TEAM_NAMES.get(team, 'your side')
+        for avId in match.memberIds():
+            avatar = self.getPlayer(avId)
+            if avatar is None:
+                continue
+            if self.areaUidOf(avatar, [hqUid]):
+                self.fail(avId, False, 'You\'re at the %s dock: launch a ship from the dinghy here.' % teamName)
+            elif not self.canMove(avatar):
+                self.fail(avId, False, 'You can\'t be moved from where you are.')
+            elif self.moveTo(avatar, hqUid):

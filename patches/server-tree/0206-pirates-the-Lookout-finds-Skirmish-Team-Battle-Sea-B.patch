+
+        if match.kind == 'table' and not stop:
+            self.detachMatch(match)
+            request.declined.add(match.data['tableId'])
+            for otherId in request.members:
+                if otherId != avId:
+                    self.fail(otherId, True)
+            self.findTable(request)
+            return
+
+        self.detachMatch(match)
+        self.removeRequest(request)
+        if not stop:
+            self.send(avId, 'lookoutMatchFailed', [False])
+        for otherId in request.members:
+            if otherId != avId:
+                self.fail(otherId, False, 'Your captain said no.')

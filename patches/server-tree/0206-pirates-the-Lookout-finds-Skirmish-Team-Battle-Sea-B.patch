+    # --- parlor games: find a table ---
+
+    def tableClasses(self, style):
+        if style == PiratesGlobals.GAME_STYLE_BLACKJACK:
+            from pirates.minigame.DistributedBlackjackTableAI import DistributedBlackjackTableAI
+            return [DistributedBlackjackTableAI]
+
+        from pirates.minigame.DistributedHoldemTableAI import DistributedHoldemTableAI
+        from pirates.minigame.Distributed7StudTableAI import Distributed7StudTableAI
+        return [DistributedHoldemTableAI, Distributed7StudTableAI]
+
+    def openSeats(self, table):
+        return len([seat for seat in getattr(table, 'seats', []) if seat is None])
+
+    def piratesAt(self, table):
+        return len([seat for seat in getattr(table, 'seats', []) if seat is not None and seat != 1])
+
+    def findTable(self, request):
+        classes = self.tableClasses(request.style)
+        best = None
+        bestKey = None
+        for obj in list(self.air.doId2do.values()):
+            if not isinstance(obj, tuple(classes)) or obj.doId in request.declined:
+                continue
+
+            seats = self.openSeats(obj)
+            if not seats:
+                continue
+
+            kind = len(classes) - [isinstance(obj, cls) for cls in classes].index(True)
+            key = (seats >= request.size(), self.piratesAt(obj), kind, seats, -obj.doId)
+            if bestKey is None or key > bestKey:
+                best, bestKey = obj, key
+
+        if best is None:
+            if request.declined:
+                self.endRequest(request, 'No other card tables are open right now.')
+            else:
+                self.endRequest(request, 'No card tables are open right now.')
+            return
+
+        interior = best.getParentObj()
+        here = [avId for avId in request.members
+                if self.getPlayer(avId) is not None and self.getPlayer(avId).parentId == best.parentId]
+        if len(here) == len(request.members):
+            self.endRequest(request, 'There\'s an open seat right here: walk up to the table and sit down.')
+            return
+
+        self.makeMatch('table', [request], tableId=best.doId)
+
+    def tableSpawn(self, table, interior):
+        from panda3d.core import Point3
+        heading = table.getH(interior)
+        for distance in (8, 5):
+            pt = interior.getRelativePoint(table, Point3(0, -distance, 0))
+            if not hasattr(interior, 'isValidZone') or interior.isValidZone(interior.getZoneFromXYZ(pt)):
+                return (pt[0], pt[1], pt[2], heading)
+
+        pos = table.getPos(interior)
+        return (pos[0], pos[1], pos[2], heading)
+
+    def launchTable(self, match):
+        table = self.air.doId2do.get(match.data['tableId'])
+        interior = table.getParentObj() if table is not None else None
+        world = self.air.teleportMgr.getStandingWorld(table) if table is not None else None
+        if interior is None or world is None or not self.openSeats(table):
+            for avId in match.memberIds():
+                self.fail(avId, False, 'That table filled up. Try the Lookout again.')
+            self.closeMatch(match)
+            return
+
+        spawnPt = self.tableSpawn(table, interior)
+        uid = interior.getUniqueId()
+        for avId in match.memberIds():
+            avatar = self.getPlayer(avId)
+            if avatar is None:
+                continue
+            if avatar.parentId == interior.doId:
+                self.fail(avId, False, 'There\'s an open seat right here: walk up to the table and sit down.')
+            elif not self.canMove(avatar):
+                self.fail(avId, False, 'You can\'t be moved from where you are.')
+            else:
+                self.moveTo(avatar, uid, spawnPt, world)
+                self.tell(avId, 'Walk up to the table and sit down.')
+
+        self.closeMatch(match)

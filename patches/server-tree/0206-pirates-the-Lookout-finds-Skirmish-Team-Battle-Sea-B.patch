+
+    def checkJoined(self, match):
+        if self.matches.get(match.matchId) is not match or match.launched:
+            return
+
+        members = match.memberIds()
+        if members and set(members) <= match.joined:
+            self.launch(match)
+
+    def skipJoin(self, matchId, stop):
+        avId, avatar = self.getSender()
+        if avatar is None:
+            return
+
+        if avId in self.invitee2invite:

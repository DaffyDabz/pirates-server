+    # --- from the pirate's own object (DistributedPlayerPirateAI.requestActivity / requestInvites) ---
+
+    def handleRequestActivity(self, avatar, style, category, options, shipIds):
+        avId = avatar.doId
+        parsed = parseOptions(options)
+        vipPass = intOption(parsed, OPTION_VIP_PASS, 0)
+        if vipPass and vipPass != avId:
+            self.acceptInvite(avatar, vipPass)
+            return
+
+        invite = self.invites.get(avId)
+        if vipPass == avId and invite is not None:
+            # the captain's own request after his invites went out: wait for his crew to answer
+            invite.leaderRequest = (style, category, parsed, shipIds)
+            self.send(avId, 'requestActivityAccepted', [])
+            self.checkInvite(invite)
+            return
+
+        self.dropPirate(avId, quiet=True)
+        request = LookoutRequest([avId], style, category, parsed, shipIds)
+        self.send(avId, 'requestActivityAccepted', [])
+        self.dispatch(request)
+
+    def handleRequestInvites(self, avatar, modes, category, style, options, additionalAvs):
+        avId = avatar.doId
+        self.dropPirate(avId, quiet=True)
+        candidates = []
+        counted = set()     # crewmates and named pirates count as failed when they cannot come; offline friends do not
+        if PiratesGlobals.LOOKOUT_INVITE_CREW in modes:
+            for memberId in self.crewIds(avId):
+                candidates.append(memberId)
+                counted.add(memberId)
+
+        if PiratesGlobals.LOOKOUT_INVITE_FRIENDS in modes:
+            candidates.extend(self.friendIds(avatar))
+
+        for otherId in additionalAvs or []:
+            candidates.append(otherId)
+            counted.add(otherId)
+
+        invitees = []
+        numFailed = 0
+        for otherId in candidates:
+            if otherId == avId or otherId in invitees:
+                continue
+
+            other = self.getPlayer(otherId)
+            if other is None or self.isBusy(otherId) or self.inSkirmish(otherId):
+                if otherId in counted:
+                    numFailed += 1
+                continue
+
+            invitees.append(otherId)
+
+        self.send(avId, 'requestInvitesResp', [invitees, min(numFailed, 255)])
+        if not invitees:
+            # his panel goes on alone, or tells him a treasure map needs a crew
+            return
+
+        invite = LookoutInvite(avId, category, style, parseOptions(options), options, invitees)
+        self.invites[avId] = invite
+        for otherId in invitees:
+            self.invitee2invite[otherId] = invite
+            self.send(otherId, 'requestLookoutInvite', [avId, avatar.getName(), category, style, options])
+
+        taskMgr.doMethodLater(PiratesGlobals.LOOKOUT_JOIN_TIMEOUT_INVITE + 2, self.__inviteTimedOut,
+            self.taskName('invite', avId), extraArgs=[avId])
+
+    # --- invites ---
+
+    def acceptInvite(self, avatar, leaderId):
+        avId = avatar.doId
+        invite = self.invites.get(leaderId)
+        if invite is None or avId not in invite.pending:
+            self.fail(avId, False, 'That invitation is over.')
+            return
+
+        invite.pending.discard(avId)
+        invite.accepted.append(avId)
+        self.send(avId, 'requestActivityAccepted', [])
+        self.tell(avId, 'You said yes. You will go along when %s\'s crew is ready.' % self.nameOf(leaderId))
+        self.tell(leaderId, '%s is coming along.' % avatar.getName())
+        self.checkInvite(invite)
+
+    def declineInvite(self, avId):
+        invite = self.invitee2invite.get(avId)
+        if invite is None:
+            return False
+
+        del self.invitee2invite[avId]
+        if avId in invite.pending:
+            invite.pending.discard(avId)
+            self.tell(invite.leaderId, '%s said no.' % self.nameOf(avId))
+        elif avId in invite.accepted:
+            invite.accepted.remove(avId)
+            self.tell(invite.leaderId, '%s is not coming after all.' % self.nameOf(avId))
+
+        self.checkInvite(invite)
+        return True
+
+    def __inviteTimedOut(self, leaderId):
+        invite = self.invites.get(leaderId)
+        if invite is None:
+            return
+
+        invite.timedOut = True
+        if invite.leaderRequest is None:
+            # his client never sent his own request: the invite is over
+            for otherId in invite.accepted:
+                self.fail(otherId, False, 'The invitation from %s is over.' % self.nameOf(leaderId))
+            self.removeInvite(invite)
+            return
+
+        self.checkInvite(invite)
+
+    def removeInvite(self, invite):
+        taskMgr.remove(self.taskName('invite', invite.leaderId))
+        if self.invites.get(invite.leaderId) is invite:
+            del self.invites[invite.leaderId]
+
+        for otherId in list(invite.pending) + list(invite.accepted):
+            if self.invitee2invite.get(otherId) is invite:
+                del self.invitee2invite[otherId]
+
+    def cancelInvite(self, invite, text):
+        self.removeInvite(invite)
+        for otherId in invite.accepted:
+            self.fail(otherId, False, text)
+
+    def checkInvite(self, invite):
+        # ready once the captain's request is in and everybody answered (or the time ran out)
+        if self.invites.get(invite.leaderId) is not invite or invite.leaderRequest is None:
+            return
+
+        if invite.pending and not invite.timedOut:
+            return
+
+        self.removeInvite(invite)
+        leaderId = invite.leaderId
+        crew = [otherId for otherId in invite.accepted if self.getPlayer(otherId) is not None]
+        style, category, options, shipIds = invite.leaderRequest
+        if not crew:
+            if category == PiratesGlobals.GAME_TYPE_TM:
+                self.tell(leaderId, 'Nobody in your crew said yes, so you sail alone.')
+            else:
+                self.tell(leaderId, 'Nobody said yes, so you go on your own.')
+
+        request = LookoutRequest([leaderId] + crew, style, category, options, shipIds)
+        self.dispatch(request)
+
+    # --- requests ---
+
+    def addRequest(self, request):
+        for avId in request.members:
+            self.avatar2request[avId] = request
+
+    def removeRequest(self, request):
+        for avId in request.members:
+            if self.avatar2request.get(avId) is request:
+                del self.avatar2request[avId]
+
+        self.dequeue(request)
+
+    def dequeue(self, request):
+        queue = self.queues.get(request.style)
+        if queue and request in queue:
+            queue.remove(request)
+            taskMgr.remove(self.taskName('search', request.leaderId))
+            self.sendFeedback(request.style)
+
+    def endRequest(self, request, text=None, leaderText=None):
+        # the whole search is over: every member's panel stops searching
+        self.removeRequest(request)
+        for avId in request.members:
+            self.fail(avId, False, leaderText if avId == request.leaderId and leaderText else text)
+
+    def dispatch(self, request):
+        category, style = request.category, request.style
+        for avId in list(request.members):
+            if self.inSkirmish(avId):
+                if avId == request.leaderId:
+                    self.endRequest(request, 'Your captain is in a skirmish.', 'Finish your skirmish first.')
+                    return
+
+                request.members.remove(avId)
+                self.fail(avId, False, 'Finish your skirmish first.')
+
+        self.addRequest(request)
+        if category == PiratesGlobals.GAME_TYPE_PG and style in (PiratesGlobals.GAME_STYLE_BLACKJACK,
+                PiratesGlobals.GAME_STYLE_POKER):
+            self.findTable(request)
+        elif category == PiratesGlobals.GAME_TYPE_PVP and style in (PiratesGlobals.GAME_STYLE_BATTLE,
+                PiratesGlobals.GAME_STYLE_TEAM_BATTLE):
+            self.enqueue(request)
+        elif category == PiratesGlobals.GAME_TYPE_PVP and style == PiratesGlobals.GAME_STYLE_SHIP_BATTLE:
+            self.findSeaBattle(request)
+        elif category == PiratesGlobals.GAME_TYPE_TM:
+            self.findTreasureMap(request)
+        else:
+            self.endRequest(request, 'That game isn\'t on this server yet.')
+
+    def dropPirate(self, avId, quiet=False, offline=False):
+        # he stopped looking, logged off or started a new search
+        invite = self.invites.get(avId)
+        if invite is not None:
+            text = '%s logged off.' % self.nameOf(avId) if offline else '%s stopped looking.' % self.nameOf(avId)
+            self.cancelInvite(invite, text + ' The invitation is over.')
+
+        if avId in self.invitee2invite:
+            self.declineInvite(avId)
+
+        request = self.avatar2request.get(avId)
+        if request is None:
+            return
+
+        match = request.match
+        if avId != request.leaderId:
+            self.leaveParty(request, avId)
+            if match is not None and not match.launched:
+                self.checkJoined(match)
+            return
+
+        self.removeRequest(request)
+        for otherId in request.members:
+            if otherId != avId:
+                self.fail(otherId, False, 'Your captain stopped looking for a match.')
+
+        if not quiet and not offline:
+            self.send(avId, 'lookoutMatchFailed', [False])
+
+        if match is not None:
+            self.requestLeftMatch(match, request)
+
+    def leaveParty(self, request, avId):
+        if avId in request.members:
+            request.members.remove(avId)
+
+        if self.avatar2request.get(avId) is request:
+            del self.avatar2request[avId]
+
+        if request.match is not None:
+            request.match.joined.discard(avId)
+            teams = request.match.data.get('teams')
+            if teams:
+                for team in teams:
+                    if avId in team:
+                        team.remove(avId)
+
+    # --- the matches ---
+
+    def makeMatch(self, kind, requests, **data):
+        match = LookoutMatch(self.nextMatchId, kind, requests, data)
+        self.nextMatchId += 1
+        self.matches[match.matchId] = match
+        for request in requests:
+            self.dequeue(request)
+            request.match = match
+
+        for avId in match.memberIds():
+            self.send(avId, 'lookoutMatchFound', [PiratesGlobals.LOOKOUT_JOIN_TIMEOUT, match.matchId])
+
+        taskMgr.doMethodLater(PiratesGlobals.LOOKOUT_JOIN_TIMEOUT + 2, self.__joinTimedOut,
+            self.taskName('join', match.matchId), extraArgs=[match.matchId])
+        return match
+
+    def closeMatch(self, match):
+        # the match is done (launched, or called off); its requests are finished too
+        taskMgr.remove(self.taskName('join', match.matchId))
+        taskMgr.remove(self.taskName('arrive', match.matchId))
+        self.matches.pop(match.matchId, None)
+        for request in match.requests:
+            if request.match is match:
+                request.match = None
+                self.removeRequest(request)
+
+    def detachMatch(self, match):
+        # call the match off but keep its requests (they search again or end on their own)
+        taskMgr.remove(self.taskName('join', match.matchId))
+        taskMgr.remove(self.taskName('arrive', match.matchId))
+        self.matches.pop(match.matchId, None)
+        for request in match.requests:
+            if request.match is match:
+                request.match = None
+
+    def requestJoin(self, matchId):
+        avId, avatar = self.getSender()
+        if avatar is None:
+            return
+
+        request = self.avatar2request.get(avId)
+        match = request.match if request is not None else None
+        if match is None:
+            self.fail(avId, False, 'That match is over.')
+            return
+
+        if match.launched:
+            return
+
+        match.joined.add(avId)

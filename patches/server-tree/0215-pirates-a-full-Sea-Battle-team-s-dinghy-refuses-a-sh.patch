From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 02:47:19 -0800
Subject: [PATCH 215/371] pirates: a full Sea Battle team's dinghy refuses a
 ship before it launches, so nothing is spent (0291)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/pvp/SeaBattleManagerAI.py    | 44 ++++++++++++++++++++++++++++
 pirates/world/DistributedDinghyAI.py | 10 +++++++
 2 files changed, 54 insertions(+)

diff --git a/pirates/pvp/SeaBattleManagerAI.py b/pirates/pvp/SeaBattleManagerAI.py
index ddd538e..27448bc 100644
--- a/pirates/pvp/SeaBattleManagerAI.py
+++ b/pirates/pvp/SeaBattleManagerAI.py
@@ -69,6 +69,10 @@ class SeaBattleManagerAI:
         self.scoreLimit = max(1, config.GetInt('sea-battle-score-limit', 5))
         self.awayGrace = max(0.0, config.GetFloat('sea-battle-away-grace', 60.0))
         self.blockOtherShipHits = config.GetBool('sea-battle-only-ship-pvp', True)
+        # family server (11-19, 0291): a team with this many ships at sea is full (the original game's
+        # max-ships-per-privateer-team); with a balance margin, a team that many ships ahead is full too (0 = off)
+        self.maxShipsPerTeam = max(1, config.GetInt('max-ships-per-privateer-team', 10))
+        self.balanceMargin = max(0, config.GetInt('sea-battle-balance-margin', 0))
         self.siegeManager = None
         self.announcer = None
         self._taskName = 'seaBattleSync-%d' % id(self)
@@ -103,6 +107,44 @@ class SeaBattleManagerAI:
     def getHqUid(self, team):
         return self.hqUids.get(team)
 
+    # ---- team sizes (0291)
+    def teamShipCount(self, team, exceptShipId=None):
+        return len([shipId for shipId, shipTeam in list(self.ships.items()) if shipTeam == team and shipId != exceptShipId])
+
+    def teamPirateCount(self, team):
+        return len([avId for avId, avTeam in list(self.members.items()) if avTeam == team])
+
+    def isTeamFull(self, team, exceptShipId=None):
+        count = self.teamShipCount(team, exceptShipId)
+        if count >= self.maxShipsPerTeam:
+            return True
+        if self.balanceMargin:
+            return count - self.teamShipCount(otherTeam(team), exceptShipId) >= self.balanceMargin
+        return False
+
+    def chooseTeam(self, dinghyTeam, teamSpec=0, shipId=None):
+        """Which team a ship launched from a team dock's dinghy sails for: (team, None), or (0, denyCode) for the
+        dinghy's denyAccess. teamSpec is the other team, asked for from the client's "this team is full" pop-up."""
+        if dinghyTeam not in TEAMS:
+            return 0, None
+
+        wanted = teamSpec if teamSpec in TEAMS else dinghyTeam
+        if shipId is not None and self.ships.get(shipId) == wanted:
+            return wanted, None  # already sailing for it
+        if not self.isTeamFull(wanted, shipId):
+            return wanted, None
+        if teamSpec not in TEAMS and not self.isTeamFull(otherTeam(wanted), shipId):
+            return 0, PiratesGlobals.PrivateerSingleTeamFull  # "join the other side?"
+        return 0, PiratesGlobals.PrivateerBothTeamFull
+
+    def updateJoinable(self):
+        # the clients' SiegeManager.teamIsJoinable
+        if self.siegeManager is None:
+            return
+        joinable = [[team, not self.isTeamFull(team)] for team in TEAMS]
+        if joinable != self.siegeManager.getTeamsJoinable():
+            self.siegeManager.b_setTeamsJoinable(joinable)
+
     # ---- who is on which team
     def teamOf(self, avatar):
         # his own team, or the team of the match ship he stands on (a crewmate who
@@ -142,6 +184,7 @@ class SeaBattleManagerAI:
 
         for pirate in [avatar] + list(self._piratesAboard(ship)):
             self.joinAvatar(pirate, team)
+        self.updateJoinable()
 
         self.notify.info('ship %d (%s) sails for the %s' % (ship.doId, ship.getName(), TEAM_NAMES[team]))
         self._sendQuestEvent(avatar, QuestEvent.ShipPVPSpawn())
@@ -166,6 +209,7 @@ class SeaBattleManagerAI:
         self.ships.pop(ship.doId, None)
         if ship.getSiegeTeam():
             ship.b_setSiegeTeam(0)
+        self.updateJoinable()
 
     def _piratesAboard(self, ship):
         try:
diff --git a/pirates/world/DistributedDinghyAI.py b/pirates/world/DistributedDinghyAI.py
index 55bc60f..600f817 100644
--- a/pirates/world/DistributedDinghyAI.py
+++ b/pirates/world/DistributedDinghyAI.py
@@ -320,6 +320,16 @@ class DistributedDinghyAI(DistributedInteractiveAI):
 
             self.sendAvatarToShip(avatar, ship)
 
+        # family server (11-19, 0291): a full Sea Battle team says so before the ship is launched, so nothing is
+        # spent; the client's pop-up offers the other team (teamSpec) or, when both are full, the Lookout
+        seaBattle = getattr(self.air, 'seaBattleMgr', None)
+        if seaBattle is not None and self.getSiegeTeam():
+            team, denyCode = seaBattle.chooseTeam(self.getSiegeTeam(), teamSpec, shipId)
+            if denyCode is not None:
+                self.sendUpdateToAvatarId(avatar.doId, 'denyAccess', [denyCode])
+                return
+            teamSpec = team
+
         self.air.questMgr.deployedShip(avatar)

Subject: [PATCH 217/371] pirates: Sea Battle sinks count assists, sink streaks
 are announced and each sink raises the ship's bounty (0293)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/pvp/SeaBattleManagerAI.py | 86 +++++++++++++++++++++++++++++--
 1 file changed, 81 insertions(+), 5 deletions(-)

diff --git a/pirates/pvp/SeaBattleManagerAI.py b/pirates/pvp/SeaBattleManagerAI.py
index e80fb5d..b3e4051 100644
--- a/pirates/pvp/SeaBattleManagerAI.py
+++ b/pirates/pvp/SeaBattleManagerAI.py
@@ -36,6 +36,11 @@ MAX_CHAT = 200
 
 TEAM_NAMES = {FRENCH: 'French', SPANISH: 'Spanish'}
 
+ASSIST_WINDOW = 30.0     # 0293: a teammate's hit this recent on a sunk ship is an assist
+STREAK_ANNOUNCE = 3      # 0293: a ship's run of sinks is told to everyone from this many
+BOUNTY_PER_SINK = 25     # 0293: each sink raises the ship's bounty (setSiegeBounty; the icon needs want-bountyicons)
+MAX_BOUNTY = 65535       # setSiegeBounty is a uint16
+
 
 def otherTeam(team):
     return SPANISH if team == FRENCH else FRENCH
@@ -66,6 +71,9 @@ class SeaBattleManagerAI:
         self.members = {}           # avId -> team
         self.awaySince = {}         # avId -> when he was first seen away from the match
         self.scores = {FRENCH: 0, SPANISH: 0}
+        self.streaks = {}           # 0293: shipId -> sinks in a row since it last sank or left
+        self.bounties = {}          # 0293: shipId -> its bounty
+        self.recentHits = {}        # 0293: target shipId -> {attacker shipId: when it last hurt it}
         self.scoreLimit = max(1, config.GetInt('sea-battle-score-limit', 5))
         self.awayGrace = max(0.0, config.GetFloat('sea-battle-away-grace', 60.0))
         self.blockOtherShipHits = config.GetBool('sea-battle-only-ship-pvp', True)
@@ -217,6 +225,11 @@ class SeaBattleManagerAI:
         if ship.getSiegeTeam():
             ship.b_setSiegeTeam(0)
         self.updateJoinable()
+        # 0293: out of the battle, its streak, bounty and hits are gone
+        self.streaks.pop(ship.doId, None)
+        self.recentHits.pop(ship.doId, None)
+        if self.bounties.pop(ship.doId, 0):
+            self.sendBounty(ship, 0)
 
     def _piratesAboard(self, ship):
         try:
@@ -239,6 +252,9 @@ class SeaBattleManagerAI:
             ship = self.air.doId2do.get(shipId)
             if ship is None:
                 self.ships.pop(shipId, None)
+                self.streaks.pop(shipId, None)
+                self.bounties.pop(shipId, None)
+                self.recentHits.pop(shipId, None)
                 continue
 
             state = ship.gameState[0] if getattr(ship, 'gameState', None) else ''
@@ -338,6 +354,11 @@ class SeaBattleManagerAI:
                 enemyClass=enemyClass, gameType=PiratesGlobals.ShipPVPSiege,
                 damage=damage, damageWeapon=kind))
 
+            # 0293: which of his team's ships hurt it, for an assist
+            hitter = attacker.getParentObj()
+            if getattr(hitter, 'doId', None) in self.ships and self.ships[hitter.doId] == team:
+                self.recentHits.setdefault(targetShip.doId, {})[hitter.doId] = self.clock()
+
         if not sunk:
             return
 
@@ -351,16 +372,27 @@ class SeaBattleManagerAI:
                 enemyClass=enemyClass, gameType=PiratesGlobals.ShipPVPSiege, num=1,
                 killType=PiratesGlobals.ShipPVPShip, killWeapon=kind))
 
-        myShipName = myShip.getName() if getattr(myShip, 'doId', None) in self.ships else attacker.getName()
-        self.score(team, myShipName, theirs, targetShip.getName())
-
-    def score(self, team, shipName, sunkTeam, sunkShipName):
+        myShipId = myShip.doId if getattr(myShip, 'doId', None) in self.ships else None
+        myShipName = myShip.getName() if myShipId is not None else attacker.getName()
+        # 0293: a teammate's ship that hurt it lately gets an assist; the sunk ship's streak and bounty end, and the
+        # sinker's grow
+        assistShip = self.findAssist(targetShip.doId, myShipId, team)
+        self.score(team, myShipName, theirs, targetShip.getName(),
+            assistName=assistShip.getName() if assistShip is not None else None)
+        self.endStreak(targetShip, myShipName)
+        if myShipId is not None:
+            self.addStreak(myShip, team)
+
+    def score(self, team, shipName, sunkTeam, sunkShipName, assistName=None):
         self.scores[team] = self.scores.get(team, 0) + 1
         self.notify.info('%s sank %s: French %d, Spanish %d' % (shipName, sunkShipName, self.scores[FRENCH], self.scores[SPANISH]))
         self.air.writeServerEvent('sea-battle-sink', team=team, ship=shipName, sunkShip=sunkShipName,
             french=self.scores[FRENCH], spanish=self.scores[SPANISH])
         if self.announcer is not None:
-            self.announcer.announceSink(team, shipName, sunkTeam, sunkShipName)
+            if assistName:
+                self.announcer.announceSinkWithAssist(team, shipName, team, assistName, sunkTeam, sunkShipName)
+            else:
+                self.announcer.announceSink(team, shipName, sunkTeam, sunkShipName)
 
         self.tellAll('Score: French %d, Spanish %d.' % (self.scores[FRENCH], self.scores[SPANISH]))
         if self.scores[team] >= self.scoreLimit:
@@ -384,6 +416,50 @@ class SeaBattleManagerAI:
             if avatar is not None:
                 avatar.d_setSystemMessage(0, text)
 
+    # ---- assists, streaks and bounties (0293)
+    def findAssist(self, targetId, sinkerShipId, team):
+        hits = self.recentHits.pop(targetId, {})
+        now = self.clock()
+        best = None
+        for shipId, when in list(hits.items()):
+            if shipId == sinkerShipId or self.ships.get(shipId) != team or now - when > ASSIST_WINDOW:
+                continue
+            if best is None or when > best[1]:
+                best = (shipId, when)
+        if best is None:
+            return None
+        return self.air.doId2do.get(best[0])
+
+    def addStreak(self, ship, team):
+        streak = self.streaks.get(ship.doId, 0) + 1
+        self.streaks[ship.doId] = streak
+        self.setBounty(ship, self.bounties.get(ship.doId, 0) + BOUNTY_PER_SINK)
+        if streak >= STREAK_ANNOUNCE:
+            if self.announcer is not None:
+                self.announcer.announceSinkStreak(team, ship.getName(), streak)
+            else:
+                self.tellAll('The %s has sunk %d ships in a row!' % (ship.getName(), streak))
+        return streak
+
+    def endStreak(self, ship, sinkerName=None):
+        streak = self.streaks.pop(ship.doId, 0)
+        if self.bounties.pop(ship.doId, 0):
+            self.sendBounty(ship, 0)
+        if streak >= STREAK_ANNOUNCE and sinkerName:
+            self.tellAll('The %s ended the %s\'s run of %d sinks!' % (sinkerName, ship.getName(), streak))
+        return streak
+
+    def setBounty(self, ship, bounty):
+        bounty = max(0, min(int(bounty), MAX_BOUNTY))
+        self.bounties[ship.doId] = bounty
+        self.sendBounty(ship, bounty)
+
+    def sendBounty(self, ship, bounty):
+        try:
+            ship.sendUpdate('setSiegeBounty', [bounty])
+        except Exception as e:
+            self.notify.warning('bounty for ship %s failed: %s' % (getattr(ship, 'doId', 0), e))
+
     # ---- sinking
     def shipSunk(self, ship):
         """A Sea Battle ship's hull reached 0 (DistributedShipAI.setHp)."""

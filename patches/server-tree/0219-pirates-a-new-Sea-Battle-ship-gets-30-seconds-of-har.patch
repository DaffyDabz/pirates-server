From 319b1fe9e57a1c894b798c1b8bcaa59a7e9de729 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 02:47:19 -0800
Subject: [PATCH 219/371] pirates: a new Sea Battle ship gets 30 seconds of
 harbour guard, and rams follow the team rules (0295)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/pvp/SeaBattleManagerAI.py | 41 ++++++++++++++++++++++++++++++-
 pirates/ship/DistributedShipAI.py |  5 ++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/pirates/pvp/SeaBattleManagerAI.py b/pirates/pvp/SeaBattleManagerAI.py
index 92f71fa..a8bfabb 100644
--- a/pirates/pvp/SeaBattleManagerAI.py
+++ b/pirates/pvp/SeaBattleManagerAI.py
@@ -19,6 +19,7 @@ import time
 from direct.directnotify import DirectNotifyGlobal
 from direct.task import Task
 
+from pirates.battle import WeaponGlobals
 from pirates.piratesbase import PiratesGlobals
 from pirates.quest import QuestEvent
 from pirates.ship import ShipGlobals
@@ -99,6 +100,8 @@ class SeaBattleManagerAI:
         # max-ships-per-privateer-team); with a balance margin, a team that many ships ahead is full too (0 = off)
         self.maxShipsPerTeam = max(1, config.GetInt('max-ships-per-privateer-team', 10))
         self.balanceMargin = max(0, config.GetInt('sea-battle-balance-margin', 0))
+        # 0295: the harbour guard's seconds (0 = off): the ship's spawn shield, which the client already shows
+        self.guardSeconds = max(0.0, config.GetFloat('sea-battle-harbour-guard', 30.0))
         self.siegeManager = None
         self.announcer = None
         self._taskName = 'seaBattleSync-%d' % id(self)
@@ -212,6 +215,8 @@ class SeaBattleManagerAI:
         for pirate in [avatar] + list(self._piratesAboard(ship)):
             self.joinAvatar(pirate, team)
         self.updateJoinable()
+        if not rejoin:
+            self.guardShip(ship)
 
         self.notify.info('ship %d (%s) sails for the %s' % (ship.doId, ship.getName(), TEAM_NAMES[team]))
         self._sendQuestEvent(avatar, QuestEvent.ShipPVPSpawn())
@@ -344,7 +349,13 @@ class SeaBattleManagerAI:
         mine = self.teamOf(attacker)
         theirs = getattr(targetShip, 'getSiegeTeam', lambda: 0)()
         if mine and theirs:
-            return mine != theirs
+            if mine == theirs:
+                return False
+            # 0295: a ship under the harbour guard can't be hurt, and firing on the other team ends your own guard
+            if self.isGuarded(targetShip):
+                return False
+            self.dropGuard(attacker.getParentObj())
+            return True
         if mine or theirs:
             return False  # a Sea Battle ship and an outsider leave each other alone
         if getattr(targetShip, 'getPVPTeam', lambda: 0)() and getattr(attacker, 'getPVPTeam', lambda: 0)():
@@ -446,6 +457,34 @@ class SeaBattleManagerAI:
             if avatar is not None:
                 avatar.d_setSystemMessage(0, text)
 
+    # ---- the harbour guard (0295)
+    def guardShip(self, ship):
+        if self.guardSeconds <= 0 or not hasattr(ship, 'addSkillEffect'):
+            return
+        # the same effect and source as the deployer's short spawn shield, so this one lengthens it
+        ship.addSkillEffect(WeaponGlobals.C_SPAWN, self.guardSeconds, ship.doId)
+        self.tellShip(ship, 'The harbour guard keeps your ship safe for %d seconds, or until you fire at the other team.' % self.guardSeconds)
+
+    def tellShip(self, ship, text):
+        # the owner (still on the dock while it launches) and everyone aboard, once each
+        told = set()
+        for pirate in [self.air.doId2do.get(ship.getOwnerId())] + list(self._piratesAboard(ship)):
+            if pirate is None or pirate.doId in told or not hasattr(pirate, 'd_setSystemMessage'):
+                continue
+            told.add(pirate.doId)
+            pirate.d_setSystemMessage(0, text)
+
+    def isGuarded(self, ship):
+        hasSpawnBuff = getattr(ship, 'hasSpawnBuff', None)
+        return bool(hasSpawnBuff and hasSpawnBuff())
+
+    def dropGuard(self, ship):
+        if getattr(ship, 'doId', None) not in self.ships or not self.isGuarded(ship):
+            return False
+        ship.removeSkillEffect(WeaponGlobals.C_SPAWN, ship.doId)
+        self.tellShip(ship, 'You fired on the other team: the harbour guard has left your ship.')
+        return True
+
     # ---- assists, streaks and bounties (0293)
     def findAssist(self, targetId, sinkerShipId, team):
         hits = self.recentHits.pop(targetId, {})
diff --git a/pirates/ship/DistributedShipAI.py b/pirates/ship/DistributedShipAI.py
index 58113e3..acbe1f5 100644
--- a/pirates/ship/DistributedShipAI.py
+++ b/pirates/ship/DistributedShipAI.py
@@ -1746,6 +1746,11 @@ class DistributedShipAI(DistributedMovingObjectAI, DistributedCharterableObjectA
         if not self._canRam(target):
             return
 
+        # family server (11-19, 0295): the Sea Battle's own rules (the harbour guard, a truce) decide a ram too
+        seaBattle = getattr(self.air, 'seaBattleMgr', None)
+        if seaBattle is not None and not seaBattle.allowShipHit(avatar, target):
+            return
+
         self._consumeSkillEffect(WeaponGlobals.C_RAM)
 
         damage = self._getRamDamage()
-- 
2.53.0


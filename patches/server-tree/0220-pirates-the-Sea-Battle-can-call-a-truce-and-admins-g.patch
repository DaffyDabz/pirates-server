@@ -102,6 +103,7 @@ class SeaBattleManagerAI:
         self.balanceMargin = max(0, config.GetInt('sea-battle-balance-margin', 0))
         # 0295: the harbour guard's seconds (0 = off): the ship's spawn shield, which the client already shows
         self.guardSeconds = max(0.0, config.GetFloat('sea-battle-harbour-guard', 30.0))

@@ -601,6 +605,57 @@ class SeaBattleManagerAI:
         except Exception as e:
             self.notify.warning('quest event for %s failed: %s' % (avatar.doId, e))
 
+    # ---- admin (0296: the magic words below)
+    def statusText(self):
+        return ('Sea Battle: score French %d, Spanish %d (first to %d). Ships: French %d, Spanish %d (%d each at most). '
+                'Pirates: French %d, Spanish %d. Room: French %s, Spanish %s. Harbour guard %ds.%s') % (
+            self.scores[FRENCH], self.scores[SPANISH], self.scoreLimit,
+            self.teamShipCount(FRENCH), self.teamShipCount(SPANISH), self.maxShipsPerTeam,
+            self.teamPirateCount(FRENCH), self.teamPirateCount(SPANISH),
+            'no' if self.isTeamFull(FRENCH) else 'yes', 'no' if self.isTeamFull(SPANISH) else 'yes',
+            self.guardSeconds, ' TRUCE.' if self.truce else '')
+
+    def adminJoin(self, avatar, side):
+        side = str(side).strip().lower()
+        ship = avatar.getParentObj()
+        if not (self.isPlayerShip(ship) and ship.getOwnerId() == avatar.doId):
+            ship = None  # only his own ship comes with him
+
+        if side in ('none', 'off', 'leave', '0'):
+            if ship is not None and (ship.doId in self.ships or ship.getSiegeTeam()):
+                self.leaveShip(ship)
+            self.leaveAvatar(avatar)
+            return 'You are out of the Sea Battle.'
+
+        team = {'french': FRENCH, 'f': FRENCH, '1': FRENCH, 'spanish': SPANISH, 's': SPANISH, '2': SPANISH}.get(side)
+        if team is None:
+            return 'Say french, spanish or none.'
+        if ship is not None:
+            self.joinShip(avatar, ship, team)
+            return 'You and your ship sail for the %s.' % TEAM_NAMES[team]
+        self.joinAvatar(avatar, team)
+        return 'You are on the %s side: launch or board a ship to fight.' % TEAM_NAMES[team]
+
+    def resetBattle(self):
+        self.scores = {FRENCH: 0, SPANISH: 0}
+        for shipId in list(self.bounties):
+            ship = self.air.doId2do.get(shipId)
+            if ship is not None:
+                self.sendBounty(ship, 0)
+        self.bounties.clear()
+        self.streaks.clear()
+        self.recentHits.clear()
+        self.tellAll('The Sea Battle starts again: French 0, Spanish 0.')
+
+    def setTruce(self, on):
+        self.truce = bool(on)
+        if self.siegeManager is not None:
+            self.siegeManager.b_setPvpEnabled(not self.truce)
+        if self.truce:
+            self.tellAll('Truce! No ship can be hurt in the Sea Battle until it ends.')
+        else:
+            self.tellAll('The truce is over: the Sea Battle is on again!')
+
     # ---- team chat (SiegeManagerAI passes it here)
     def teamChat(self, sender, message, chatFlags, kind):
         team = self.teamOf(sender)
@@ -620,3 +675,49 @@ class SeaBattleManagerAI:
                 self.siegeManager.sendUpdateToAvatarId(avId, field, [sender.doId, message, chatFlags, 0, sender.getName()])
             count += 1
         return count
+
+
+# ---- magic words (0296)
+def _invokerSeaBattle():
+    invoker = spellbook.getInvoker()
+    air = getattr(invoker, 'air', None) or spellbook.getManager().air
+    return invoker, getSeaBattleManager(air)
+
+
+@magicWord(category=CATEGORY_SYSTEM_ADMIN)
+def siegeStatus():
+    """The Sea Battle: the score, each team's ships and pirates, which teams have room."""
+    invoker, mgr = _invokerSeaBattle()
+    if mgr is None:
+        return 'The Sea Battle is off (want-sea-battle 0).'
+    return mgr.statusText()
+
+
+@magicWord(category=CATEGORY_SYSTEM_ADMIN, types=[str])
+def siegeJoin(side='french'):
+    """Put yourself, and your own ship if you stand on it, on the french or spanish side, or none."""
+    invoker, mgr = _invokerSeaBattle()
+    if mgr is None:
+        return 'The Sea Battle is off (want-sea-battle 0).'
+    return mgr.adminJoin(invoker, side)
+
+
+@magicWord(category=CATEGORY_SYSTEM_ADMIN)
+def siegeReset():
+    """Start the Sea Battle's score again at 0 to 0 (streaks and bounties too)."""
+    invoker, mgr = _invokerSeaBattle()
+    if mgr is None:
+        return 'The Sea Battle is off (want-sea-battle 0).'
+    mgr.resetBattle()
+    return 'The Sea Battle score is 0 to 0.'
+
+
+@magicWord(category=CATEGORY_SYSTEM_ADMIN, types=[str])
+def siegeTruce(state='on'):
+    """on: no Sea Battle ship can hurt another; off: the battle is on again."""
+    invoker, mgr = _invokerSeaBattle()
+    if mgr is None:
+        return 'The Sea Battle is off (want-sea-battle 0).'
+    on = str(state).strip().lower() not in ('off', '0', 'no', 'false')
+    mgr.setTruce(on)
+    return 'Truce %s.' % ('on' if on else 'off')

         self._withOwnedShip(shipId, _got)
 
+    def _upgradeShip(self, avatar, inventory, shipId):
+        """
+        patch 0263: trade a ship in at the shipwright for the next one of its kind (EconomyGlobals.getShipUpgrade:
+        Light Sloop -> Sloop -> War Sloop, the same for galleons and frigates). The ship must be the pirate's
+        own, in port (put away, nobody aboard) and not one of the kept ships; the pirate needs the new ship's
+        Sailing level (the shop's level for it) and the price. The new ship gets the old one's name and cargo,
+        and the old ship is deleted from the database as a sold one is (patch 0201). If the new ship cannot be
+        made, the gold and the old ship are given back.
+        """
+        from pirates.ship import ShipGlobals
+        from pirates.reputation import ReputationGlobals
+        avId = avatar.doId
+        busy = 'The shipwright is still working on your last ship. Try again in a moment.'
+
+        def refuse(text):
+            self.notify.info('pirate %d may not trade up ship %d: %s' % (avId, shipId, text))
+            if hasattr(avatar, 'd_setSystemMessage'):
+                avatar.d_setSystemMessage(0, text)
+            self.d_makeSaleResponse(avId, 0)
+
+        if shipId in SOLD_SHIP_KEEP_SHIPS:
+            refuse('This ship cannot be traded in.')
+            return
+        if shipId not in inventory.getShipDoIdList():
+            refuse('That ship is not yours.')
+            return
+        if _tradingUp(avId) or avId in self.air.shipLoader.avatar2fsm:
+            refuse(busy)
+            return
+
+        SHIPS_TRADING_UP[avId] = time.time()
+
+        def stop(text):
+            SHIPS_TRADING_UP.pop(avId, None)
+            refuse(text)
+
+        def _got(dclass, fields):
+            if not fields:
+                stop('The shipwright could not find your ship. Try again.')
+                return
+
+            ship = self.air.doId2do.get(shipId)
+            if ship is not None:
+                crew = list(getattr(ship, 'crew', None) or [])
+                state = getattr(ship, 'gameState', None) or ['Off']
+                state = state[0] if isinstance(state, (list, tuple)) else state
+                if crew or state not in ('Off', 'PutAway', 'Sunk'):
+                    stop('Bring your ship into port and put it away before you trade it in.')
+                    return
+
+            oldClass = fields['setShipClass'][0]
+            oldName = _shipClassName(oldClass)
+            upgrade = EconomyGlobals.getShipUpgrade(oldClass)
+            if not upgrade:
+                stop('Your %s is already the biggest ship of its kind.' % oldName)
+                return
+
+            newClass, price = upgrade
+            newName = _shipClassName(newClass)
+            need = EconomyGlobals.getItemMinLevel(newClass) or 0
+            level = ReputationGlobals.getLevelFromTotalReputation(
+                InventoryType.SailingRep, inventory.getReputation(InventoryType.SailingRep))[0]
+            if level < need:
+                stop('You need Sailing level %d to sail a %s.' % (need, newName))
+                return
+
+            gold = inventory.getGoldInPocket()
+            if gold < price:
+                stop('You need %d gold to trade up to a %s.' % (price, newName))
+                return
+
+            # the database answer came later; look again
+            if shipId not in inventory.getShipDoIdList():
+                stop('That ship is not yours.')
+                return
+            if avId in self.air.shipLoader.avatar2fsm:
+                stop(busy)
+                return
+
+            shipName = (fields.get('setName') or ('',))[0]
+            cargo = list((fields.get('setCargo') or ([],))[0])
+            inventory.setShipDoIdList([s for s in inventory.getShipDoIdList() if s != shipId])
+            inventory.setGoldInPocket(gold - price)
+            job = {'done': False}
+
+            def giveBack():
+                ships = list(inventory.getShipDoIdList())
+                if shipId not in ships:
+                    inventory.setShipDoIdList(ships + [shipId])
+                inventory.setGoldInPocket(inventory.getGoldInPocket() + price)
+
+            def done(newId):
+                if job['done']:
+                    return
+                job['done'] = True
+                SHIPS_TRADING_UP.pop(avId, None)
+                if not newId:
+                    giveBack()
+                    refuse('The shipwright could not build your %s. Your gold and your %s are back.' % (newName, oldName))
+                    return
+
+                if cargo:
+                    moved = cargo
+                    try:
+                        maxCargo = ShipGlobals.getHullConfig(ShipGlobals.getModelClass(newClass))['setMaxCargo'][0]
+                        moved = cargo[:maxCargo]
+                    except Exception:
+                        pass
+                    self._setShipFields(newId, dclass, {'setCargo': [moved]})
+
+                for getter, setter in (('getActiveShipId', 'b_setActiveShipId'), ('getCrewShipId', 'b_setCrewShipId')):
+                    if hasattr(avatar, getter) and hasattr(avatar, setter) and getattr(avatar, getter)() == shipId:
+                        getattr(avatar, setter)(0)
+
+                bandManager = getattr(self.air, 'bandManager', None)
+                if bandManager is not None and hasattr(bandManager, 'updateShipInfo'):
+                    bandManager.updateShipInfo(avId)
+
+                if hasattr(avatar, 'd_setSystemMessage'):
+                    avatar.d_setSystemMessage(0, 'Your %s is now a %s! It kept its name and its cargo.' % (oldName, newName))
+                self.logShopkeepTransaction(type='requestUpgradeShip', shipId=shipId, newShipId=newId,
+                    price=price, purchaser=avId)
+                self.notify.info('pirate %d traded ship %d (class %d) up to ship %d (class %d) for %d gold' % (
+                    avId, shipId, oldClass, newId, newClass, price))
+                self.d_makeSaleResponse(avId, 2)
+                self._deleteSoldShip(avId, shipId, fields)
+
+            started = self.air.shipLoader.createShip(avatar, newClass, shipName, doneCallback=done)
+            if not started and not job['done']:
+                job['done'] = True
+                SHIPS_TRADING_UP.pop(avId, None)
+                giveBack()
+                refuse(busy)
+
+        self.air.dbInterface.queryObject(self.air.dbId, shipId, _got)
+

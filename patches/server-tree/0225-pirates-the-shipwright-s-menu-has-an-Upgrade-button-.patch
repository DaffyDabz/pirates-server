@@ -217,7 +217,7 @@ class DistributedShopKeeper:
         elif storeType == InteractGlobals.TRAIN:
             pass
         elif storeType == InteractGlobals.UPGRADE:
-            pass
+            self.startUpgradeShip(storeType)
         elif storeType == InteractGlobals.ACCESSORIES_STORE:
             self.fadeIval = Sequence(Func(self.setTransparency, 1), self.colorScaleInterval(1.0, VBase4(1.0, 1.0, 1.0, 0.0)), Func(self.hide))
             self.fadeIval.start()
@@ -525,6 +525,70 @@ class DistributedShopKeeper:
         
         self.finishShopping()
 
+    def startUpgradeShip(self, storeType):
+        # patch 0264: the shipwright's Upgrade entry trades a ship in for the next one of its kind
+        self.pickShipGUI = ShipShoppingPanel(PLocalizer.UpgradeShip, doneCallback = self.confirmUpgradeShip, mode = 'upgrade')
+        for shipId in base.localAvatar.getInventory().getShipDoIdList():
+            self.pickShipGUI.addOwnShip(shipId, self.confirmUpgradeShip)
+
+    def _sailingLevel(self):
+        from pirates.reputation import ReputationGlobals
+        inventory = base.localAvatar.getInventory()
+        if not inventory:
+            return 0
+        return ReputationGlobals.getLevelFromTotalReputation(InventoryType.SailingRep, inventory.getAccumulator(InventoryType.SailingRep))[0]
+
+    def confirmUpgradeShip(self, shipId = None):
+        if not shipId:
+            return
+
+        shipOV = self.cr.getOwnerView(shipId)
+        if not shipOV:
+            return
+
+        if shipOV.state != 'Off':
+            base.localAvatar.guiMgr.createWarning(PLocalizer.ShipNotInBottleWarning, PiratesGuiGlobals.TextFG6)
+            return
+
+        upgrade = EconomyGlobals.getShipUpgrade(shipOV.shipClass)
+        if not upgrade:
+            base.localAvatar.guiMgr.createWarning(PLocalizer.UpgradeShipNoNext, PiratesGuiGlobals.TextFG6)
+            return
+
+        newClass, price = upgrade
+        names = {
+            'old': PLocalizer.ShipClassNames.get(shipOV.shipClass, ''),
+            'new': PLocalizer.ShipClassNames.get(newClass, ''),
+            'gold': price,
+            'level': EconomyGlobals.getItemMinLevel(newClass)}
+        if self._sailingLevel() < names['level']:
+            base.localAvatar.guiMgr.createWarning(PLocalizer.UpgradeShipLevelWarning % names, PiratesGuiGlobals.TextFG6)
+            return
+
+        if self._repairGold() < price:
+            base.localAvatar.guiMgr.createWarning(PLocalizer.UpgradeShipGoldWarning % names, PiratesGuiGlobals.TextFG6)
+            return
+
+        if self.confirmDialog:
+            self.confirmDialog.destroy()
+            self.confirmDialog = None
+
+        self.confirmDialog = PDialog.PDialog(text = PLocalizer.UpgradeShipConfirmDialog % names, style = OTPDialog.YesNo, command = Functor(self.sendRequestUpgradeShip, shipId))
+
+    def sendRequestUpgradeShip(self, shipId, choice):
+        if self.confirmDialog:
+            self.confirmDialog.destroy()
+            self.confirmDialog = None
+
+        if choice != 1:
+            return
+
+        self.sendUpdate('requestMakeSale', [[[EconomyGlobals.SHIP_UPGRADE_ITEM, shipId]], [], []])
+        if self.pickShipGUI:
+            self.pickShipGUI.hide()
+
+        self.finishShopping()
+
     def startOverhaul(self, storeType):
         self.pickShipGUI = ShipShoppingPanel(PLocalizer.ShipOverhaul, doneCallback = self.confirmOverhaulShip, mode = 'overhaul')
         for shipId in base.localAvatar.getInventory().getShipDoIdList():

 pirates/distributed/InteractGlobals.py   |  1 +
 pirates/economy/DistributedShopKeeper.py | 66 +++++++++++++++++++++++-
 pirates/npc/DistributedNPCTownfolk.py    |  6 ++-
 pirates/piratesgui/ShipFrameShopping.py  |  6 +++
 4 files changed, 77 insertions(+), 2 deletions(-)


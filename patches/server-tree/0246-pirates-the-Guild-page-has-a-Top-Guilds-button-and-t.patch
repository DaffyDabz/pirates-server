         self.membersFrame.hide()
@@ -133,6 +137,9 @@ class GuildPage(SocialPage.SocialPage):
         
         if not self.codeInviteOptions:
             self.codeInviteOptions = self.mainChain.premakeButton(PLocalizer.GuildCodeOptions, self.b_codeInviteOptions)
+
+        if not self.topTenButton:
+            self.topTenButton = self.mainChain.premakeButton(PLocalizer.GuildPageTopGuilds, self.showTopGuilds)
         
         self.mainChain.makeButtons()
         self.determineButtonState()
@@ -420,6 +427,14 @@ class GuildPage(SocialPage.SocialPage):
     def load(self):
         pass
 
+    def showTopGuilds(self):
+        # family server (0320): the guild top ten, which only the ~topten magic word opened before
+        now = globalClock.getFrameTime()
+        if now - self.topTenAskedAt < 2.0:
+            return
+        self.topTenAskedAt = now
+        base.cr.guildManager.requestLeaderboardTopTen()
+
     def notifyTokenGeneratorOfRedeem(self, redeemerName):
         msg = PLocalizer.GuildNotifyTokenCreatorOfRedeem % redeemerName
         base.localAvatar.guiMgr.messageStack.addTextMessage(msg, seconds = 15, priority = 0, color = (0.5, 0.0, 0, 1), icon = ('friends', ''))

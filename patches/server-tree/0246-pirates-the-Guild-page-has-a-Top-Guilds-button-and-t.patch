         self.membersList = PirateMemberList.PirateMemberList(5, self.membersFrame, 'FOOLIO HC', height = 0.5475, memberHeight = 0.1, memberWidth = 0.48, memberOffset = 0.055)
         self.membersList.setPos(0.001, 0.0, 0.123)

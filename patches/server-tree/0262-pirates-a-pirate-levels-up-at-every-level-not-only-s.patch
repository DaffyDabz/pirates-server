+    def giveLevelUpQuests(self, avatar, questIds, tries=10):
+        # family server (patch 0351): one quest call for all of them. The quest manager runs one quest job per pirate
+        # and drops a second one ("an FSM already running"), so two calls in a row, or a level-up from a quest
+        # reward while the next quest of the ladder is still being made, lost the level-up quest for good. Wait
+        # for the running job instead (up to 10 seconds). A quest he holds or has finished is not given again.
+        if self.air.doId2do.get(avatar.doId) is not avatar:
+            return
 
-                maxMojo = avatar.getMaxMojo()
-                maxMojo += RepChart.getManaGain(repType)
+        from pirates.quest import QuestDB
+        history = avatar.getQuestHistory() or []
+        questIds = [q for q in questIds if q in QuestDB.QuestDict and
+                    QuestDB.QuestDict[q].getQuestInt() not in history and
+                    not self.air.questMgr.hasQuest(avatar, questId=q)]
+        if not questIds:
+            return
 
-                maxHp = avatar.getMaxHp()
-                maxHp += RepChart.getHpGain(repType)

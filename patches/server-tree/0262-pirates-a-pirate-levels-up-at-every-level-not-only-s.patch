+            maxHp += RepChart.getHpGain(repType)
+            maxMojo += RepChart.getManaGain(repType)
+            if isOverall:
+                quests = RepChart.getLevelUpQuest(repType, level)
+            else:
+                earnedUnspent, earnedSkills = RepChart.getLevelUpSkills(repType, level)
+                for unspent in earnedUnspent:
+                    self.b_setStackQuantity(unspent, self.getStackQuantity(unspent) + 1)
+
+                for skillId in earnedSkills:
+                    if not self.getStackQuantity(skillId):
+                        self.b_setStackQuantity(skillId, 1)
+
+                # getWeaponLevelUpQuest reads baseOb.stacks (does he own the level-4 weapon) at weapon level 20; the
+                # avatar has no .stacks (an AttributeError there kept every weapon at level 19), the inventory has it
+                quests = RepChart.getWeaponLevelUpQuest(repType, level, self)
+
+            newQuests.extend(quests)
+
+        avatar.b_setMaxHp(maxHp)
+        avatar.b_setMaxMojo(maxMojo)
+        avatar.b_setHp(maxHp)
+        avatar.b_setMojo(maxMojo)
+        self.giveLevelUpQuests(avatar, newQuests)

+    def giveLevelRewards(self, avatar, repType, fromLevel, toLevel):
+        # family server (patch 0351): the rewards for levels fromLevel+1 .. toLevel, one level at a time
+        isOverall = repType == InventoryType.OverallRep
+        maxHp, maxMojo = avatar.getMaxHp(), avatar.getMaxMojo()
+        newQuests = []
+        if isOverall:
+            avatar.b_setLevel(toLevel)
+        else:

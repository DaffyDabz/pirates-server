diff --git a/pirates/piratesgui/MessageStackPanel.py b/pirates/piratesgui/MessageStackPanel.py
index 0732ef0..7e05981 100644
--- a/pirates/piratesgui/MessageStackPanel.py
+++ b/pirates/piratesgui/MessageStackPanel.py
@@ -1,3 +1,4 @@
+from functools import cmp_to_key
 from direct.gui.DirectGui import DirectFrame, DirectButton, DGG
 from direct.gui.OnscreenText import OnscreenText
 from direct.interval.IntervalGlobal import *
@@ -54,7 +55,7 @@ class StackMessage(BorderFrame):
 
     def __cmp__(self, other):
         if other:
-            return cmp(other['priority'], self['priority'])
+            return ((other['priority'] > self['priority']) - (other['priority'] < self['priority']))
         else:
             return -1
 
@@ -447,7 +448,12 @@ class MessageStackPanel(DirectFrame):
 
     def addMessage(self, message, autoDestroy = 1):
         self.msgStack.append(message)
-        self.msgStack.sort()
+        # family server (patch 0353): Python 3 never calls __cmp__; NodePath's own < sorted by memory address, so
+        # a high-priority message was not put on top. Sort with the message's __cmp__ (higher priority first).
+        try:
+            self.msgStack.sort(key=cmp_to_key(lambda a, b: a.__cmp__(b)))
+        except Exception:
+            pass
         index = self._getMessageIndex(message)
         message.setPos(self._getSlotPos(index))
         message.createIval(self['fadeLerpTime'], Functor(self.removeMessage, message, autoDestroy)).start()

+        # then by name.
+        try:
+            self.members.sort(key=cmp_to_key(lambda a, b: a.__cmp__(b)))
+        except Exception:
+            pass
         self.memberFrame['canvasSize'] = (0, 0.0, 0, numMembers * self.memberHeight)
         self.placement = self.memberHeight * numMembers
         for index in range(numMembers):

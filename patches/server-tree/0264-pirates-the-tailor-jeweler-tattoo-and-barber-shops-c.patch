@@ -434,7 +435,13 @@ class PirateMemberList(DirectObject):
         if numMembers == 0:
             return
         
-        self.members.sort()
+        # family server (patch 0353): Python 3 never calls __cmp__; NodePath's own < sorted by memory address, so

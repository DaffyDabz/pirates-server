diff --git a/otp/chat/ChatManager.py b/otp/chat/ChatManager.py
index b6497b1..600267b 100644
--- a/otp/chat/ChatManager.py
+++ b/otp/chat/ChatManager.py
@@ -24,7 +24,7 @@ ThoughtPrefix = '.'
 def isThought(message):
     if len(message) == 0:
         return 0
-    elif string.find(message, ThoughtPrefix, 0, len(ThoughtPrefix)) >= 0:
+    elif message.find(ThoughtPrefix, 0, len(ThoughtPrefix)) >= 0:    # family server (patch 0354): no string.find
         return 1
     else:
         return 0
diff --git a/otp/distributed/AstronClientRepository.py b/otp/distributed/AstronClientRepository.py
index 3e1303c..84a05f2 100644
--- a/otp/distributed/AstronClientRepository.py
+++ b/otp/distributed/AstronClientRepository.py
@@ -265,6 +265,8 @@ class AstronClientRepository(ClientRepositoryBase):
         """
         This implicitly deletes all objects from the repository.
         """
-        for do_id in self.doId2do.keys():
+        # family server (patch 0354): deleteObject removes from doId2do, so loop over a copy of the ids
+        # (Python 3: "dictionary changed size during iteration" when the game quits).
+        for do_id in list(self.doId2do.keys()):
             self.deleteObject(do_id)
         ClientRepositoryBase.disconnect(self)
\ No newline at end of file

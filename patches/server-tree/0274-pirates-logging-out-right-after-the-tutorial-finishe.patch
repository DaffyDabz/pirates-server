From 4bf34d3a4468a364f75dd6b7fc57aaf996729a13 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:46:54 -0800
Subject: [PATCH 274/371] pirates: logging out right after the tutorial
 finishes the cleanup instead of stopping halfway (0323)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/world/WorldGridManagerAI.py | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/pirates/world/WorldGridManagerAI.py b/pirates/world/WorldGridManagerAI.py
index 2904903..8c0b4ba 100644
--- a/pirates/world/WorldGridManagerAI.py
+++ b/pirates/world/WorldGridManagerAI.py
@@ -402,7 +402,18 @@ class WorldGridManagerAI(object):
 
         for parentId in dict(gridInterests):
             parentObj = self.air.doId2do.get(parentId)
-            assert(parentObj is not None)
+            if parentObj is None:
+                # family server (11-19, 0323): the area this handler watched is already gone (a new pirate's
+                # tutorial world is torn down while he plays on in Port Royal). The assert here raised in the
+                # pirate's delete() when he logged out, so his quests, inventory and tasks were never cleaned up
+                # (TUT21, 11-17). Close what is left of it the way clearAvatarInterest does, without the parent
+                gridInterestHandler = gridInterests.pop(parentId, None)
+                if gridInterestHandler:
+                    gridInterestHandler.clearInterestZones()
+                    gridInterestHandler.destroy()
+
+                continue
+
             self.clearAvatarInterest(parentObj, avatar)
 
         assert(avatar.doId in self.gridInterestHandlers)
-- 

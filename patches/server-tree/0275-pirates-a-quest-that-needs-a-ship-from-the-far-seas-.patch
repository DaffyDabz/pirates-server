+++ b/pirates/quest/QuestTaskDNA.py
@@ -2866,3 +2866,39 @@ DBId2Class = {
     24: DefeatGroupTaskDNA}
 Class2DBId = invertDict(DBId2Class)
 RecoverItemClasses = (RecoverAvatarItemTaskDNA, RecoverTreasureItemTaskDNA, RecoverShipItemTaskDNA, RecoverContainerItemTaskDNA, RecoverAvatarGroupItemTaskDNA)
+
+
+def needsFarSeaHint(taskDNA, taskState=None):
+    """
+    Family server (patch 0356): True for a ship step (sink, loot or capture)
+    that no ship in the starter waters can count for, so the quest text
+    tells a kid to sail far out. Only the Navy Ferret (level 2) sails within
+    9,000 ft of Port Royal and Tortuga or on the course between them
+    (pirates/ship/StarterWaters.py, npcship-starter-level-max 5; every other
+    enemy class is level 6 or more), so these are the handleShipDefeat
+    checks, made on a Navy Ferret. 190 of the 233 ship steps need it.
+    """
+    if not isinstance(taskDNA, (DefeatShipTaskDNA, RecoverShipItemTaskDNA, CaptureShipNPCTaskDNA)):
+        return False
+    if taskState is not None and taskState.isComplete():
+        return False
+    faction, hull = taskDNA.faction, taskDNA.hull
+    if isinstance(taskDNA, RandomizedDefeatShipTaskDNA) and taskState is not None:
+        faction, hull = taskState.faction, taskState.hull
+    if faction is not None and not AvatarTypes.Navy.isA(faction):
+        return True
+    if hull is not None:
+        shipClassList = getShipList(hull)
+        if shipClassList and ShipGlobals.NAVY_FERRET not in shipClassList:
+            return True
+    if taskDNA.level > ShipGlobals.getShipLevel(ShipGlobals.NAVY_FERRET):
+        return True
+    return bool(taskDNA.isFlagship)
+
+
+def farSeaHintText(taskDNAs, taskStates):
+    """Patch 0356: the far-sea hint to add under a quest's text, or ''."""
+    for i, taskDNA in enumerate(taskDNAs):
+        if needsFarSeaHint(taskDNA, taskStates[i] if i < len(taskStates) else None):
+            return PLocalizer.QuestFarSeaHint
+    return ''

diff --git a/pirates/battle/DistributedShipCannonAI.py b/pirates/battle/DistributedShipCannonAI.py
index 0996501..93ca0f8 100644
--- a/pirates/battle/DistributedShipCannonAI.py
+++ b/pirates/battle/DistributedShipCannonAI.py
@@ -5,6 +5,55 @@ from pirates.battle.DistributedPCCannonAI import DistributedPCCannonAI
 from pirates.shipparts.DistributedShippartAI import DistributedShippartAI
 from pirates.shipparts.CannonDNA import CannonDNA
 from pirates.uberdog.UberDogGlobals import InventoryType
+import math
+
+# Family patch (0371): the game's own cannonball (Cannon.playAttack: power x 0.6, gravityMult 4.0).
+# fireAtPosition used to send a flat shot (pitch = the angle to the target, about 0), so the ball
+# fell in the sea a few hundred feet out while the damage was counted anyway.
+AI_BALL_GRAVITY = 32.174 * 4.0
+AI_CANNON_EXIT_HEIGHT = 12.0
+
+
+def aiBallSpeed(skillId=None, ammoSkillId=None):
+    try:
+        from pirates.battle import WeaponGlobals
+        if skillId is None:
+            skillId = InventoryType.CannonShoot
+        if ammoSkillId is None:
+            ammoSkillId = InventoryType.CannonRoundShot
+        speed = WeaponGlobals.getAttackProjectilePower(skillId, ammoSkillId) * 0.6
+        if speed > 50:
+            return speed
+    except Exception:
+        pass
+    return 780.0
+
+
+def aiBallistic(dist, dz, speed):
+    """(pitch in degrees, seconds in the air) for the game's cannonball to come down dist feet away
+    and dz feet above the barrel. Out of reach: the 40 degree shot."""
+    if dist < 1.0:
+        return 0.0, 0.0
+
+    def rise(pitch):
+        r = math.radians(pitch)
+        t = dist / (speed * math.cos(r))
+        return speed * math.sin(r) * t - 0.5 * AI_BALL_GRAVITY * t * t
+
+    lo, hi = -20.0, 40.0
+    if rise(hi) < dz:
+        pitch = hi
+    elif rise(lo) > dz:
+        pitch = lo
+    else:
+        for _ in range(40):
+            mid = (lo + hi) * 0.5
+            if rise(mid) < dz:
+                lo = mid
+            else:
+                hi = mid
+        pitch = (lo + hi) * 0.5
+    return pitch, dist / (speed * math.cos(math.radians(pitch)))
 
 
 class DistributedCannonDNA(CannonDNA):
@@ -96,7 +145,8 @@ class DistributedShipCannonAI(DistributedPCCannonAI, DistributedShippartAI, Dist
             
             h = -math.degrees(math.atan2(dx, dy))
             dist = math.sqrt(dx*dx + dy*dy)
-            p = math.degrees(math.atan2(dz, dist)) if dist > 0 else 0
+            # Family patch (0371): the pitch that carries the ball to targetPos (was a flat shot)
+            p, flightTime = aiBallistic(dist, dz - AI_CANNON_EXIT_HEIGHT, aiBallSpeed(skillId, ammoSkillId))
             
             # PosHpr for the projectile
             posHpr = [shipPos.getX(), shipPos.getY(), shipPos.getZ() + 5, h, p, 0]
@@ -104,8 +154,9 @@ class DistributedShipCannonAI(DistributedPCCannonAI, DistributedShippartAI, Dist
             # Send the projectile skill to clients (visual effect)

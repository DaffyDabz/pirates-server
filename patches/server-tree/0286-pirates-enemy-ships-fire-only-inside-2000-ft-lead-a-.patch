+    def _trackVelocity(self, obj):
+        """
+        Family patch (0371): (x, y) feet per second of obj, from its position at the last few AI
+        updates, for aiming where a moving ship will be.
+        """
+        track = self.__dict__.setdefault('_velTrack', {})
+        try:
+            key = obj.doId
+            p = obj.getPos()
+        except Exception:
+            return (0.0, 0.0)
+        now = globalClock.getFrameTime()
+        rec = track.get(key)
+        if rec is None or now - rec[0] > 5.0:
+            if len(track) > 40:
+                track.clear()
+            track[key] = (now, p[0], p[1], 0.0, 0.0)
+            return (0.0, 0.0)
+        t0, x0, y0, vx, vy = rec
+        dt = now - t0
+        if dt >= 0.25:
+            nvx = (p[0] - x0) / dt
+            nvy = (p[1] - y0) / dt
+            if nvx * nvx + nvy * nvy > 400.0 * 400.0:
+                nvx, nvy = 0.0, 0.0  # a jump (teleport, respawn), not sailing
+            vx = vx * 0.4 + nvx * 0.6
+            vy = vy * 0.4 + nvy * 0.6
+            track[key] = (now, p[0], p[1], vx, vy)
+        return (vx, vy)

From f06c9105878eb45e1b424351ce0e40f1ab5d147a Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 20:27:40 -0800
Subject: [PATCH 292/371] pirates: every other family pirate's ship is in the
 dinghy's list, and a crewmate's ship is no longer left out (0376)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/world/DistributedDinghyAI.py | 30 +++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/pirates/world/DistributedDinghyAI.py b/pirates/world/DistributedDinghyAI.py
index 639a76c..07336f0 100644
--- a/pirates/world/DistributedDinghyAI.py
+++ b/pirates/world/DistributedDinghyAI.py
@@ -83,6 +83,8 @@ class DistributedDinghyAI(DistributedInteractiveAI):
 
             # the client's ShipDeployPanel reads the ship name/class off the
             # member object, so it must be current before the offer lands
+            if getattr(member, 'shipInfo', None) is None or list(member.shipInfo)[:1] != [ship.doId]:
+                self._bandInfoChanged = True
             self.air.bandManager.updateShipInfo(member.avatarId, ship)
             captain = self.air.doId2do.get(ship.getCaptainId())
             bandOptions.append([
@@ -99,6 +101,10 @@ class DistributedDinghyAI(DistributedInteractiveAI):
 
         return bandOptions
 
+    def _lateBandOffer(self, avatarId, bandOptions):
+        if self.air.doId2do.get(self.doId) is self and self.air.doId2do.get(avatarId) is not None:
+            self.d_offerBandOptions(avatarId, bandOptions)
+
     def d_offerBandOptions(self, avatarId, bandOptions):
         self.sendUpdateToAvatarId(avatarId, 'offerBandOptions', [bandOptions])
 
@@ -106,7 +112,21 @@ class DistributedDinghyAI(DistributedInteractiveAI):
     # them and had no selectFriendShip, so the ship's "Friends" boarding tick
     # did nothing. A friend's ship is one whose captain is on this pirate's
     # friends list (or the other way round) with "Friends" ticked.
+    # family server (11-19, 0376): the boys could not get on each other's ship. They are not on each other's
+    # friends list, so only a crew put the other's ship in the dinghy's list, and a crew is held only while both
+    # are logged in: a game that closes, or a server restart, ends it without a word. Everyone on this server is
+    # family, so every other pirate's ship counts as a friend's ship (his Boarding Permissions "Friends" tick,
+    # on by default, still decides).
+    FAMILY_PIRATES_ARE_FRIENDS = True
+
     def areFriends(self, avatar, otherId):
+        if self.FAMILY_PIRATES_ARE_FRIENDS and otherId and otherId != avatar.doId and \
+                self.air.doId2do.get(otherId) is not None:
+            return True
+
+        return self._onFriendsList(avatar, otherId)
+
+    def _onFriendsList(self, avatar, otherId):
         def friendIds(av):
             ids = set()
             for entry in (av.getFriendsList() if av and hasattr(av, 'getFriendsList') else None) or []:
@@ -258,9 +278,17 @@ class DistributedDinghyAI(DistributedInteractiveAI):
 
     def handlePostRequestInteraction(self, avatar):
         publicOptions = self.getOfferPublicOptions(avatar)
+        self._bandInfoChanged = False
         bandOptions = self.getOfferBandOptions(avatar)
         self.d_offerPublicOptions(avatar.doId, publicOptions)
-        self.d_offerBandOptions(avatar.doId, bandOptions)
+        # family server (11-19, 0376): the crew card's ship info goes out through the state server, the offer
+        # straight to his game, so a card updated just now arrived after the offer and his game left the crewmate's
+        # ship out (it checks the card). The offer then waits a second.
+        if self._bandInfoChanged and bandOptions:
+            taskMgr.doMethodLater(1.0, self._lateBandOffer, 'family-band-offer-%d-%d' % (self.doId, avatar.doId),
+                extraArgs=[avatar.doId, bandOptions])
+        else:
+            self.d_offerBandOptions(avatar.doId, bandOptions)
         offered = set(info[1] for info in publicOptions + bandOptions)
         try:
             friendOptions = self.getOfferFriendOptions(avatar, offered)
-- 

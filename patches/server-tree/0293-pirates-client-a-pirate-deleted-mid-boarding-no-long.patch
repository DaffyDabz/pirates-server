From 6144ebc5561378499d8c47070612cad02bb5407d Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:13:53 -0800
Subject: [PATCH 293/371] pirates client: a pirate deleted mid-boarding no
 longer closes the other pirate's game (0377)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/ship/DistributedShip.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/pirates/ship/DistributedShip.py b/pirates/ship/DistributedShip.py
index ead81e8..a15cb00 100644
--- a/pirates/ship/DistributedShip.py
+++ b/pirates/ship/DistributedShip.py
@@ -1362,7 +1362,16 @@ class DistributedShip(DistributedMovingObject, DistributedCharterableObject, Zon
         if av.ropeEndNode:
             av.ropeEndNode.detachNode()
 
-        av.wrtReparentTo(self.root)
+        # family server (11-19, 0377): Player2's game closed when Player1 boarded his own ship nearby. Player2's game had
+        # just deleted Player1's pirate (he went out of range), and moving a deleted pirate asserts in Panda. A deleted
+        # pirate or ship is now left alone, and a pirate with no parent is placed on the deck directly.
+        if self.root is None or self.root.isEmpty() or av.isEmpty():
+            if not av.isLocal():
+                return
+        elif av.getParent().isEmpty():
+            av.reparentTo(self.root)
+        else:
+            av.wrtReparentTo(self.root)
         if av.isLocal():
             av.controlManager.currentControls.oneTimeCollide()
 
-- 

+
+        if not self.canWhisperAvatar(receiverId):
+            self.refuseWhisper(receiverId)
+            return error
+
         if type == SPEEDCHAT_NORMAL:
             base.localAvatar.whisperSCTo(messageIndex, receiverId, 0)
         elif type == SPEEDCHAT_EMOTE:

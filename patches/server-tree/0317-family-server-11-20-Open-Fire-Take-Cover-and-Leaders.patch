+        # Leadership shortens the other skills' recharge on the client, so wait the same here
+        if skillId != InventoryType.SailPowerRecharge and WeaponGlobals.C_RECHARGE in self.getSkillEffects():
+            recharge *= WeaponGlobals.POWER_RECHARGE_RATE_REDUCTION

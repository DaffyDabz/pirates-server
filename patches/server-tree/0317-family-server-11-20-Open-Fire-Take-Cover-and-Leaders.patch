         return True
 
+    def _buffCrew(self, effectId, duration, shouterId):
+        # a pirate's buff has no timer of its own, so the ship takes it off again
+        for avId in list(self.crew):
+            av = self.air.doId2do.get(avId)
+            if av is None or not hasattr(av, 'expireSkillEffect'):
+                continue
+
+            taskName = self.uniqueName('crew-skill-effect-%s-%s-%s' % (effectId, avId, shouterId))
+            if taskName in self._crewSkillEffectTasks:
+                taskMgr.remove(taskName)
+                av.expireSkillEffect(effectId, shouterId)
+
+            av.addSkillEffect(effectId, duration, shouterId)
+            self._crewSkillEffectTasks[taskName] = (effectId, avId, shouterId)
+            taskMgr.doMethodLater(duration, self._expireCrewSkillEffectTask, taskName,
+                extraArgs=[effectId, avId, shouterId, taskName])
+
+    def _expireCrewSkillEffect(self, effectId, avId, shouterId):
+        av = self.air.doId2do.get(avId)
+        if av is not None and hasattr(av, 'expireSkillEffect'):
+            av.expireSkillEffect(effectId, shouterId)
+
+    def _expireCrewSkillEffectTask(self, effectId, avId, shouterId, taskName):
+        self._crewSkillEffectTasks.pop(taskName, None)
+        self._expireCrewSkillEffect(effectId, avId, shouterId)
+
+    def _clearCrewSkillEffects(self):
+        # a ship put away or sunk mid-shout must not leave Take Cover on a pirate for good
+        tasks = getattr(self, '_crewSkillEffectTasks', {})
+        for taskName, (effectId, avId, shouterId) in list(tasks.items()):
+            taskMgr.remove(taskName)
+            self._expireCrewSkillEffect(effectId, avId, shouterId)
+
+        self._crewSkillEffectTasks = {}
+

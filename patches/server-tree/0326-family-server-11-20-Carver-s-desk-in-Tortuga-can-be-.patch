From bb52f8376d45a8cbd5e2b40dae7e131af2e0de46 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Fri, 20 Nov 2026 20:22:33 -0800
Subject: [PATCH 326/371] family server (11-20): Carver's desk in Tortuga can
 be searched again, and so can every barrel, crate, haystack and well that had
 no search range (carver-0001, patch 0410)

A searchable container with no 'Aggro Radius' in the world data was built with a 1 ft Search-prompt sphere sitting
inside the solid prop, so the prompt never showed and nobody could search it. It now gets the level editor's own
default, 5.0 (74 containers). Test: test_desk_reach.py (eeb7f39 FAIL 2.40 ft < 4.95 ft, 74 wrong; this PASS 6.40 ft, 0).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/world/GameAreaBuilderAI.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/pirates/world/GameAreaBuilderAI.py b/pirates/world/GameAreaBuilderAI.py
index 1473ce3..7bfeb40 100644
--- a/pirates/world/GameAreaBuilderAI.py
+++ b/pirates/world/GameAreaBuilderAI.py
@@ -369,7 +369,9 @@ class GameAreaBuilderAI(ClientAreaBuilderAI):
             container.setContainerColor(objectData['Visual'].get('Color', (1.0, 1.0, 1.0, 1.0)))
 
         container.setSearchTime(float(objectData.get('searchTime', '6.0')))
-        container.setSphereScale(float(objectData.get('Aggro Radius', 1.0)))
+        # family server: a container with no 'Aggro Radius' gets the level editor's default (5.0), not 1.0; at 1.0 the
+        # client's Search prompt was a 1 ft ball inside the solid prop, so nobody could search it (Carver's desk).
+        container.setSphereScale(float(objectData.get('Aggro Radius', 5.0)))
 
         zoneId = self.parent.getZoneFromXYZ(container.getPos())
         parent.generateChildWithRequired(container, zoneId)
-- 

 7 files changed, 45 insertions(+), 17 deletions(-)

diff --git a/pirates/battle/DistributedBattleAvatar.py b/pirates/battle/DistributedBattleAvatar.py
index e56f280..fb1781a 100644
--- a/pirates/battle/DistributedBattleAvatar.py
+++ b/pirates/battle/DistributedBattleAvatar.py
@@ -1782,11 +1782,14 @@ class DistributedBattleAvatar(DistributedReputationAvatar, WeaponBase, Teamable)
 
     def hideHpMeter(self, delay = 6.0):
         DistributedReputationAvatar.hideHpMeter(self, delay = delay)
-        if base.localAvatar.guiMgr.targetStatusTray.doId == self.getDoId():
+        # family client (11-20, crew-0003): disable calls this; an avatar disabled after he logged out (LocalPirate.delete
+        # deletes localAvatar first) has no target tray of his to fade.
+        av = getattr(base, 'localAvatar', None)
+        if av is not None and av.guiMgr.targetStatusTray.doId == self.getDoId():
             if self.getTotalHp() <= 0:
-                localAvatar.guiMgr.targetStatusTray.updateHp(0, self.maxHp)
+                av.guiMgr.targetStatusTray.updateHp(0, self.maxHp)
             
-            localAvatar.guiMgr.targetStatusTray.fadeOut(delay = delay)
+            av.guiMgr.targetStatusTray.fadeOut(delay = delay)
 
     def getLandRoamIdleAnimInfo(self):
         return ('idle', 1.0)
diff --git a/pirates/battle/DistributedPCCannon.py b/pirates/battle/DistributedPCCannon.py
index 06634a5..479b8dc 100644
--- a/pirates/battle/DistributedPCCannon.py
+++ b/pirates/battle/DistributedPCCannon.py
@@ -201,15 +201,20 @@ class DistributedPCCannon(DistributedWeapon.DistributedWeapon):
         self.ignore(InteractiveBase.END_INTERACT_EVENT)
         self.cgui.destroy()
         self.cgui = None
-        localAvatar.guiMgr.combatTray.hideSkills()
-        localAvatar.guiMgr.combatTray.disableTray()
+        # family client (11-20, crew-0003): logging out aboard his ship (at a cannon) deletes localAvatar before the ship and its parts are
+        # deleted (LocalPirate.delete first); with no local pirate there is nothing of his to tidy up here.
+        av = getattr(base, 'localAvatar', None)
+        if av is not None:
+            av.guiMgr.combatTray.hideSkills()
+            av.guiMgr.combatTray.disableTray()
         if self.fireSubframeCall:
             self.fireSubframeCall.cleanup()
             self.fireSubframeCall = None
 
         self.cannonDressingNode.detachNode()
-        base.localAvatar.guiMgr.combatTray.skillTray.hideSkillTray()
-        base.localAvatar.guiMgr.combatTray.initCombatTray(localAvatar.currentWeaponId)
+        if av is not None:
+            av.guiMgr.combatTray.skillTray.hideSkillTray()
+            av.guiMgr.combatTray.initCombatTray(av.currentWeaponId)
 
     def requestExit(self):
         DistributedWeapon.DistributedWeapon.requestExit(self)

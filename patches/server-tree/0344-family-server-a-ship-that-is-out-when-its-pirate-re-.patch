+++ b/pirates/uberdog/DistributedShipLoaderUD.py
@@ -307,10 +307,12 @@ class ActivateShipFSM(ShipLoaderOperationFSM):
             self._shipInventoryActivatedCallback)
 
     def _shipInventoryActivatedCallback(self, inventoryId):
-        self.air.sendActivate(self.shipId, 0, 0,
+        self.activateUnlessUp(self.shipId,
             self.air.dclassesByName['PlayerShipUD'],
-            {'setInventoryId': (inventoryId,)})
+            {'setInventoryId': (inventoryId,)},
+            self._shipUp)
 
+    def _shipUp(self):
         channel = self.accountId << 32 | self.avatarId
         self.setOwnerAgain(self.shipId, channel)
 
@@ -364,10 +366,12 @@ class ActivateShipFSM(ShipLoaderOperationFSM):
             self.cleanup(False)
             return
 
-        self.air.sendActivate(shippartDoId, 0, 0,
+        self.activateUnlessUp(shippartDoId,
             dclass,
-            {'setOwnerId': (self.avatarId,), 'setShipId': (self.shipId,)})
+            {'setOwnerId': (self.avatarId,), 'setShipId': (self.shipId,)},
+            lambda: self._shippartUp(shippartDoId))
 
+    def _shippartUp(self, shippartDoId):
         channel = self.accountId << 32 | self.avatarId
         self.setOwnerAgain(shippartDoId, channel)
 
@@ -392,6 +396,19 @@ class ActivateShipFSM(ShipLoaderOperationFSM):
         if not self.pendingShipparts:
             self.cleanup(True)
 
+    def activateUnlessUp(self, doId, dclass, fields, then):
+        # family server (11-21): a pirate who goes back to the pirate chooser while his ship is out and picks the
+        # same pirate again gets his ship activated a second time. The database state server ignores that, but
+        # sendActivate chases it with a move to (0, 0), and the state server then drops the AI from the ship
+        # without telling it. The AI keeps a dead copy, reuses it at the next launch and the ship has no steering
+        # wheel. A ship or part that is still up is left where it is; only the owner steps run.
+        def _gotActivated(doId, activated):
+            if not activated:
+                self.air.sendActivate(doId, 0, 0, dclass, fields)
+            then()
+
+        self.air.getActivated(doId, _gotActivated)
+
     def setOwnerAgain(self, doId, channel):

+
+    def checkForBiting(self):
+        if self.fishManager.activeFish is not None:
+            return
+        if self.fishManager.gameObject.fsm.getCurrentOrNextState() not in ['Fishing', 'Reeling', 'LureStall', 'LegdFishShow']:

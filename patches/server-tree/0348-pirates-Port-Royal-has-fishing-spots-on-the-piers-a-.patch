+        else:
+            self.weight = trophy
+        self.adjustedScale = (self.myData['scaleRange'][1] - self.myData['scaleRange'][0]) * (self.weight - self.myData['weightRange'][0]) / (self.myData['weightRange'][1] - self.myData['weightRange'][0]) + self.myData['scaleRange'][0]
+        self.initActor()
+        if not self.trophy:
+            self.initVariables()

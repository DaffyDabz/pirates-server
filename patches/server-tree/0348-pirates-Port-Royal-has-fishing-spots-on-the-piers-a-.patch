+from pirates.piratesgui.GuiPanel import *
+from pirates.piratesgui.RequestButton import RequestButton
+from pirates.piratesbase import PLocalizer
+from pirates.minigame import FishingGlobals
+
+class FishingResults(NodePath):
+    """The 'you caught a fish' card: the fish's name, weight and gold, and a Play Again button."""
+
+    def __init__(self, fishingGame):
+        NodePath.__init__(self, 'FishingResults')
+        self.reparentTo(base.a2dRightCenter)
+        self.gameObject = fishingGame
+        self.setPos(-1.0, 0.0, -0.25)
+        self.background = loader.loadModel('models/minigames/pir_m_gui_fsh_rewardScreen')
+        self.background.reparentTo(self)
+        self.background.setScale(0.8, 0.75, 0.75)
+        self.background.setPos(0.65, 0.75, 0.75)
+        self.bAgain = RequestButton(width=1.5, text=PLocalizer.FishingGui['PlayAgainButton'], command=self.playAgain)
+        self.bAgain.reparentTo(self)
+        self.bAgain.setPos(0.58, 0, 0.1)
+        self.bAgain.setScale(1.2, 1.2, 1.2)
+        self.title = self.makeLabel(PLocalizer.FishingGui['WinTitle'], PiratesGuiGlobals.TextScaleTitleJumbo, (0.62, 0, 1.3), PiratesGuiGlobals.TextFG1, PiratesGlobals.getPirateOutlineFont())
+        self.message = self.makeLabel(PLocalizer.FishingGui['WinText'], PiratesGuiGlobals.TextScaleTitleSmall, (0.64, 0, 1.15))
+        self.fishName = None
+        self.fishWeight = None
+        self.fishGold = None
+
+    def makeLabel(self, text, scale, pos, fg=None, font=None):
+        extra = {}
+        if font:
+            extra['text_font'] = font
+        return DirectLabel(parent=self, relief=None, text=text, text_scale=scale, text_align=TextNode.ACenter, text_fg=fg or PiratesGuiGlobals.TextFG2, text_shadow=PiratesGuiGlobals.TextShadow, text_wordwrap=17, pos=pos, textMayChange=0, **extra)
+
+    def destroy(self):
+        self.bAgain.destroy()
+
+    def showAll(self):
+        for label in (self.fishName, self.fishWeight, self.fishGold):
+            if label is not None:
+                label.removeNode()
+        fish = self.gameObject.fishManager.activeFish
+        self.fishName = self.makeLabel(fish.myData['name'], PiratesGuiGlobals.TextScaleTitleMed, (0.64, 0, 0.95))
+        self.fishWeight = self.makeLabel(str(fish.weight) + ' ' + PLocalizer.FishingGui['WeightLabel'], PiratesGuiGlobals.TextScaleTitleLarge, (0.64, 0, 0.7))
+        self.fishGold = self.makeLabel('+ ' + str(FishingGlobals.getFishGold(fish.myData, fish.weight)) + ' ' + PLocalizer.FishingGui['GoldText'], PiratesGuiGlobals.TextScaleTitleSmall, (0.64, 0, 0.5))
+        self.setScale(0.75, 0.75, 0.75)
+        self.show()
+
+    def cleanUp(self):
+        self.hide()
+
+    def playAgain(self):
+        self.cleanUp()
+        if self.gameObject.fsm.getCurrentOrNextState() != 'PlayerIdle':
+            self.gameObject.fsm.request('PlayerIdle')
+
+    def quit(self):
+        self.cleanUp()
+        self.gameObject.fsm.request('Offscreen')

+        if self.__dialog is None:
+            self.__dialog = PDialog(text=PLocalizer.FishingGui['ExitText'], style=OTPDialog.YesNo, giveMouse=False, command=self.__onDialogItemSelected)
+        else:
+            self.__dialog.cleanup()

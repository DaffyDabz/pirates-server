+    PiratesGlobals.TOD_DUSK: [Vec4(0.1, 0.15, 0.3, 1), Vec4(0.33, 0.3, 0.32, 1), Vec4(0.3, 0.22, 0.28, 1), Vec4(0.5, 0.33, 0.4, 1)],
+    PiratesGlobals.TOD_NIGHT: [Vec4(0.06, 0.14, 0.3, 1), Vec4(0.12, 0.3, 0.45, 1), Vec4(0.1, 0.18, 0.42, 1), Vec4(0.22, 0.3, 0.5, 1)],
+    PiratesGlobals.TOD_STARS: [Vec4(0.04, 0.12, 0.3, 1), Vec4(0.1, 0.25, 0.4, 1), Vec4(0.1, 0.15, 0.35, 1), Vec4(0.3, 0.28, 0.44, 1)],
+    PiratesGlobals.TOD_HALLOWEEN: [Vec4(0.05, 0.2, 0.35, 1), Vec4(0.15, 0.3, 0.35, 1), Vec4(0.1, 0.17, 0.3, 1), Vec4(0.25, 0.32, 0.45, 1)],
+    PiratesGlobals.TOD_FULLMOON: [Vec4(0.05, 0.2, 0.35, 1), Vec4(0.15, 0.3, 0.35, 1), Vec4(0.1, 0.17, 0.3, 1), Vec4(0.25, 0.32, 0.45, 1)],
+}
+fishRarityIds = [0, 1, 2]
+# One rod for everybody: the 2013 top rod (every depth band, longest cast). No rod or lure levels in this base.
+rodLevel = 3
+fishCountRangePerLevel = ((5, 8), (5, 7), (5, 7))
+castDistanceMultiplier = 0.7
+# One calm pace for everybody: the 2013 level-1 reel speed bumped to 1.0, a 4 second lure stall.
+reelSpeed = 1.0
+lureStallDuration = 4.0
+
+
+def giveMeAFish(location, depth, fishHisto=None):
+    """Pick a fish for a spot ('dock' or 'ship') and depth band; fishHisto maps fish id -> (caught, max) and is optional."""
+    rarity = random.choices(fishRarityIds, weights=raritySpawnChances)[0]
+    order = [rarity] + [r for r in fishRarityIds if r != rarity]
+    for r in order:
+        pool = rarityPool[location][depth][r]
+        if fishHisto is not None:
+            pool = [x for x in pool if fishHisto[x['id']][0] < fishHisto[x['id']][1]]
+        if pool:
+            return random.choice(pool)
+    return None
+
+
+def getFishGold(fishData, weight):
+    """Gold a caught fish pays out: a whole number, at least 1."""
+    return max(1, int(round(fishData['gold'] * weight)))

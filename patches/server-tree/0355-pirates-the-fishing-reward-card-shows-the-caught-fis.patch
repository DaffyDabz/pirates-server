From 34d89495d6a2867a08be38f6178b1de8a6b8caa8 Mon Sep 17 00:00:00 2001
From: DaffyDabz <daffydabz@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:16:02 -0800
Subject: [PATCH 355/371] pirates: the fishing reward card shows the caught
 fish's own picture instead of an empty circle (the 20 fish ids join the
 collection constants and picture map; the pictures ship as a small new art
 file) (client patch 53, art + code, no DC change, no restart)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pirates/minigame/FishingResults.py   | 18 +++++++++++++++---
 pirates/piratesbase/CollectionMap.py | 23 ++++++++++++++++++++++-
 pirates/uberdog/UberDogGlobals.py    | 20 ++++++++++++++++++++
 3 files changed, 57 insertions(+), 4 deletions(-)

diff --git a/pirates/minigame/FishingResults.py b/pirates/minigame/FishingResults.py
index 50c8134..03f1135 100644
--- a/pirates/minigame/FishingResults.py
+++ b/pirates/minigame/FishingResults.py
@@ -1,6 +1,7 @@
 from pirates.piratesgui.GuiPanel import *
 from pirates.piratesgui.RequestButton import RequestButton
 from pirates.piratesbase import PLocalizer
+from pirates.piratesbase import CollectionMap
 from pirates.minigame import FishingGlobals
 
 class FishingResults(NodePath):
@@ -24,6 +25,8 @@ class FishingResults(NodePath):
         self.fishName = None
         self.fishWeight = None
         self.fishGold = None
+        self.fishIcon = None
+        self.fishPictures = loader.loadModel('models/gui/fish_collection_gui', okMissing=True)
 
     def makeLabel(self, text, scale, pos, fg=None, font=None):
         extra = {}
@@ -35,13 +38,22 @@ class FishingResults(NodePath):
         self.bAgain.destroy()
 
     def showAll(self):
+        if self.fishIcon is not None:
+            self.fishIcon.destroy()
+            self.fishIcon = None
         for label in (self.fishName, self.fishWeight, self.fishGold):
             if label is not None:
                 label.removeNode()
         fish = self.gameObject.fishManager.activeFish
-        self.fishName = self.makeLabel(fish.myData['name'], PiratesGuiGlobals.TextScaleTitleMed, (0.64, 0, 0.95))
-        self.fishWeight = self.makeLabel(str(fish.weight) + ' ' + PLocalizer.FishingGui['WeightLabel'], PiratesGuiGlobals.TextScaleTitleLarge, (0.64, 0, 0.7))
-        self.fishGold = self.makeLabel('+ ' + str(FishingGlobals.getFishGold(fish.myData, fish.weight)) + ' ' + PLocalizer.FishingGui['GoldText'], PiratesGuiGlobals.TextScaleTitleSmall, (0.64, 0, 0.5))
+        self.fishName = self.makeLabel(fish.myData['name'], PiratesGuiGlobals.TextScaleTitleMed, (0.64, 0, 1.04))
+        self.fishWeight = self.makeLabel(str(fish.weight) + ' ' + PLocalizer.FishingGui['WeightLabel'], PiratesGuiGlobals.TextScaleTitleLarge, (0.4, 0, 0.6))
+        self.fishGold = self.makeLabel('+ ' + str(FishingGlobals.getFishGold(fish.myData, fish.weight)) + ' ' + PLocalizer.FishingGui['GoldText'], PiratesGuiGlobals.TextScaleTitleSmall, (0.9, 0, 0.58))
+        picName = CollectionMap.Assets.get(fish.myData['id'])
+        picture = None
+        if picName and self.fishPictures:
+            picture = self.fishPictures.find('**/%s*' % picName)
+        if picture and not picture.isEmpty():
+            self.fishIcon = DirectFrame(parent=self, relief=None, geom=picture, geom_scale=1.0, pos=(0.64, 0, 0.85))
         self.setScale(0.75, 0.75, 0.75)
         self.show()
 

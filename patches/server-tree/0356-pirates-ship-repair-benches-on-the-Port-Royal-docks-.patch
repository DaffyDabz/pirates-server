diff --git a/pirates/minigame/DistributedRepairGameAI.py b/pirates/minigame/DistributedRepairGameAI.py
new file mode 100644
index 0000000..e27493f
--- /dev/null
+++ b/pirates/minigame/DistributedRepairGameAI.py
@@ -0,0 +1,258 @@
+import random
+import time
+
+from direct.directnotify import DirectNotifyGlobal
+from direct.distributed.DistributedObjectAI import DistributedObjectAI
+from pirates.minigame import RepairGlobals
+from pirates.minigame.DistributedRepairGameBase import DistributedRepairGameBase
+from pirates.minigame.DistributedRepairGameBase import GAME_OPEN, GAME_COMPLETE, AT_SEA, ON_LAND
+
+
+class DistributedRepairGameAI(DistributedRepairGameBase, DistributedObjectAI):
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedRepairGameAI')
+
+    def __init__(self, air):
+        DistributedObjectAI.__init__(self, air)
+        DistributedRepairGameBase.__init__(self)
+
+        self.bench = None
+        self.difficulty = 0
+        self.avatar2game = {}
+        self.avatar2timeout = {}
+        self.game2progress = {gameIndex: GAME_OPEN for gameIndex in range(self.getGameCount())}
+        self.cycleStartTime = None
+
+    def delete(self):
+        for avatarId in list(self.avatar2timeout):
+            self.removeTimeout(avatarId)
+
+        DistributedObjectAI.delete(self)
+
+    def setDifficulty(self, difficulty):
+        self.difficulty = difficulty
+
+    def getDifficulty(self):
+        return self.difficulty
+
+    def setLocation(self, location):
+        self.location = location
+
+    def getLocation(self):
+        return self.location
+
+    def setOnLand(self, land):
+        self.setLocation(ON_LAND if land else AT_SEA)
+
+    def isComplete(self):
+        for gameProgress in self.game2progress.values():
+            if gameProgress < GAME_COMPLETE:
+                return False
+
+        return True
+
+    def getPlayerCount(self):
+        return len(self.avatar2timeout)
+
+    def joinGame(self, avatar):
+        avatarId = avatar.doId
+        if avatarId not in self.avatar2timeout and self.getPlayerCount() >= RepairGlobals.AI.maxPlayersPerBench:
+            return False
+
+        self.sendUpdateToAvatarId(avatarId, 'start', [self.location])
+
+        for gameIndex in self.game2progress:
+            self.d_setMincroGameProgress(avatarId, gameIndex, self.game2progress[gameIndex])
+
+        self.addTimeout(avatarId)
+        self.d_setAvIds2CurrentGameListToAll()
+        return True
+
+    def quitGame(self, avatarId):
+        # the pirate left the bench (or was kicked, or logged out): drop them and tell their client to stop
+        if avatarId not in self.avatar2timeout:
+            return False
+
+        self.avatar2game.pop(avatarId, None)
+        self.removeTimeout(avatarId)
+        self.sendUpdateToAvatarId(avatarId, 'stop', [])
+        self._playerLeft()
+        return True
+
+    def playerGone(self, avatarId):
+        # the avatar object is deleted, so there is nobody to send 'stop' to
+        if avatarId not in self.avatar2timeout:
+            return
+
+        self.avatar2game.pop(avatarId, None)
+        self.removeTimeout(avatarId)
+        self._playerLeft()
+
+    def _playerLeft(self):
+        if not self.avatar2timeout:
+            # last pirate gone: the next one starts on a clean bench
+            self.resetGame()
+        else:
+            self.d_setAvIds2CurrentGameListToAll()
+
+    def __timedOut(self, avatarId, task):
+        # sitting at the bench doing nothing for two minutes: send them off so the bench frees up
+        self.avatar2timeout.pop(avatarId, None)
+
+        if self.bench:
+            self.bench.kickUser(avatarId)
+
+        self.avatar2game.pop(avatarId, None)
+        self.sendUpdateToAvatarId(avatarId, 'stop', [])
+        self._playerLeft()
+        return task.done
+
+    def resetGame(self, tellPlayers=True):
+        self.cycleStartTime = None
+
+        for gameIndex in self.game2progress:
+            self.game2progress[gameIndex] = GAME_OPEN
+
+            if tellPlayers:
+                for avatarId in self.avatar2timeout:
+                    self.d_setMincroGameProgress(avatarId, gameIndex, GAME_OPEN)
+
+    def requestMincroGame(self, gameIndex):
+        avatarId = self.air.getAvatarIdFromSender()
+        avatar = self.air.doId2do.get(avatarId)
+
+        if not avatar:
+            self.notify.warning('Failed to requestMincroGame for non-existant avatar!')
+            return
+
+        if avatarId not in self.avatar2timeout or gameIndex not in self.game2progress:
+            self.air.logPotentialHacker(
+                message='Received requestMincroGame from an avatar not at a repair bench or for a bad game',
+                accountId=self.air.getAccountIdFromSender(),
+                targetAvId=avatarId,
+                gameIndex=gameIndex)
+            return
+
+        if self.game2progress[gameIndex] >= GAME_COMPLETE or self.avatar2game.get(avatarId) == gameIndex:
+            # that repair is already done this round, or the pirate is already on it
+            self.d_requestMincroGameResponse(avatarId, False)
+            return
+
+        self.avatar2game[avatarId] = gameIndex
+        self.addTimeout(avatarId)
+
+        self.d_requestMincroGameResponse(avatarId, True)
+        self.d_setAvIds2CurrentGameListToAll()
+
+    def addTimeout(self, avatarId):
+        self.removeTimeout(avatarId)
+
+        self.avatar2timeout[avatarId] = taskMgr.doMethodLater(RepairGlobals.AI.inactiveClientKickTime,
+            self.__timedOut, self.uniqueName('timeout-%d' % avatarId), extraArgs=[avatarId], appendTask=True)
+
+    def removeTimeout(self, avatarId):
+        task = self.avatar2timeout.pop(avatarId, None)
+        if task:
+            taskMgr.remove(task)
+
+    def d_requestMincroGameResponse(self, avatarId, success):
+        self.sendUpdateToAvatarId(avatarId, 'requestMincroGameResponse', [success, self.difficulty])
+
+    def d_setMincroGameProgress(self, avatarId, gameIndex, progress):
+        self.sendUpdateToAvatarId(avatarId, 'setMincroGameProgress', [gameIndex, progress])
+
+    def d_setAvIds2CurrentGameListToAll(self):
+        gameList = list(self.avatar2game.values())
+        avatarList = list(self.avatar2game.keys())
+        for avatarId in self.avatar2timeout:
+            self.sendUpdateToAvatarId(avatarId, 'setAvIds2CurrentGameList', [gameList, avatarList])
+
+    def reportMincroGameScore(self, gameIndex, score):
+        # the client reports a score after some games; the repair cycle does not use it
+        pass
+
+    def reportMincroGameProgress(self, gameIndex, progress, rating):
+        avatarId = self.air.getAvatarIdFromSender()
+        avatar = self.air.doId2do.get(avatarId)
+
+        if not avatar:
+            self.notify.warning('Failed to reportMincroGameProgress for non-existant avatar!')
+            return
+
+        # Check if this player is playing
+        if avatarId not in self.avatar2game:
+            self.air.logPotentialHacker(
+                message='Received reportMincroGameProgress from an avatar not playing a repair minigame',
+                accountId=self.air.getAccountIdFromSender(),
+                targetAvId=avatarId,
+                gameIndex=gameIndex,
+                progress=progress,
+                rating=rating)
+            return
+
+        # Perform gameIndex sanity check
+        if gameIndex != self.avatar2game[avatarId]:
+            self.air.logPotentialHacker(
+                message='Received reportMincroGameProgress from avatar for a game they are not post to be playing',
+                accountId=self.air.getAccountIdFromSender(),
+                targetAvId=avatarId,
+                gameIndex=gameIndex,
+                progress=progress,
+                rating=rating)
+            return
+
+        self.addTimeout(avatarId)
+
+        if self.game2progress[gameIndex] >= GAME_COMPLETE:
+            return
+
+        if self.cycleStartTime is None:
+            self.cycleStartTime = time.time()
+
+        # a finished repair is reported as 100 (GAME_COMPLETE); anything else is partway
+        progress = max(GAME_OPEN, min(GAME_COMPLETE, progress))
+        self.game2progress[gameIndex] = progress
+
+        # Update progress to all players
+        for playerId in self.avatar2timeout:
+            self.d_setMincroGameProgress(playerId, gameIndex, progress)
+
+        if not self.isComplete():
+            return
+
+        self.notify.debug('%s completed the last repair (game %d, rating %s)' % (avatarId, gameIndex, rating))
+        self.cycleComplete()
+
+    def getRewardMultiplier(self):
+        # Novice 1x, Advanced 2x, Master 3x
+        if self.difficulty >= 9:
+            return 3
+        if self.difficulty >= 5:
+            return 2
+        return 1
+
+    def cycleComplete(self):
+        totalTime = 0
+        if self.cycleStartTime is not None:
+            totalTime = max(0, int(time.time() - self.cycleStartTime))
+
+        doIds = []
+        rewards = []
+        for avatarId in list(self.avatar2timeout)[:RepairGlobals.AI.maxPlayersPerBench]:
+            goldReward = random.randint(*RepairGlobals.AI.goldRewardRange) * self.getRewardMultiplier()
+
+            inventory = self.air.inventoryManager.getInventory(avatarId)
+            if inventory:
+                inventory.setGoldInPocket(inventory.getGoldInPocket() + goldReward)
+            else:
+                self.notify.warning('Failed to get inventory for avatar %d!' % avatarId)
+                goldReward = 0
+
+            doIds.append(avatarId)
+            rewards.append(goldReward)
+
+        for avatarId in doIds:
+            self.sendUpdateToAvatarId(avatarId, 'cycleComplete', [self.difficulty, doIds, rewards, totalTime])
+
+        # each client shows the "all fixed" message and then clears its own progress boards,
+        # so the AI clears its side without sending the boards a second time
+        self.resetGame(tellPlayers=False)

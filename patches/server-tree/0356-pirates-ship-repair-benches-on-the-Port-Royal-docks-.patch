+
+    def enterInit(self):
+        self.notify.info("enter%s: '%s' -> '%s'" % (self.newState, self.oldState, self.newState))
+
+    def exitInit(self):
+        self.notify.info("exit%s: '%s' -> '%s'" % (self.oldState, self.oldState, self.newState))

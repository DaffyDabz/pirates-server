diff --git a/pirates/minigame/DistributedPotionCraftingTable.py b/pirates/minigame/DistributedPotionCraftingTable.py
new file mode 100755
index 0000000..dad3589
--- /dev/null
+++ b/pirates/minigame/DistributedPotionCraftingTable.py
@@ -0,0 +1,100 @@
+from direct.interval.IntervalGlobal import *
+from panda3d.core import *
+from pirates.distributed.DistributedInteractive import DistributedInteractive
+from pirates.piratesbase import PLocalizer
+from pirates.piratesgui import PiratesGuiGlobals
+from pirates.effects.PotionTableSmoke import PotionTableSmoke
+
+
+class DistributedPotionCraftingTable(DistributedInteractive):
+    notify = directNotify.newCategory('DistributedPotionCraftingTable')
+    TableModel = 'models/minigames/pir_m_gam_pot_table'
+
+    def __init__(self, cr):
+        DistributedInteractive.__init__(self, cr)
+        self.interactRadius = 15
+        self.diskRadius = 25
+        self.tableModel = None
+        self.effect = None
+        self.gameInterest = None
+        self.potionGame = None
+
+    def generate(self):
+        DistributedInteractive.generate(self)
+        NodePath.__init__(self, 'PotionTable')
+        self.setInteractOptions(proximityText=PLocalizer.CraftPotionInstructions, sphereScale=self.interactRadius, diskRadius=self.diskRadius)
+
+    def announceGenerate(self):
+        DistributedInteractive.announceGenerate(self)
+        # the table is a server-made object (the island art has no table in it), so it brings its own model
+        self.tableModel = loader.loadModel(self.TableModel)
+        self.tableModel.reparentTo(self)
+        self.setAllowInteract(1)
+        self.effect = PotionTableSmoke.getEffect()
+        if self.effect:
+            self.effect.setPos(1.3, 0.1, 3.5)
+            self.effect.setEffectScale(0.25)
+            self.effect.setEffectColor(Vec4(0.6, 0.4, 1.0, 1.0))
+            self.effect.reparentTo(self)
+            self.effect.play()
+
+    def disable(self):
+        av = getattr(base, 'localAvatar', None)
+        if av and self.userId == av.doId:
+            self.stopCrafting()
+
+        DistributedInteractive.disable(self)
+        if self.effect:
+            self.effect.cleanUpEffect()
+            self.effect = None
+
+        if self.tableModel:
+            self.tableModel.removeNode()
+            self.tableModel = None
+
+        self.detachNode()
+
+    def setPotionGame(self, potionGame):
+        self.potionGame = potionGame
+
+    def setParentingRules(self, rule1, rule2):
+        pass
+
+    def requestInteraction(self, avId, interactType=0, instant=0):
+        if localAvatar.isUndead():
+            localAvatar.guiMgr.createWarning(PLocalizer.NoPotionsWhileUndeadWarning, PiratesGuiGlobals.TextFG6)
+        else:
+            DistributedInteractive.requestInteraction(self, avId, interactType, instant)
+
+    def handleEndInteractKey(self):
+        # Escape asks the game screen first (it offers a way out, or the results screen's quit)
+        if self.potionGame:
+            self.potionGame.checkExit()
+        else:
+            self.requestExit()
+
+    def stopCrafting(self):
+        av = getattr(base, 'localAvatar', None)
+        if av and av.getGameState() == 'PotionCrafting':
+            av.b_setGameState(av.gameFSM.defaultState)
+
+    def enterWaiting(self):
+        localAvatar.motionFSM.off()
+        DistributedInteractive.enterWaiting(self)
+
+    def exitWaiting(self):
+        localAvatar.motionFSM.on()
+        DistributedInteractive.exitWaiting(self)
+
+    def enterUse(self):
+        DistributedInteractive.enterUse(self)
+        localAvatar.b_setGameState('PotionCrafting')
+        self.gameInterest = self.cr.addInterest(self.doId, localAvatar.doId, 'potiongame')
+
+    def exitUse(self):
+        if self.gameInterest:
+            self.cr.removeInterest(self.gameInterest)
+            self.gameInterest = None
+
+        self.stopCrafting()
+        DistributedInteractive.exitUse(self)
diff --git a/pirates/minigame/DistributedPotionCraftingTableAI.py b/pirates/minigame/DistributedPotionCraftingTableAI.py
new file mode 100755
index 0000000..77d0052
--- /dev/null
+++ b/pirates/minigame/DistributedPotionCraftingTableAI.py
@@ -0,0 +1,71 @@
+from direct.directnotify import DirectNotifyGlobal
+from pirates.distributed.DistributedInteractiveAI import DistributedInteractiveAI
+from pirates.minigame.DistributedPotionGameAI import DistributedPotionGameAI
+
+
+class DistributedPotionCraftingTableAI(DistributedInteractiveAI):
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedPotionCraftingTableAI')
+    MULTIUSE = True
+
+    def __init__(self, air):
+        DistributedInteractiveAI.__init__(self, air)
+
+        self.potionZone = 0
+        self.avatar2game = {}
+
+    def delete(self):
+        for game in list(self.avatar2game.values()):
+            game.requestDelete()
+
+        self.avatar2game = {}
+        self.ignoreAll()
+        DistributedInteractiveAI.delete(self)
+
+    def handleRequestInteraction(self, avatar, interactType, instant):
+        # a game left over from a pirate who never said goodbye (changed island, lost link) is replaced
+        old = self.avatar2game.pop(avatar.doId, None)
+        if old:
+            old.requestDelete()
+
+        game = DistributedPotionGameAI(self.air)
+        game.setTable(self)
+        game.setAvatar(avatar)
+        game.setColorSet(self.potionZone)
+        game.generateWithRequiredAndId(self.air.allocateChannel(), self.doId, avatar.doId)
+        self.avatar2game[avatar.doId] = game
+
+        # if the pirate logs out at the table, the table has to forget them
+        self.acceptOnce(avatar.getDeleteEvent(), self._userGone, [avatar.doId])
+
+        return self.ACCEPT
+
+    def handleRequestExit(self, avatar):
+        game = self.avatar2game.pop(avatar.doId, None)
+        if not game:
+            return self.DENY
+
+        self.ignore(avatar.getDeleteEvent())
+        game.requestDelete()
+
+        return self.ACCEPT
+
+    def _userGone(self, avatarId):
+        game = self.avatar2game.pop(avatarId, None)
+        if game:
+            game.requestDelete()
+
+    def checkExit(self):
+        # asks the pirate's own game screen to offer the way out
+        avatarId = self.air.getAvatarIdFromSender()
+        game = self.avatar2game.get(avatarId)
+        if game:
+            game.sendUpdateToAvatarId(avatarId, 'checkExit', [])
+
+    def setParentingRules(self, rule1, rule2):
+        pass
+
+    def setPotionZone(self, potionZone):
+        self.potionZone = potionZone
+
+    def getPotionZone(self):
+        return self.potionZone
diff --git a/pirates/minigame/DistributedPotionGame.py b/pirates/minigame/DistributedPotionGame.py
new file mode 100755
index 0000000..20a0624
--- /dev/null
+++ b/pirates/minigame/DistributedPotionGame.py
@@ -0,0 +1,132 @@
+from direct.interval.IntervalGlobal import *
+from direct.distributed.DistributedObject import DistributedObject
+from direct.directnotify import DirectNotifyGlobal
+from panda3d.core import *
+from pirates.minigame import PotionRecipeData
+from pirates.minigame.PotionGame import PotionGame
+
+
+class DistributedPotionGame(DistributedObject):
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedPotionGame')
+
+    def __init__(self, cr):
+        DistributedObject.__init__(self, cr)
+        self.colorSet = 0
+        self.fadeTime = 0.1
+        self.fadeTask = None
+        self.xpBonus = 0
+        self.potionGame = None
+        self.table = None
+        self.gone = False
+
+    def setColorSet(self, colorSet):
+        if colorSet >= len(PotionRecipeData.PotionColorSets):
+            colorSet = 0
+
+        self.colorSet = colorSet
+
+    def setXpBonus(self, xpBonusAmt):
+        # the gold the soul bonuses have paid so far
+        self.xpBonus = xpBonusAmt
+        if self.potionGame:
+            self.potionGame.updateResultsScreen()
+
+    def getXpBonus(self):
+        return self.xpBonus
+
+    def announceGenerate(self):
+        DistributedObject.announceGenerate(self)
+        self.table = self.getParentObj()
+        if self.table:
+            self.table.setPotionGame(self)
+
+        self.fadeTask = taskMgr.doMethodLater(1, self.fadeIn, 'potionfade', extraArgs=[])
+
+    def disable(self):
+        self.gone = True
+        if self.fadeTask:
+            taskMgr.remove(self.fadeTask)
+            self.fadeTask = None
+
+        # the server took the game away (the table went, the link dropped): the screen goes with it
+        game = self.potionGame
+        self.potionGame = None
+        if game:
+            game.destroy()
+
+        if self.table:
+            self.table.setPotionGame(None)
+            self.table = None
+
+        DistributedObject.disable(self)
+
+    def fadeOut(self):
+        base.transitions.setFadeColor(0, 0, 0)
+        if not base.transitions.fadeOutActive():
+            base.transitions.fadeOut(self.fadeTime)
+
+    def fadeIn(self):
+        self.fadeTask = None
+        if self.gone:
+            return
+
+        self.potionGame = PotionGame(self)
+        base.cr.loadingScreen.hide()
+        base.transitions.fadeIn(self.fadeTime)
+
+    def done(self, forceFinish=False):
+        if self.gone:
+            return
+
+        if base.transitions.fadeOutActive() and not forceFinish:
+            self.loadingSequence = Sequence(Func(self.fadeOut), Wait(self.fadeTime), Func(self.d_finish))
+            self.loadingSequence.start()
+        else:
+            self.d_finish()
+
+    def d_completeRecipe(self, recipeID, clearNewFlag):
+        if not self.gone:
+            self.sendUpdate('completeRecipe', [recipeID, clearNewFlag])
+
+    def d_completeSurvival(self, ingredients, tiles):
+        if not self.gone:
+            self.sendUpdate('completeSurvival', [ingredients, tiles])
+
+    def d_claimXPBonus(self, bonusLevel):
+        if not self.gone:
+            self.sendUpdate('claimXPBonus', [max(0, min(bonusLevel, 17))])
+
+    def d_setHintsActive(self, active):
+        if not self.gone:
+            self.sendUpdate('setHintsActive', [active])
+
+    def d_finish(self):
+        if not self.gone:
+            self.sendUpdate('finish')
+
+    def d_reset(self):
+        if not self.gone:
+            self.sendUpdate('reset')
+
+    def exit(self):
+        # the game screen is over: the table lets the pirate go
+        self.potionGame = None
+        if self.table and not self.gone:
+            self.table.requestExit()
+
+    def checkExit(self):
+        # Escape, or the server asking: the way out is offered, never forced
+        game = self.potionGame
+        if not game or not game.gameFSM:
+            return
+
+        if game.gameFSM.getCurrentOrNextState() in ['Results'] and game.resultsScreen:
+            game.resultsScreen.quit()
+        else:
+            game.confirmQuit()
+
+    def getPlayerNotNewFlags(self):
+        return []
+
+    def getPlayerPotionLevel(self):
+        return len(PotionRecipeData.PotionRecipeList)
diff --git a/pirates/minigame/DistributedPotionGameAI.py b/pirates/minigame/DistributedPotionGameAI.py
new file mode 100755
index 0000000..b37ebef
--- /dev/null
+++ b/pirates/minigame/DistributedPotionGameAI.py
@@ -0,0 +1,186 @@
+import time
+
+from direct.directnotify import DirectNotifyGlobal
+from direct.distributed.DistributedObjectAI import DistributedObjectAI
+from pirates.minigame import PotionGlobals
+from pirates.minigame import PotionRecipeData
+
+
+class DistributedPotionGameAI(DistributedObjectAI):
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedPotionGameAI')
+
+    # a brew cannot honestly be finished faster than this, so a client that reports one sooner is not paid
+    MIN_RECIPE_SECONDS = 20.0
+    # a soul match bonus cannot honestly come faster than this after the last one
+    MIN_BONUS_SECONDS = 6.0
+    MAX_BONUS_LEVEL = 17
+
+    def __init__(self, air):
+        DistributedObjectAI.__init__(self, air)
+
+        self.colorSet = 0
+        self.table = None
+        self.avatarId = 0
+        self.xpBonus = 0
+
+        self.__workingRecipe = -1
+        self.__numIngredients = 0
+        self.__lastReset = time.time()
+        self.__lastBonus = 0.0
+
+    def setColorSet(self, colorSet):
+        self.colorSet = colorSet
+
+    def getColorSet(self):
+        return self.colorSet
+
+    def setTable(self, table):
+        self.table = table
+
+    def getTable(self):
+        return self.table
+
+    def setAvatar(self, avatar):
+        self.avatarId = avatar.doId
+
+    def getAvatarId(self):
+        return self.avatarId
+
+    def delete(self):
+        self.table = None
+        DistributedObjectAI.delete(self)
+
+    def __verifySender(self):
+        sender = self.air.getAvatarIdFromSender()
+        verified = sender == self.avatarId
+        if not verified:
+            self.notify.warning('Received update from an unexpected avatar (%d); Expected %d' % (sender, self.avatarId))
+
+            self.air.logPotentialHacker(
+                message='Received update from an unexpected avatar while playing Potions.',
+                targetAvId=sender,
+                expected=self.avatarId)
+
+        return verified
+
+    def __resetRecipe(self):
+        self.__workingRecipe = -1
+        self.__numIngredients = 0
+        self.__lastReset = time.time()
+
+    def __giveGold(self, gold):
+        inventory = self.air.inventoryManager.getInventory(self.avatarId)
+        if not inventory:
+            self.notify.warning('Failed to get inventory for avatar %d!' % self.avatarId)
+            return False
+
+        inventory.setGoldInPocket(inventory.getGoldInPocket() + gold)
+        return True
+
+    def completeRecipe(self, recipeId, clearNewFlag):
+        if not self.__verifySender():
+            return
+
+        if self.__workingRecipe == -1:
+            if not PotionRecipeData.getPotionData(recipeId):
+                self.notify.warning('Received complete Recipe for an invalid recipe %d!' % recipeId)
+
+                self.air.logPotentialHacker(
+                    message='Received complete Recipe for an invalid recipe.',
+                    targetAvId=self.avatarId,
+                    recipeId=recipeId)
+
+                return
+
+            self.__workingRecipe = recipeId
+
+        # Is this still the same recipe?
+        elif self.__workingRecipe != recipeId:
+            self.notify.warning('Attempted to complete recipe that has not been started!')
+
+            self.air.logPotentialHacker(
+                message='Attempted to complete recipe that has not been started!',
+                targetAvId=self.avatarId,
+                recipeId=recipeId)
+
+            return
+
+        self.__numIngredients += 1
+
+        if self.__numIngredients < PotionRecipeData.getNumIngredients(recipeId):
+            return
+
+        # Perform disabled potion sanity check
+        if PotionRecipeData.getDisabled(recipeId):
+            self.notify.warning('%d completed a disabled potion recipe! (%d)' % (self.avatarId, recipeId))
+
+            self.air.logPotentialHacker(
+                message='Attempted to complete a disabled recipe!',
+                targetAvId=self.avatarId,
+                recipeId=recipeId)
+
+            self.__resetRecipe()
+            return
+
+        sinceReset = time.time() - self.__lastReset
+        if sinceReset < self.MIN_RECIPE_SECONDS:
+            self.notify.warning('%d finished recipe %d in %.1f seconds; no gold for that' % (self.avatarId, recipeId, sinceReset))
+            self.__resetRecipe()
+            return
+
+        gold = PotionGlobals.getPotionGold(recipeId)
+        self.notify.debug('%s completed recipe %d! (%d gold)' % (self.avatarId, recipeId, gold))
+        self.__giveGold(gold)
+        self.__resetRecipe()
+
+    def claimXPBonus(self, bonusLevel):
+        if not self.__verifySender():
+            return
+
+        if bonusLevel > self.MAX_BONUS_LEVEL:
+            self.air.logPotentialHacker(
+                message='Claimed a potion bonus that does not exist.',
+                targetAvId=self.avatarId,
+                bonusLevel=bonusLevel)
+
+            return
+
+        now = time.time()
+        if now - self.__lastBonus < self.MIN_BONUS_SECONDS:
+            return
+
+        gold = PotionGlobals.getBonusGold(bonusLevel)
+        if gold <= 0 or not self.__giveGold(gold):
+            return
+
+        self.__lastBonus = now
+        self.xpBonus += gold
+        self.d_setXpBonus(self.xpBonus)
+
+    def setXpBonus(self, xpBonus):
+        self.xpBonus = xpBonus
+
+    def d_setXpBonus(self, xpBonus):
+        self.sendUpdate('setXpBonus', [xpBonus])
+
+    def getXpBonus(self):
+        return self.xpBonus
+
+    def completeSurvival(self, ingredients, tiles):
+        # none of this base's recipes is a survival recipe, so there is nothing to pay
+        self.__verifySender()
+
+    def setHintsActive(self, active):
+        self.__verifySender()
+
+    def reset(self):
+        if not self.__verifySender():
+            return
+
+        self.__resetRecipe()
+
+    def finish(self):
+        if not self.__verifySender():
+            return
+
+        self.__resetRecipe()

+        self.testConnection(gameBoard, self.column + 1, self.row)
+        self.testConnection(gameBoard, self.column - 1, self.row)
+        if self.column % 2 == 0:
+            self.testConnection(gameBoard, self.column - 1, self.row + 1)
+            self.testConnection(gameBoard, self.column + 1, self.row + 1)

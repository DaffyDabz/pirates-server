+"""Constants and gold values for the potion crafting game (the original game's potion buffs and reputation are not part
+of this base; a finished brew pays gold instead)."""
+
+TextColor = (0.28, 0.23, 0.17, 1.0)
+TextColorDisabled = (0.58, 0.49, 0.32, 1.0)
+TextColorHighlight = (0.23, 0.28, 0.17, 1.0)
+BONUS_XP_AMT = [10, 30, 60, 100, 150, 210, 280, 360, 450, 550, 660, 780, 910, 1050, 1200, 1360, 1530, 1710, 1900, 2100]
+
+
+def getPotionGold(recipeId):
+    """Gold for finishing a recipe once: more for the harder, longer ones."""
+    from pirates.minigame import PotionRecipeData
+    data = PotionRecipeData.getPotionData(recipeId)
+    if not data:
+        return 0
+    return 10 + 4 * data['level'] + 6 * len(data['ingredients'])
+
+
+def getBonusGold(bonusLevel):
+    """Gold for a soul-match bonus (the original paid reputation for it)."""
+    if bonusLevel < 0 or bonusLevel >= len(BONUS_XP_AMT):
+        return 0
+    return max(1, BONUS_XP_AMT[bonusLevel] // 20)

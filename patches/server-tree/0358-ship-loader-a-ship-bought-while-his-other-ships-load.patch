+            taskMgr.remove(askTaskName)
             if not activated:
                 self.air.sendActivate(doId, 0, 0, dclass, fields)
             then()
 
+        def _askAgain(task):
+            if answered or self.done:
+                return task.done
+            self.air.getActivated(doId, _gotActivated)
+            return task.again
+
         self.air.getActivated(doId, _gotActivated)
+        taskMgr.doMethodLater(self.ASK_AGAIN, _askAgain, askTaskName)
 
     def setOwnerAgain(self, doId, channel):

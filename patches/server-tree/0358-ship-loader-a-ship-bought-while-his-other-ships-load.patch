@@ -20,6 +26,15 @@ class ShipLoaderOperationFSM(FSM):
         self.air = air
         self.avatarId = avatarId
         self.callback = callback
+        self.done = False
+        self.timeoutTaskName = 'shipLoaderTimeout-%d-%d' % (avatarId, id(self))
+        taskMgr.doMethodLater(self.TIMEOUT, self._timedOut, self.timeoutTaskName)

+        if not self.pendingShipparts:
+            self.cleanup(True)
+
     def loadShippart(self, shippartDoId):
         self.pendingShipparts.append(shippartDoId)
         self.air.dbInterface.queryObject(self.air.dbId,
@@ -402,12 +428,31 @@ class ActivateShipFSM(ShipLoaderOperationFSM):
         # sendActivate chases it with a move to (0, 0), and the state server then drops the AI from the ship

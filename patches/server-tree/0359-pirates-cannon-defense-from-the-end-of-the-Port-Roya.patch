index 0000000..41bed62
--- /dev/null
+++ b/pirates/minigame/DistributedDefendWorldAI.py
@@ -0,0 +1,586 @@
+import math
+import time
+
+from direct.directnotify import DirectNotifyGlobal
+from direct.task import Task
+
+from pirates.minigame import DefendGlobals
+from pirates.piratesbase import PiratesGlobals
+from pirates.ship import ShipGlobals
+from pirates.treasuremap.DistributedTreasureMapInstanceAI import DistributedTreasureMapInstanceAI
+
+
+class DistributedDefendWorldAI(DistributedTreasureMapInstanceAI):
+    """
+    The private copy of the cannon island a pirate is taken to from Port Royal.
+
+    It is a treasure map instance on purpose: DistributedGameAreaAI._isBlackPearlInstance tells those from the main
+    world by that class, and pirates inside one are not put through the main world's grid zone handling.
+
+    Four cannons stand on the cliff. Waves of raider ships sail in on the island's sea roads, up to the gold pile,
+    grab some gold and sail away again. The raiders are plain enemy ships moved by this class along the roads (the
+    ships' own steering finds its own way, not the island's roads); the cannons are the ones every island has.
+    """
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedDefendWorldAI')
+    notify.setInfo(True)
+
+    SETUP_DELAY = 2.0
+    MONITOR_INTERVAL = 5.0     # how often to look for an empty instance
+    EMPTY_GRACE_TIME = 60.0    # an instance nobody is inside is torn down after this long
+    MOVE_INTERVAL = 0.2        # how often the raiders are moved and their position sent
+    TURN_RATE = 90.0           # degrees a second a raider turns at a bend of its road
+
+    def __init__(self, air):
+        DistributedTreasureMapInstanceAI.__init__(self, air)
+
+        self.fileName = DefendGlobals.WORLD_FILE
+        self.type = PiratesGlobals.INSTANCE_TM
+
+        # ready state for teleporting, as the Black Pearl instance has it
+        self.isReady = False
+        self.pendingTeleportCallbacks = []
+        self.tornDown = False
+        self.lastActivity = time.time()
+        self.insideCount = 0
+
+        self.cannons = []
+
+        # the fight
+        self.phase = DefendGlobals.PHASE_LOBBY
+        self.wave = 0
+        self.phaseEnds = None
+        self.nextSpawn = 0.0
+        self.roadCounter = 0
+        self.queue = []
+        self.raiders = []
+        self.goldLeft = DefendGlobals.START_GOLD
+        self.shipsSunk = 0
+        self.sunkKinds = []
+        self.won = False
+        self.reward = 0
+        self.paid = set()
+        self.lastMove = None
+        self.lastSent = None
+
+    def _now(self):
+        return time.time()
+
+    # ------------------------------------------------------------------ set up and tear down
+
+    def announceGenerate(self):
+        DistributedTreasureMapInstanceAI.announceGenerate(self)
+        self.notify.info('DistributedDefendWorldAI generated with doId %d' % self.doId)
+        taskMgr.doMethodLater(self.SETUP_DELAY, self._setupInstance, self.uniqueName('setupInstance'))
+
+    def _setupInstance(self, task):
+        island = self._getIsland()
+        if island:
+            self._createCannons(island)
+        else:
+            self.notify.warning('Could not find the cannon island - no cannons')
+
+        self.isReady = True
+        self.lastActivity = self._now()
+        self.lastMove = self._now()
+        taskMgr.doMethodLater(self.MONITOR_INTERVAL, self._monitorPlayers, self.uniqueName('monitorPlayers'))
+        taskMgr.doMethodLater(DefendGlobals.TICK, self._tickTask, self.uniqueName('defendTick'))
+        taskMgr.doMethodLater(self.MOVE_INTERVAL, self._moveTask, self.uniqueName('defendMove'))
+        self.notify.info('Cannon defense instance %d is ready (%d cannons)' % (self.doId, len(self.cannons)))
+        for callback in self.pendingTeleportCallbacks:
+            callback()
+
+        self.pendingTeleportCallbacks = []
+        return Task.done
+
+    def _getIsland(self):
+        islandDoId = self.air.uidMgr.getDoId(DefendGlobals.ISLAND_UID)
+        if islandDoId:
+            return self.air.doId2do.get(islandDoId)
+
+        return None
+
+    def _createCannons(self, island):
+        """The four cannons on the cliff. They go in the island's always-seen zone, as the Black Pearl forts do: a
+        pirate inside an instance is not put in the island's grid cells, so a cannon in a cell is never seen."""
+        from pirates.battle.DistributedFortCannonAI import DistributedFortCannonAI
+
+        for index, (uid, x, y, z) in enumerate(DefendGlobals.CANNONS):
+            cannon = DistributedFortCannonAI(self.air)
+            cannon.setUniqueId(uid)
+            cannon.setIslandId(island.doId)
+            cannon.setFortId(0)
+            cannon.setCannonIndex(index)
+            island.generateChildWithRequired(cannon, PiratesGlobals.IslandShipDeployerZone)
+            cannon.setPos(island, x, y, z)
+            cannon.setHpr(*DefendGlobals.CANNON_HPR)
+            self.air.uidMgr.addUid(uid, cannon.doId)
+            self.cannons.append(cannon)
+
+    def delete(self):
+        for name in ('setupInstance', 'monitorPlayers', 'defendTick', 'defendMove'):
+            taskMgr.remove(self.uniqueName(name))
+
+        self.pendingTeleportCallbacks = []
+        for record in self.raiders:
+            self._deleteShip(record['ship'])
+
+        self.raiders = []
+        for cannon in self.cannons:
+            try:
+                self.air.uidMgr.removeUid(cannon.getUniqueId())
+                cannon.requestDelete()
+            except Exception as e:
+                self.notify.warning('Could not delete cannon: %r' % (e,))
+
+        self.cannons = []
+        DistributedTreasureMapInstanceAI.delete(self)
+
+    def getSpawnPt(self, area, index=None):
+        """Where a pirate lands: just behind the cannons"""
+        if area == DefendGlobals.ISLAND_UID:
+            return DefendGlobals.SPAWN_PT
+
+        return DistributedTreasureMapInstanceAI.getSpawnPt(self, area, index)
+
+    # ------------------------------------------------------------------ who is in
+
+    def _isInside(self, avatar):
+        """True when the avatar is somewhere under this instance (its island, its areas, its ocean)"""
+        parentId = getattr(avatar, 'parentId', None)
+        for _ in range(10):
+            if not parentId:
+                return False
+
+            if parentId == self.doId:
+                return True
+
+            parent = self.air.doId2do.get(parentId)
+            parentId = getattr(parent, 'parentId', None)
+
+        return False
+
+    def _insidePirates(self):
+        from pirates.pirate.DistributedPlayerPirateAI import DistributedPlayerPirateAI
+        return [obj for obj in list(self.air.doId2do.values())
+                if isinstance(obj, DistributedPlayerPirateAI) and self._isInside(obj)]
+
+    def hasPlayersInside(self):
+        """True when a pirate is inside; also drops the participants who left, logged out or never arrived"""
+        inside = len(self._insidePirates()) > 0
+        self.insideCount = 1 if inside else 0
+        if inside:
+            self.lastActivity = self._now()
+        elif self._now() - self.lastActivity > self.MONITOR_INTERVAL * 2:
+            for avatarId in list(self.participants):
+                self.removeParticipant(avatarId)
+
+        return inside
+
+    def isJoinable(self):
+        """A fight still going takes more pirates; a finished one does not"""
+        if self.tornDown or self.phase not in (DefendGlobals.PHASE_LOBBY, DefendGlobals.PHASE_WAVE,
+                                               DefendGlobals.PHASE_BREAK):
+            return False
+
+        return self.hasPlayersInside() or self._now() - self.lastActivity < self.EMPTY_GRACE_TIME
+
+    def addParticipant(self, avatarId):
+        DistributedTreasureMapInstanceAI.addParticipant(self, avatarId)
+        self.lastActivity = self._now()
+
+    def _monitorPlayers(self, task):
+        if self.tornDown:
+            return Task.done
+
+        if not self.hasPlayersInside():
+            over = self.phase in (DefendGlobals.PHASE_WON, DefendGlobals.PHASE_LOST)
+            if over or self._now() - self.lastActivity > self.EMPTY_GRACE_TIME:
+                self.notify.info('Cannon defense %d (phase %d) is empty, tearing it down' % (self.doId, self.phase))
+                self.teardown()
+                return Task.done
+
+        return Task.again
+
+    def teardown(self):
+        """Delete this instance and everything under it and free its world uids so the next entrance builds a fresh
+        one; callers tear down only an instance nobody is inside."""
+        if self.tornDown:
+            return
+
+        from pirates.instance.DistributedInstanceBaseAI import DistributedInstanceBaseAI
+        self.tornDown = True
+        self.notify.info('Tearing down cannon defense instance %d' % self.doId)
+        for name in ('monitorPlayers', 'defendTick', 'defendMove'):
+            taskMgr.remove(self.uniqueName(name))
+
+        # everything under the instance, found before the delete empties the tables
+        found = set([self.doId])
+        objects = list(self.air.doId2do.values())
+        grew = True
+        while grew:
+            grew = False
+            for obj in objects:
+                if obj.doId not in found and getattr(obj, 'parentId', None) in found:
+                    found.add(obj.doId)
+                    grew = True
+
+        # its world uids stay taken until freed: the next start would be handed this instance's old objects
+        uidMgr = self.air.uidMgr
+        for uid, doId in list(uidMgr.uid2doId.items()):
+            if doId in found:
+                taskMgr.remove('uidCallback-' + uid)
+                uidMgr.removeUid(uid)
+
+        for uid, obj in list(uidMgr.uid2obj.items()):
+            if getattr(obj, 'doId', None) in found:
+                uidMgr.removeUidObj(uid)
+
+        # the world creator and the ship manager follow the newest world: point them back at the main world
+        mainWorld = None
+        for obj in objects:
+            if isinstance(obj, DistributedInstanceBaseAI) and obj.doId not in found \
+                    and obj.getType() == PiratesGlobals.INSTANCE_MAIN:
+                mainWorld = obj
+                break
+
+        if mainWorld is not None:
+            if self.air.worldCreator.world is self:
+                self.air.worldCreator.world = mainWorld
+
+            if self.air.shipManager.world is self:
+                self.air.shipManager.world = mainWorld
+
+        self.requestDelete()
+
+    # ------------------------------------------------------------------ what the clients are told
+
+    def getDefendState(self):
+        """[phase, wave, secondsLeft, shipsLeft, shipsSunk, goldLeft], the setDefendState field"""
+        seconds = 0
+        if self.phaseEnds is not None:
+            seconds = int(max(0, math.ceil(self.phaseEnds - self._now())))
+
+        return [self.phase, min(255, self.wave), min(65535, seconds), min(65535, self.shipsLeft()),
+                min(65535, self.shipsSunk), max(0, self.goldLeft)]
+
+    def shipsLeft(self):
+        """Raiders still to set sail, plus the raiders on their way to the gold"""
+        return len(self.queue) + len([r for r in self.raiders if r['state'] == 'sailing' and not r['stole']
+                                      and not r['retreat']])
+
+    def d_setDefendState(self):
+        state = self.getDefendState()
+        if state != self.lastSent:
+            self.lastSent = state
+            self.sendUpdate('setDefendState', state)
+
+    def d_setDefendResult(self, won, shipsSunk, goldKept, goldReward):
+        self.sendUpdate('setDefendResult', [1 if won else 0, min(65535, shipsSunk), max(0, goldKept), goldReward])
+
+    # ------------------------------------------------------------------ the clock
+
+    def _tickTask(self, task):
+        if self.tornDown:
+            return Task.done
+
+        self.step(self._now())
+        return Task.again
+
+    def _moveTask(self, task):
+        if self.tornDown:
+            return Task.done
+
+        now = self._now()
+        dt = now - self.lastMove if self.lastMove is not None else self.MOVE_INTERVAL
+        self.lastMove = now
+        self.moveRaiders(min(dt, 1.0))
+        return Task.again
+
+    def step(self, now):
+        """One second of the fight: the phase clock, the spawns, the sinks, the end"""
+        if self.tornDown:
+            return
+
+        phase = self.phase
+        if phase == DefendGlobals.PHASE_LOBBY:
+            # the clock starts when the first pirate is inside, and no raider sails before then
+            if self.phaseEnds is None:
+                if len(self._insidePirates()) > 0:
+                    self.phaseEnds = now + DefendGlobals.LOBBY_SECONDS
+                    self.lastActivity = now
+            elif now >= self.phaseEnds:
+                self._startWave(now)
+        elif phase == DefendGlobals.PHASE_WAVE:
+            self._stepWave(now)
+        elif phase == DefendGlobals.PHASE_BREAK:
+            if now >= self.phaseEnds:
+                self.wave += 1
+                self._startWave(now)
+        else:
+            self._stepResult(now)
+
+        self.d_setDefendState()
+
+    def _startWave(self, now):
+        self.phase = DefendGlobals.PHASE_WAVE
+        self.queue = DefendGlobals.waveShipKinds(self.wave)
+        self.nextSpawn = now
+        self.phaseEnds = now + DefendGlobals.WAVE_MAX_SECONDS
+        self.notify.info('Cannon defense %d: wave %d, %d raiders' % (self.doId, self.wave + 1, len(self.queue)))
+
+    def _stepWave(self, now):
+        if self.queue and now >= self.nextSpawn:
+            self._spawnRaider(self.queue.pop(0))
+            self.nextSpawn = now + DefendGlobals.SPAWN_GAP
+
+        if now >= self.phaseEnds:
+            # a wave that drags on is over: the raiders left sail away without grabbing more, and the ones that
+            # have not set sail stay home
+            self.queue = []
+            for record in self.raiders:
+                record['retreat'] = True
+
+        self._countSunk()
+        if self.goldLeft <= 0:
+            self._finish(False, now)
+            return
+
+        if not self.queue and self.shipsLeft() == 0:
+            if self.wave + 1 >= len(DefendGlobals.WAVES):
+                self._finish(True, now)
+            else:
+                self.phase = DefendGlobals.PHASE_BREAK
+                self.phaseEnds = now + DefendGlobals.BREAK_SECONDS
+
+    def _finish(self, won, now):
+        self.won = won
+        self.phase = DefendGlobals.PHASE_WON if won else DefendGlobals.PHASE_LOST
+        self.phaseEnds = now + DefendGlobals.RESULT_SECONDS
+        self.queue = []
+        for record in list(self.raiders):
+            if record['state'] == 'sailing':
+                self._removeRaider(record)
+
+        self._countSunk()
+        self.reward = DefendGlobals.rewardFor(self.sunkKinds, self.goldLeft, won)
+        self.notify.info('Cannon defense %d is over: %s, %d ships sunk, %d gold left, reward %d' % (
+            self.doId, 'won' if won else 'lost', self.shipsSunk, self.goldLeft, self.reward))
+        self._payEveryone()
+        self.d_setDefendResult(won, self.shipsSunk, self.goldLeft, self.reward)
+
+    def _stepResult(self, now):
+        if now >= self.phaseEnds:
+            for avatar in self._insidePirates():
+                self.removeParticipant(avatar.doId)
+                self._sendAvatarToMainWorld(avatar)
+
+            # nothing left to wait for: the monitor tears the empty instance down
+            self.phaseEnds = now + DefendGlobals.RESULT_SECONDS
+
+    def _payEveryone(self):
+        """The reward goes once to each pirate who is inside when it ends"""
+        for avatar in self._insidePirates():
+            if avatar.doId in self.paid:
+                continue
+
+            self.paid.add(avatar.doId)
+            if self.reward <= 0:
+                continue
+
+            inventory = self.air.inventoryManager.getInventory(avatar.doId)
+            if not inventory:
+                self.notify.warning('No inventory for avatar %d, no reward' % avatar.doId)
+                continue
+
+            inventory.setGoldInPocket(inventory.getGoldInPocket() + self.reward)
+
+    # ------------------------------------------------------------------ the raiders
+
+    def _spawnRaider(self, kind):
+        from pirates.ship.NPCShipAI import NPCShipAI
+
+        spec = DefendGlobals.RAIDERS[kind]
+        hullConfig = ShipGlobals.getHullConfig(spec['shipClass'])
+        if hullConfig is None or not self.oceanGrid:
+            self.notify.warning('No hull config or no ocean for raider %s: skipped' % kind)
+            return None
+
+        road = self.roadCounter % len(DefendGlobals.ROADS)
+        self.roadCounter += 1
+        legs = [DefendGlobals.islandToOcean(x, y) for x, y in DefendGlobals.ROADS[road]]
+        x, y = legs[0]
+        h = self._headingTo(x, y, legs[1][0], legs[1][1])
+
+        ship = NPCShipAI(self.air)
+        # Family fix 0202: this ocean uses main-world numbers, so the starter-waters rule would freeze the ships
+        ship._starterExempt = True
+        # the sinking is paid by this fight, not by the stock sink payout
+        ship._sinkRewarded = True
+        ship.setBaseTeam(ShipGlobals.NAVY_TEAM)
+        ship.setLevel(10)
+        ship.setShipClass(spec['shipClass'])
+        ship.setName(spec['name'])
+        ship.setNPCship(1)
+        ship.setIsBoardable(0)
+        ship.setMaxHp(spec['hp'])
+        ship.setHp(spec['hp'])
+        ship.setMaxSp(hullConfig.get('setMaxSp', [2500])[0])
+        ship.setSp(hullConfig.get('setSp', [2500])[0])
+        ship.setHullCondition(1 << 7)
+
+        zoneId = self.oceanGrid.getZoneFromXYZ((x, y, 0))
+        self.oceanGrid.generateChildWithRequired(ship, zoneId)
+        ship.setPos(self.oceanGrid, x, y, 0)
+        ship.setHpr(h, 0, 0)
+        self.oceanGrid.addObjectToOceanGrid(ship)
+        ship.sendCurrentPosition()
+        # the raiders are moved by this class along the island's roads
+        ship.b_setGameState('ScriptedMovement', 0)
+
+        record = dict(ship=ship, kind=kind, x=x, y=y, h=h, legs=legs, leg=1, road=road, speed=spec['speed'],
+                      mine=DefendGlobals.MINE_INDEX[road], state='sailing', stole=False, stolen=0, retreat=False,
+                      counted=False)
+        self.raiders.append(record)
+        self.notify.info('Cannon defense %d: a %s sets sail on road %d (ship %d)' % (
+            self.doId, kind, road, ship.doId))
+        return record
+
+    @staticmethod
+    def _headingTo(x, y, tx, ty):
+        """Panda heading of a ship at (x, y) sailing to (tx, ty): 0 is +y, turning left (counter-clockwise) adds"""
+        return math.degrees(math.atan2(-(tx - x), ty - y))
+
+    def moveRaiders(self, dt):
+        """Move every raider `dt` seconds along its road, turn it and send its position"""
+        for record in list(self.raiders):
+            if record['state'] != 'sailing':
+                continue
+
+            ship = record['ship']
+            if self._isGone(ship) or self._isSunk(ship):
+                continue
+
+            legs = record['legs']
+            remaining = record['speed'] * dt
+            while remaining > 0 and record['leg'] < len(legs):
+                tx, ty = legs[record['leg']]
+                dx = tx - record['x']
+                dy = ty - record['y']
+                dist = math.hypot(dx, dy)
+                if dist <= remaining:
+                    record['x'] = tx
+                    record['y'] = ty
+                    remaining -= dist
+                    if record['leg'] == record['mine']:
+                        self._steal(record)
+
+                    record['leg'] += 1
+                else:
+                    record['x'] += dx / dist * remaining
+                    record['y'] += dy / dist * remaining
+                    remaining = 0
+
+            if record['leg'] >= len(legs):
+                # the end of the road: it has sailed away
+                self._removeRaider(record)
+                continue
+
+            tx, ty = legs[record['leg']]
+            want = self._headingTo(record['x'], record['y'], tx, ty)
+            turn = ((want - record['h'] + 180.0) % 360.0) - 180.0
+            limit = self.TURN_RATE * dt
+            record['h'] += max(-limit, min(limit, turn))
+            self._placeRaider(record)
+
+    def _placeRaider(self, record):
+        ship = record['ship']
+        try:
+            ship.setPos(self.oceanGrid, record['x'], record['y'], 0)
+            ship.setH(record['h'])
+            zoneId = self.oceanGrid.getZoneFromXYZ((record['x'], record['y'], 0))
+            if zoneId != ship.zoneId and self.oceanGrid.isValidZone(zoneId):
+                self.oceanGrid.handleAvatarZoneChange(ship)
+
+            ship.sendCurrentPosition()
+        except Exception as e:
+            self.notify.warning('Could not place raider %s: %r' % (record['kind'], e))
+
+    def _steal(self, record):
+        """A raider at the gold pile grabs some, once"""
+        if record['stole'] or record['retreat'] or self.phase != DefendGlobals.PHASE_WAVE:
+            return
+
+        record['stole'] = True
+        spec = DefendGlobals.RAIDERS[record['kind']]
+        amount = min(self.goldLeft, spec['steal'])
+        record['stolen'] = amount
+        self.goldLeft -= amount
+        self.notify.info('Cannon defense %d: a %s grabs %d gold, %d left' % (
+            self.doId, record['kind'], amount, self.goldLeft))
+
+    def _isGone(self, ship):
+        try:
+            return ship is None or ship.isDeleted() or ship.air is None
+        except Exception:
+            return True
+
+    def _isSunk(self, ship):
+        """True when the ship has been sunk by the cannons (it deletes itself some seconds later)"""
+        try:
+            hp = ship.getHp()
+            if isinstance(hp, (list, tuple)):
+                hp = hp[0]
+
+            if hp <= 0:
+                return True
+
+            state = getattr(ship, 'gameState', None)
+            if isinstance(state, (list, tuple)):
+                state = state[0]
+
+            return state in ('Sinking', 'Sunk')
+        except Exception:
+            return True
+
+    def _countSunk(self):
+        """Count each raider the cannons sank, once; a raider that has sailed away or been deleted is not one"""
+        for record in self.raiders:
+            if record['counted'] or record['state'] != 'sailing':
+                continue
+
+            ship = record['ship']
+            if self._isSunk(ship) and not (record['leg'] >= len(record['legs'])):
+                record['counted'] = True
+                record['state'] = 'sunk'
+                self.shipsSunk += 1
+                self.sunkKinds.append(record['kind'])
+                self.notify.info('Cannon defense %d: a %s is sunk (%d so far)' % (
+                    self.doId, record['kind'], self.shipsSunk))
+
+    def _removeRaider(self, record):
+        """A raider that sailed away, or the fight ended: it goes"""
+        if record['state'] != 'sailing':
+            return
+
+        record['state'] = 'gone'
+        self._deleteShip(record['ship'])
+
+    def _deleteShip(self, ship):
+        try:
+            if not self._isGone(ship):
+                ship.requestDelete()
+        except Exception as e:
+            self.notify.warning('Could not delete raider: %r' % (e,))
+
+    # ------------------------------------------------------------------ what the clients ask
+
+    def requestLeave(self):
+        """A pirate leaves for Port Royal (the end panel's button)"""
+        avatarId = self.air.getAvatarIdFromSender()
+        if not avatarId:
+            return
+
+        self.removeParticipant(avatarId)
+        avatar = self.air.doId2do.get(avatarId)
+        if avatar:
+            self._sendAvatarToMainWorld(avatar)

@@ -0,0 +1,191 @@
+import random
+from direct.gui.DirectGui import DirectLabel
+from panda3d.core import NodePath, TextNode
+from pirates.instance.DistributedInstanceWorld import DistributedInstanceWorld
+from pirates.minigame import DefendGlobals
+from pirates.piratesbase import PiratesGlobals
+from pirates.piratesgui import PiratesGuiGlobals
+from pirates.piratesgui.GuiPanel import GuiPanel
+from pirates.piratesgui.RequestButton import RequestButton
+
+
+class DefendResultPanel(GuiPanel):
+    """The panel at the end of a cannon defense: how it went, the gold paid, and the way home"""
+
+    def __init__(self, world, won, shipsSunk, goldKept, goldReward):
+        GuiPanel.__init__(self, '', 1.5, 1.0, showClose=False, titleSize=1.5)
+        self.setPos((-0.75, 0, -0.4))
+        self.world = world
+        title = DefendGlobals.WON_TITLE if won else DefendGlobals.LOST_TITLE
+        self.title = DirectLabel(parent=self, relief=None, text=title,
+                                 text_scale=PiratesGuiGlobals.TextScaleTitleJumbo,
+                                 text_font=PiratesGlobals.getPirateOutlineFont(), text_align=TextNode.ACenter,
+                                 text_fg=PiratesGuiGlobals.TextFG1, text_shadow=PiratesGuiGlobals.TextLT14,
+                                 pos=(0.75, 0, 0.8), textMayChange=0)
+        lines = ['Ships sunk: %d' % shipsSunk,
+                 'Gold kept: %d' % goldKept,
+                 'Your reward: %d gold' % goldReward]
+        for i, line in enumerate(lines):
+            DirectLabel(parent=self, relief=None, text=line, text_scale=PiratesGuiGlobals.TextScaleTitleMed,
+                        text_align=TextNode.ACenter, text_fg=PiratesGuiGlobals.TextFG2,
+                        text_shadow=PiratesGuiGlobals.TextShadow, pos=(0.75, 0, 0.58 - i * 0.14),
+                        textMayChange=0)
+
+        self.bLeave = RequestButton(width=1.5, text=DefendGlobals.LEAVE_TEXT, command=self.world.leave)
+        self.bLeave.reparentTo(self)
+        self.bLeave.setPos(0.6, 0, 0.05)
+        self.bLeave.setScale(1.2, 1.2, 1.2)
+
+    def destroy(self):
+        self.bLeave.destroy()
+        GuiPanel.destroy(self)
+
+
+class DistributedDefendWorld(DistributedInstanceWorld):
+    """
+    The client half of a cannon defense: the private copy of the cannon island. It keeps the heap of gold on
+    the beach in step with what is left, and shows the wave, the ships and the gold on top of the screen. The
+    cannons and the ships are ordinary objects of the island.
+    """
+    notify = directNotify.newCategory('DistributedDefendWorld')
+
+    # POR's own spots for the ten heaps on the beach (world numbers) and the order they shrink in
+    PILE_ORDER = (5, 3, 7, 6, 4, 1, 9, 2, 8, 0)
+    PILE_MODEL = 'models/minigames/pir_m_gam_can_goldPile'
+
+    def __init__(self, cr):
+        DistributedInstanceWorld.__init__(self, cr)
+        self.state = [DefendGlobals.PHASE_LOBBY, 0, 0, 0, 0, DefendGlobals.START_GOLD]
+        self.piles = []
+        self.hudText = None
+        self.helpText = None
+        self.leaveButton = None
+        self.resultPanel = None
+        self.shipVisibilitySet = False
+
+    def generate(self):
+        DistributedInstanceWorld.generate(self)
+        # the raiders sail past a long way out: show every ship, not only the near ones
+        base.setOverrideShipVisibility(True)
+        self.shipVisibilitySet = True
+
+    def announceGenerate(self):
+        DistributedInstanceWorld.announceGenerate(self)
+        self.makePiles()
+        self.makeHud()
+        self.refresh()
+
+    def disable(self):
+        self.destroyHud()
+        self.removePiles()
+        if self.shipVisibilitySet:
+            self.shipVisibilitySet = False
+            try:
+                base.setOverrideShipVisibility(False)
+            except (AttributeError, NameError):
+                base.overrideShipVisibility = False
+
+        DistributedInstanceWorld.disable(self)
+
+    def delete(self):
+        self.destroyHud()
+        self.removePiles()
+        DistributedInstanceWorld.delete(self)
+
+    # --- what the world tells us ---
+    def setDefendState(self, phase, wave, secondsLeft, shipsLeft, shipsSunk, goldLeft):
+        self.state = [phase, wave, secondsLeft, shipsLeft, shipsSunk, goldLeft]
+        self.refresh()
+
+    def setDefendResult(self, won, shipsSunk, goldKept, goldReward):
+        self.destroyResult()
+        self.resultPanel = DefendResultPanel(self, won, shipsSunk, goldKept, goldReward)
+        self.resultPanel.show()
+
+    def leave(self):
+        self.sendUpdate('requestLeave')
+
+    # --- the heaps of gold ---
+    def makePiles(self):
+        self.removePiles()
+        for i in range(10):
+            pile = loader.loadModel(self.PILE_MODEL)
+            pile.setScale(3.0, 3.0, 9.0)
+            pile.setPos(660.0 + i * 30.0 + i % 2 * 10, -465.0 - i % 2 * 30.0, 25.0 - i % 2 * 5.0)
+            pile.setHpr(random.random() * 360, 0, 0)
+            pile.reparentTo(self)
+            pile.setLightOff()
+            self.piles.append(pile)
+
+    def removePiles(self):
+        for pile in self.piles:
+            pile.removeNode()
+
+        self.piles = []
+
+    def setPileSizes(self, goldLeft):
+        """Ten heaps: each holds a tenth of the starting gold; the one the gold runs down in is partly shrunk"""
+        tenth = DefendGlobals.START_GOLD / 10.0
+        for i in range(len(self.piles)):
+            pile = self.piles[self.PILE_ORDER[i]]
+            if goldLeft > (i + 1) * tenth:
+                pile.unstash()
+                pile.setScale(3.0, 3.0, 3.0)
+            elif goldLeft > i * tenth:
+                pile.unstash()
+                part = (goldLeft - i * tenth) / DefendGlobals.START_GOLD
+                pile.setScale(1.0 + 20.0 * part, 1.0 + 20.0 * part, 0.5 + 25.0 * part)
+            else:
+                pile.stash()
+
+    # --- the screen ---
+    def makeHud(self):
+        self.destroyHud()
+        self.hudText = DirectLabel(parent=base.a2dTopCenter, relief=None, text='',
+                                   text_scale=PiratesGuiGlobals.TextScaleTitleMed,
+                                   text_font=PiratesGlobals.getPirateOutlineFont(), text_align=TextNode.ACenter,
+                                   text_fg=PiratesGuiGlobals.TextFG1, text_shadow=PiratesGuiGlobals.TextShadow,
+                                   pos=(0, 0, -0.14), textMayChange=1)
+        self.helpText = DirectLabel(parent=base.a2dTopCenter, relief=None, text='',
+                                    text_scale=PiratesGuiGlobals.TextScaleLarge, text_align=TextNode.ACenter,
+                                    text_fg=PiratesGuiGlobals.TextFG2, text_shadow=PiratesGuiGlobals.TextShadow,
+                                    pos=(0, 0, -0.24), textMayChange=1)
+        self.leaveButton = RequestButton(width=0.7, text=DefendGlobals.LEAVE_TEXT, command=self.leave)
+        self.leaveButton.reparentTo(base.a2dBottomRight)
+        self.leaveButton.setPos(-0.85, 0, 0.1)
+
+    def destroyResult(self):
+        if self.resultPanel:
+            self.resultPanel.destroy()
+            self.resultPanel = None
+
+    def destroyHud(self):
+        self.destroyResult()
+        for name in ('hudText', 'helpText', 'leaveButton'):
+            item = getattr(self, name, None)
+            if item:
+                item.destroy()
+                setattr(self, name, None)
+
+    def refresh(self):
+        phase, wave, secondsLeft, shipsLeft, shipsSunk, goldLeft = self.state
+        self.setPileSizes(goldLeft)
+        if not self.hudText:
+            return
+
+        total = len(DefendGlobals.WAVES)
+        if phase == DefendGlobals.PHASE_LOBBY:
+            top = 'Get ready!  First wave in %d' % secondsLeft
+            help = DefendGlobals.HELP_LOBBY
+        elif phase == DefendGlobals.PHASE_WAVE:
+            top = 'Wave %d of %d   Ships left: %d   Gold: %d' % (wave + 1, total, shipsLeft, goldLeft)
+            help = DefendGlobals.HELP_WAVE
+        elif phase == DefendGlobals.PHASE_BREAK:
+            top = 'Wave %d done!  Next wave in %d   Gold: %d' % (wave + 1, secondsLeft, goldLeft)
+            help = DefendGlobals.HELP_BREAK
+        else:
+            top = DefendGlobals.WON_TITLE if phase == DefendGlobals.PHASE_WON else DefendGlobals.LOST_TITLE
+            help = ''
+
+        self.hudText['text'] = top
+        self.helpText['text'] = help
diff --git a/pirates/minigame/DistributedDefendWorldAI.py b/pirates/minigame/DistributedDefendWorldAI.py

+from pirates.minigame import DistributedDefendWorld/AI
 from pirates.creature import DistributedCreature/AI
 from pirates.creature import DistributedAlligator/AI
 from pirates.creature import DistributedBat/AI
@@ -2230,3 +2232,13 @@ dclass DistributedPotionCraftingTable : DistributedInteractive {
   setParentingRules(string, string) broadcast ram;
   checkExit() clsend airecv;
 };
+
+dclass DistributedDefendEntrance : DistributedInteractive {
+  setParentingRules(string, string) broadcast ram;
+};
+
+dclass DistributedDefendWorld : DistributedInstanceWorld {
+  setDefendState(uint8 phase, uint8 wave, uint16 secondsLeft, uint16 shipsLeft, uint16 shipsSunk, uint32 goldLeft) required broadcast ram;
+  setDefendResult(uint8 won, uint16 shipsSunk, uint32 goldKept, uint32 goldReward) broadcast;
+  requestLeave() airecv clsend;
+};

diff --git a/pirates/minigame/DefendGlobals.py b/pirates/minigame/DefendGlobals.py
new file mode 100644
index 0000000..37e2011
--- /dev/null
+++ b/pirates/minigame/DefendGlobals.py
@@ -0,0 +1,133 @@
+"""
+Constants for the Port Royal cannon defense, ported from the original game's cannon island.
+
+A pirate steps onto the entrance on Port Royal and is taken to a private copy of the cannon island. Four
+cannons stand on its cliff. Waves of raider ships sail in from the south, up to a gold pile, grab some gold
+and sail away again. Sink them before they grab it all.
+
+The original game's own wave tables, 12 ship types and 13 kinds of ammunition are a much bigger thing than this
+first version; this file holds the first version's numbers, all of them tunable here.
+"""
+from pirates.ship import ShipGlobals
+
+# --- the cannon island world (pirates/leveleditor/worldData/PortRoyalCannonWorld.py) ---
+WORLD_FILE = 'PortRoyalCannonWorld'
+REGION_UID = '1257979946.82akelts'
+ISLAND_UID = '1257979851.56akelts'
+# where the world file puts the island; the island's own node positions are island-local
+ISLAND_OFFSET = (-57.511, -247.029)
+
+# the four cannons on the cliff: (uid in the island file, island-local x, y, z), all facing east (Hpr 270, 0, 0).
+# The island file's own GridPos for them is stale, so these are the container's position plus each cannon's own
+CANNONS = (
+    ('1259785422.56Bill', 566.0, -532.5, 154.976),
+    ('1259785634.7Bill', 566.0, -517.5, 155.0),
+    ('1259785835.34Bill', 566.0, -502.5, 154.976),
+    ('1259786106.45Bill', 566.637, -547.5, 154.976),
+)
+CANNON_HPR = (270.0, 0.0, 0.0)
+# where a pirate lands when he arrives: x, y, z, heading. Just behind the cannons.
+SPAWN_PT = (537.4, -524.6, 155.5, 270.0)
+
+# --- the ships' sea roads, island-local x, y (the island file's own Spawn / Wait-Point / Mine / Depart nodes) ---
+# each road: from the sea at the south, up to the gold pile (the node marked as the mine), then away to the east.
+# index of the Mine node in each road is MINE_INDEX
+ROADS = (
+    ((567, -936), (668, -837), (736, -761), (786, -716), (813, -650), (825, -546), (819, -478), (801, -417),
+     (795, -384), (813, -350), (844, -333), (879, -331), (917, -349), (958, -407), (1057, -472), (1248, -504),
+     (1602, -546), (1818, -619)),
+    ((771, -986), (863, -886), (922, -715), (950, -576), (984, -374), (1012, -332), (1079, -336), (1120, -374),
+     (1245, -433), (1576, -462), (1731, -402), (1828, -145)),
+    ((1023, -1011), (1047, -849), (1076, -638), (1122, -444), (1138, -359), (1191, -318), (1239, -313),
+     (1302, -354), (1474, -337), (1639, -191)),
+    ((666, -957), (752, -852), (849, -718), (888, -549), (855, -414), (868, -368), (924, -324), (971, -325),
+     (1023, -379), (1105, -425), (1244, -467), (2501, -587)),
+    ((891, -1001), (979, -754), (1053, -418), (1109, -325), (1243, -409), (1348, -588), (1166, -1013),
+     (1231, -1277)),
+)
+MINE_INDEX = (10, 5, 5, 6, 3)
+
+# --- the fight ---
+START_GOLD = 1000
+
+# the kinds of raider: the ship, its name, hit points, speed in units a second, the gold it grabs at the pile and
+# the reward for sinking it. The ship's own stock hit points are thousands; a defense needs hundreds, so they are
+# set here (the island cannon's round shot is measured against them in the AI test).
+RAIDERS = {
+    'small': dict(shipClass=ShipGlobals.NPC_INTERCEPTORL1, name='Cutthroat Sloop', hp=500, speed=70.0,
+                  steal=40, reward=10),
+    'merchant': dict(shipClass=ShipGlobals.NPC_MERCHANTL1, name='Plunder Galleon', hp=900, speed=50.0,
+                     steal=100, reward=20),
+    'warship': dict(shipClass=ShipGlobals.NPC_WARSHIPL1, name='Raider Warship', hp=1600, speed=45.0,
+                    steal=160, reward=40),
+}
+
+# the waves: (raider kind, how many) in the order they set sail
+WAVES = (
+    (('small', 3),),
+    (('small', 4),),
+    (('small', 3), ('merchant', 1)),
+    (('small', 4), ('merchant', 2)),
+    (('merchant', 3), ('warship', 1)),
+    (('merchant', 4), ('warship', 2)),
+)
+
+# --- timing, seconds ---
+LOBBY_SECONDS = 25         # to get to a cannon before the first wave
+BREAK_SECONDS = 12         # between waves
+WAVE_MAX_SECONDS = 180     # a wave that drags on is over: the raiders left sail away without grabbing more
+RESULT_SECONDS = 40        # the result panel, then everyone is sent home
+SPAWN_GAP = 5.0            # between two raiders setting sail
+TICK = 1.0
+
+# --- reward, gold into the pirate's pocket, the same for everyone who took part ---
+REWARD_PER_TEN_GOLD_KEPT = 1   # one gold per ten gold of the pile still there at the end
+WIN_BONUS = 100
+MAX_REWARD = 1000
+
+# --- the phase the world tells its pirates ---
+PHASE_LOBBY = 0
+PHASE_WAVE = 1
+PHASE_BREAK = 2
+PHASE_WON = 3
+PHASE_LOST = 4
+
+# --- words (inline: the original's text is in its own localizer, this version keeps its few words here) ---
+ENTRANCE_TEXT = 'Defend the gold'
+HELP_LOBBY = 'Man a cannon! Raiders are coming for the gold.'
+HELP_WAVE = 'Sink the raiders before they grab the gold!'
+HELP_BREAK = 'Reload! The next wave is coming.'
+WON_TITLE = 'The gold is safe!'
+LOST_TITLE = 'The gold is gone!'
+LEAVE_TEXT = 'Go home'
+
+
+def islandToOcean(x, y):
+    """An island-local point in the instance ocean's own numbers"""
+    return (x + ISLAND_OFFSET[0], y + ISLAND_OFFSET[1])
+
+
+def waveShipCount(wave):
+    """How many raiders wave number `wave` (0-based) sends"""
+    return sum(count for kind, count in WAVES[wave])
+
+
+def waveShipKinds(wave):
+    """The raiders of wave number `wave` (0-based), one kind per ship, in the order they set sail. Smallest first
+    so a pirate has time to find the range."""
+    kinds = []
+    for kind, count in WAVES[wave]:
+        kinds.extend([kind] * count)
+
+    return kinds
+
+
+def rewardFor(sunkKinds, goldLeft, won):
+    """The gold paid to each pirate: the reward of each ship sunk, a tenth of the gold kept, a bonus for holding
+    through every wave. Capped."""
+    reward = sum(RAIDERS[kind]['reward'] for kind in sunkKinds)
+    reward += (max(0, goldLeft) // 10) * REWARD_PER_TEN_GOLD_KEPT
+    if won:
+        reward += WIN_BONUS
+
+    return min(MAX_REWARD, reward)
diff --git a/pirates/minigame/DistributedDefendEntrance.py b/pirates/minigame/DistributedDefendEntrance.py
new file mode 100644
index 0000000..f091ca3
--- /dev/null
+++ b/pirates/minigame/DistributedDefendEntrance.py
@@ -0,0 +1,43 @@
+from panda3d.core import NodePath
+from pirates.distributed.DistributedInteractive import DistributedInteractive
+from pirates.minigame import DefendGlobals
+
+
+class DistributedDefendEntrance(DistributedInteractive):
+    """The heap of gold on Port Royal: step up to it to defend it from raiders"""
+    notify = directNotify.newCategory('DistributedDefendEntrance')
+    PileModel = 'models/minigames/pir_m_gam_can_goldPile'
+
+    def __init__(self, cr):
+        DistributedInteractive.__init__(self, cr)
+        self.interactRadius = 10
+        self.diskRadius = 20
+        self.pileModel = None
+
+    def generate(self):
+        DistributedInteractive.generate(self)
+        NodePath.__init__(self, 'DefendEntrance')
+        self.setInteractOptions(proximityText=DefendGlobals.ENTRANCE_TEXT, sphereScale=self.interactRadius,
+                                diskRadius=self.diskRadius)
+
+    def announceGenerate(self):
+        DistributedInteractive.announceGenerate(self)
+        # a server-made object (the island art has none), so it brings its own model
+        self.pileModel = loader.loadModel(self.PileModel)
+        self.pileModel.setScale(1.5, 1.5, 3.0)
+        self.pileModel.reparentTo(self)
+        self.setAllowInteract(1)
+
+    def disable(self):
+        DistributedInteractive.disable(self)
+        if self.pileModel:
+            self.pileModel.removeNode()
+            self.pileModel = None
+
+        self.detachNode()
+
+    def setParentingRules(self, rule1, rule2):
+        pass
+
+    def handleEndInteractKey(self):
+        self.requestExit()
diff --git a/pirates/minigame/DistributedDefendEntranceAI.py b/pirates/minigame/DistributedDefendEntranceAI.py
new file mode 100644
index 0000000..99b8e54
--- /dev/null
+++ b/pirates/minigame/DistributedDefendEntranceAI.py
@@ -0,0 +1,144 @@
+from direct.directnotify import DirectNotifyGlobal
+from direct.task import Task
+from pirates.distributed.DistributedInteractiveAI import DistributedInteractiveAI
+from pirates.minigame import DefendGlobals
+from pirates.minigame.DistributedDefendWorldAI import DistributedDefendWorldAI
+
+
+class DistributedDefendEntranceAI(DistributedInteractiveAI):
+    """
+    The gold pile on Port Royal. A pirate who steps up to it is taken to a cannon defense: the one still at its
+    start or going on, or, if there is none, a fresh one (the Black Pearl entrance does the same).
+    """
+    notify = DirectNotifyGlobal.directNotify.newCategory('DistributedDefendEntranceAI')
+    MULTIUSE = True
+
+    BUILD_TIMEOUT = 30.0     # a new instance that has not come up by then is given up on
+    RETRY_INTERVAL = 0.3     # while a torn-down instance is still being deleted
+    MAX_RETRIES = 100
+
+    def __init__(self, air):
+        DistributedInteractiveAI.__init__(self, air)
+
+        self.building = False
+        self.waiting = []
+
+    def delete(self):
+        taskMgr.remove(self.uniqueName('buildTimeout'))
+        taskMgr.remove(self.uniqueName('startWhenClear'))
+        self.waiting = []
+        self.ignoreAll()
+        DistributedInteractiveAI.delete(self)
+
+    def setParentingRules(self, rule1, rule2):
+        pass
+
+    def handleRequestInteraction(self, avatar, interactType, instant):
+        return self.sendToDefense(avatar)
+
+    def handleRequestExit(self, avatar):
+        return self.ACCEPT
+
+    def sendToDefense(self, avatar):
+        """Teleport the avatar to a cannon defense. ACCEPT when one is on its way, DENY when the only one there is
+        is over with pirates still in it (the pirate tries again in a moment)"""
+        if self.building:
+            if avatar.doId not in self.waiting:
+                self.waiting.append(avatar.doId)
+
+            return self.ACCEPT
+
+        for obj in list(self.air.doId2do.values()):
+            if not isinstance(obj, DistributedDefendWorldAI) or obj.tornDown:
+                continue
+
+            if obj.isJoinable():
+                self._teleportWhenReady(avatar.doId, obj)
+                return self.ACCEPT
+
+            if obj.hasPlayersInside():
+                self.notify.info('Cannon defense %d is over with pirates in it, avatar %d waits' % (
+                    obj.doId, avatar.doId))
+                return self.DENY
+
+            # nobody is in it: it is over or abandoned
+            obj.teardown()
+
+        self.building = True
+        self.waiting = [avatar.doId]
+        self._startWhenClear(0)
+        return self.ACCEPT
+
+    def _teleportWhenReady(self, avatarId, instance):
+        if instance.isReady:
+            self._teleportTo(avatarId, instance)
+        else:
+            instance.pendingTeleportCallbacks.append(lambda: self._teleportTo(avatarId, instance))
+
+    def _teleportTo(self, avatarId, instance):
+        avatar = self.air.doId2do.get(avatarId)
+        if not avatar or instance.tornDown:
+            return
+
+        self.notify.info('Teleporting avatar %d to cannon defense %d' % (avatarId, instance.doId))
+        instance.addParticipant(avatarId)
+        spawnPt = instance.getSpawnPt(DefendGlobals.ISLAND_UID, 0)
+        self.air.teleportMgr.d_initiateTeleport(
+            avatar,
+            instanceType=instance.getType(),
+            instanceName=instance.getFileName(),
+            locationUid=DefendGlobals.ISLAND_UID,
+            spawnPt=spawnPt)
+
+    def _startWhenClear(self, tries):
+        """Build a fresh instance once no torn-down one is left in the tables (Astron tells this AI about each
+        deleted object a moment after the delete is requested)"""
+        old = [obj for obj in list(self.air.doId2do.values())
+               if isinstance(obj, DistributedDefendWorldAI) and obj.tornDown]
+        if old:
+            if tries >= self.MAX_RETRIES:
+                self.notify.warning('Cannon defense %d is still deleting after 30 s, not starting a new one' %
+                                    old[0].doId)
+                self._giveUp()
+                return
+
+            def retry(task):
+                self._startWhenClear(tries + 1)
+                return Task.done
+
+            taskMgr.doMethodLater(self.RETRY_INTERVAL, retry, self.uniqueName('startWhenClear'))
+            return
+
+        self._createInstance()
+
+    def _createInstance(self):
+        """Load the cannon island world: the world creator makes the instance, and the uid callback fires once it
+        is generated (the same way the Black Pearl instance is made)"""
+        self.notify.info('Building a cannon defense')
+        taskMgr.doMethodLater(self.BUILD_TIMEOUT, self._buildTimedOut, self.uniqueName('buildTimeout'))
+        self.air.worldCreator.loadObjectsFromFile(DefendGlobals.WORLD_FILE + '.py')
+        self.air.uidMgr.addUidCallback(DefendGlobals.REGION_UID, self._onInstanceCreated)
+
+    def _onInstanceCreated(self, instanceDoId):
+        taskMgr.remove(self.uniqueName('buildTimeout'))
+        waiting = self.waiting
+        self.building = False
+        self.waiting = []
+        instance = self.air.doId2do.get(instanceDoId)
+        if not instance:
+            self.notify.warning('Failed to get the cannon defense instance %d' % instanceDoId)
+            return
+
+        self.notify.info('Cannon defense instance %d created for %d pirates' % (instanceDoId, len(waiting)))
+        for avatarId in waiting:
+            self._teleportWhenReady(avatarId, instance)
+
+    def _buildTimedOut(self, task):
+        self.notify.warning('The cannon defense did not come up in %d s' % self.BUILD_TIMEOUT)
+        self._giveUp()
+        return Task.done
+
+    def _giveUp(self):
+        self.air.uidMgr.removeUidCallback(DefendGlobals.REGION_UID, self._onInstanceCreated)
+        self.building = False
+        self.waiting = []

diff --git a/pirates/battle/PotionBuffs.py b/pirates/battle/PotionBuffs.py
new file mode 100644
index 0000000..ec56511
--- /dev/null
+++ b/pirates/battle/PotionBuffs.py
@@ -0,0 +1,216 @@
+"""family server (11-21): what a brewed potion does when drunk. The potion table on Port Royal pays gold for a finished
+brew (0441) and now the pirate also drinks it: the original game's buff for that recipe, for the original time, with the
+original strength. Ids are WeaponConstants C_* (the original id + 60). The numbers are the original game's
+PotionGlobals.__potionBuffs; which buffs replace which is its dontStackList.
+
+Shared: the AI applies and ends buffs (applyPotion); the battle manager on both sides reads them (get*Bonus)."""
+from pirates.battle import WeaponConstants as W
+
+# the original game's recipe potionID + this = our effect id
+POTION_ID_OFFSET = 60
+
+DAMAGE = 'damage'
+
+# effect id -> (seconds, potency); potency is the fraction added (0.1 = +10%)
+BUFFS = {
+    W.C_CANNON_DAMAGE_LVL1: (180, 0.1), W.C_CANNON_DAMAGE_LVL2: (240, 0.15), W.C_CANNON_DAMAGE_LVL3: (300, 0.2),
+    W.C_PISTOL_DAMAGE_LVL1: (180, 0.1), W.C_PISTOL_DAMAGE_LVL2: (240, 0.15), W.C_PISTOL_DAMAGE_LVL3: (300, 0.2),
+    W.C_CUTLASS_DAMAGE_LVL1: (180, 0.1), W.C_CUTLASS_DAMAGE_LVL2: (240, 0.15), W.C_CUTLASS_DAMAGE_LVL3: (300, 0.2),
+    W.C_DOLL_DAMAGE_LVL1: (180, 0.1), W.C_DOLL_DAMAGE_LVL2: (240, 0.15), W.C_DOLL_DAMAGE_LVL3: (300, 0.2),
+    W.C_HASTEN_LVL1: (60, 0.3), W.C_HASTEN_LVL2: (180, 0.3), W.C_HASTEN_LVL3: (360, 0.3),
+    W.C_REP_BONUS_LVL1: (180, 0.15), W.C_REP_BONUS_LVL2: (180, 0.3),
+    W.C_GOLD_BONUS_LVL1: (180, 0.1), W.C_GOLD_BONUS_LVL2: (180, 0.2),
+    W.C_INVISIBILITY_LVL1: (60, 0), W.C_INVISIBILITY_LVL2: (120, 0),
+    W.C_REGEN_LVL1: (120, 0.03), W.C_REGEN_LVL2: (180, 0.03), W.C_REGEN_LVL3: (240, 0.03), W.C_REGEN_LVL4: (300, 0.03),
+    W.C_BURP: (50, 0), W.C_FART: (50, 0), W.C_VOMIT: (33, 0),
+    W.C_HEAD_GROW: (300, 0), W.C_CRAZY_SKIN_COLOR: (300, 0), W.C_SIZE_REDUCE: (300, 0), W.C_SIZE_INCREASE: (300, 0),
+    W.C_HEAD_FIRE: (300, 0),
+    W.C_ACCURACY_BONUS_LVL1: (180, 0.1), W.C_ACCURACY_BONUS_LVL2: (240, 0.15), W.C_ACCURACY_BONUS_LVL3: (300, 0.2),
+    W.C_REMOVE_GROGGY: (0, 0)}
+
+CANNON_DAMAGE = (W.C_CANNON_DAMAGE_LVL1, W.C_CANNON_DAMAGE_LVL2, W.C_CANNON_DAMAGE_LVL3)
+PISTOL_DAMAGE = (W.C_PISTOL_DAMAGE_LVL1, W.C_PISTOL_DAMAGE_LVL2, W.C_PISTOL_DAMAGE_LVL3)
+CUTLASS_DAMAGE = (W.C_CUTLASS_DAMAGE_LVL1, W.C_CUTLASS_DAMAGE_LVL2, W.C_CUTLASS_DAMAGE_LVL3)
+DOLL_DAMAGE = (W.C_DOLL_DAMAGE_LVL1, W.C_DOLL_DAMAGE_LVL2, W.C_DOLL_DAMAGE_LVL3)
+HASTEN = (W.C_HASTEN_LVL1, W.C_HASTEN_LVL2, W.C_HASTEN_LVL3)
+REP = (W.C_REP_BONUS_LVL1, W.C_REP_BONUS_LVL2)
+GOLD = (W.C_GOLD_BONUS_LVL1, W.C_GOLD_BONUS_LVL2)
+INVISIBILITY = (W.C_INVISIBILITY_LVL1, W.C_INVISIBILITY_LVL2)
+REGEN = (W.C_REGEN_LVL1, W.C_REGEN_LVL2, W.C_REGEN_LVL3, W.C_REGEN_LVL4)
+ACCURACY = (W.C_ACCURACY_BONUS_LVL1, W.C_ACCURACY_BONUS_LVL2, W.C_ACCURACY_BONUS_LVL3)
+SIZE = (W.C_SIZE_REDUCE, W.C_SIZE_INCREASE)
+GASSY = (W.C_BURP, W.C_FART, W.C_VOMIT)
+
+# drinking one takes these off first (the original dontStackList)
+_REPLACES = {}
+for _family in (CANNON_DAMAGE, PISTOL_DAMAGE, CUTLASS_DAMAGE, DOLL_DAMAGE, HASTEN, REP, GOLD, REGEN, ACCURACY):
+    for _id in _family:
+        _REPLACES[_id] = _family
+
+for _id in INVISIBILITY:
+    _REPLACES[_id] = INVISIBILITY + GASSY + SIZE + (W.C_HEAD_GROW, W.C_CRAZY_SKIN_COLOR, W.C_HEAD_FIRE)
+
+_REPLACES[W.C_BURP] = GASSY + INVISIBILITY
+_REPLACES[W.C_VOMIT] = GASSY + INVISIBILITY
+_REPLACES[W.C_FART] = GASSY + INVISIBILITY + SIZE
+_REPLACES[W.C_HEAD_GROW] = (W.C_HEAD_GROW,) + INVISIBILITY
+_REPLACES[W.C_CRAZY_SKIN_COLOR] = (W.C_CRAZY_SKIN_COLOR, W.C_HEAD_FIRE) + INVISIBILITY + SIZE
+for _id in SIZE:
+    _REPLACES[_id] = SIZE + INVISIBILITY + (W.C_CRAZY_SKIN_COLOR, W.C_HEAD_FIRE, W.C_FART)
+
+_REPLACES[W.C_HEAD_FIRE] = (W.C_HEAD_FIRE, W.C_CRAZY_SKIN_COLOR) + INVISIBILITY + SIZE
+_REPLACES[W.C_REMOVE_GROGGY] = ()
+
+# weapon reputation category -> its damage potions (InventoryType CannonRep / PistolRep / CutlassRep / DollRep)
+_DAMAGE_BY_REP = {13711: CANNON_DAMAGE, 13704: PISTOL_DAMAGE, 13703: CUTLASS_DAMAGE, 13709: DOLL_DAMAGE}
+
+REGEN_EVERY = 5.0
+
+
+def getEffectId(potionId):
+    """Our effect id for a recipe's potionID, or None when the potion has no buff."""
+    effectId = potionId + POTION_ID_OFFSET
+    if effectId in BUFFS:
+        return effectId
+
+    return None
+
+
+def isPotionBuff(effectId):
+    return effectId in BUFFS
+
+
+def buffIds(av):
+    """The effect ids on an avatar: the AI keeps [id, seconds, time, attacker] entries, the client a list of ids."""
+    if av is None or not hasattr(av, 'getSkillEffects'):
+        return []
+
+    try:
+        effects = av.getSkillEffects() or []
+    except Exception:
+        return []
+
+    return [e[0] if isinstance(e, (list, tuple)) else e for e in effects]
+
+
+def _best(av, family):
+    ids = buffIds(av)
+    return max([BUFFS[i][1] for i in family if i in ids] or [0])
+
+
+def getDamageBonus(av, repId):
+    family = _DAMAGE_BY_REP.get(repId)
+    if not family:
+        return 0
+
+    return _best(av, family)
+
+
+def getAccuracyBonus(av):
+    return _best(av, ACCURACY)
+
+
+def getRepBonus(av):
+    return _best(av, REP)
+
+
+def getGoldBonus(av):
+    return _best(av, GOLD)
+
+
+def hasInvisibility(av):
+    ids = buffIds(av)
+    return any(i in ids for i in INVISIBILITY)
+
+
+# ---------------- AI only ----------------
+def _taskName(doId, effectId):
+    return 'potionBuff-%d-%d' % (doId, effectId)
+
+
+def _regenTaskName(doId):
+    return 'potionRegen-%d' % doId
+
+
+def _setHaste(av, haste):
+    av.hasteMod = haste
+    av.sendUpdate('setHasteMod', [haste])
+
+
+def _endBuff(air, av, effectId):
+    from direct.task.TaskManagerGlobal import taskMgr
+    taskMgr.remove(_taskName(av.doId, effectId))
+    while av.hasSkillEffect(effectId):
+        av.expireSkillEffect(effectId)
+
+    if effectId in HASTEN and not any(i in buffIds(av) for i in HASTEN):
+        _setHaste(av, 0)
+
+    if effectId in REGEN and not any(i in buffIds(av) for i in REGEN):
+        taskMgr.remove(_regenTaskName(av.doId))
+
+
+def _removeGroggy(air, av):
+    inventory = air.inventoryManager.getInventory(av.doId) if hasattr(air, 'inventoryManager') else None
+    if not inventory:
+        return
+
+    inventory.setVitaeLeft(0)
+    inventory.setVitaeLevel(0)
+
+
+def applyPotion(air, av, potionId):
+    """The pirate drinks a potion of this recipe potionID. Returns the effect id given, or None."""
+    from direct.task.TaskManagerGlobal import taskMgr
+    effectId = getEffectId(potionId)
+    if effectId is None or av is None:
+        return None
+
+    seconds, potency = BUFFS[effectId]
+    if effectId == W.C_REMOVE_GROGGY:
+        _removeGroggy(air, av)
+        return effectId
+
+    for other in _REPLACES.get(effectId, ()):
+        if av.hasSkillEffect(other):
+            _endBuff(air, av, other)
+
+    av.addSkillEffect(effectId, seconds, av.doId)
+    doId = av.doId
+
+    def _expire(task):
+        if air.doId2do.get(doId) is av:
+            _endBuff(air, av, effectId)
+
+        return task.done
+
+    taskMgr.doMethodLater(seconds, _expire, _taskName(doId, effectId))
+
+    if effectId in HASTEN:
+        _setHaste(av, potency)
+
+    if effectId in REGEN:
+        taskMgr.remove(_regenTaskName(doId))
+
+        def _regen(task):
+            if air.doId2do.get(doId) is not av or not any(i in buffIds(av) for i in REGEN):
+                return task.done
+
+            hp, maxHp = av.getHp()[0], av.getMaxHp()
+            if 0 < hp < maxHp:
+                av.b_setHp(min(maxHp, hp + max(1, int(maxHp * potency))))
+
+            return task.again
+
+        taskMgr.doMethodLater(REGEN_EVERY, _regen, _regenTaskName(doId))
+
+    return effectId
+
+
+def clearPotions(av):
+    """The pirate is leaving: stop his buff timers (his effects go with the avatar)."""
+    from direct.task.TaskManagerGlobal import taskMgr
+    for effectId in BUFFS:
+        taskMgr.remove(_taskName(av.doId, effectId))
+
+    taskMgr.remove(_regenTaskName(av.doId))
diff --git a/pirates/battle/PotionFx.py b/pirates/battle/PotionFx.py
new file mode 100644
index 0000000..ecec441
--- /dev/null
+++ b/pirates/battle/PotionFx.py
@@ -0,0 +1,291 @@
+"""family server (11-21): what a drunk potion looks like on a pirate (client). The AI gives the buff (PotionBuffs);
+every client that sees the pirate gets it through setSkillEffects and plays it here, ported from the original game's
+PotionStatusEffectManager: burp, fart and barf every 15 seconds with their animation, sound and puff; a blue flame on
+the head; see-through for invisibility (gone to everyone else); shrink and grow; a bold skin colour; sparkles for the
+rest. Removing a buff plays the original wear-off sound."""
+import random
+from panda3d.core import Vec4
+from direct.interval.IntervalGlobal import *
+from pirates.battle import WeaponConstants as W
+from pirates.battle import PotionBuffs
+from pirates.effects.BurpEffect import BurpEffect
+from pirates.effects.FartEffect import FartEffect
+from pirates.effects.VomitEffect import VomitEffect
+from pirates.effects.BlueFlame import BlueFlame
+from pirates.effects.HealSparks import HealSparks
+from pirates.effects.HealRays import HealRays
+
+# the original PotionGlobals delays
+GASSY_EFFECT_DELAY = 15.0
+GENERIC_EFFECT_DELAY = 10.0
+
+# shrink and grow: the original sent the size from the server; these are ours
+SIZE_SCALE = {W.C_SIZE_REDUCE: 0.75, W.C_SIZE_INCREASE: 1.25}
+CRAZY_COLORS = (Vec4(0.2, 0.9, 0.2, 1), Vec4(0.3, 0.5, 1.0, 1), Vec4(1.0, 0.3, 0.8, 1), Vec4(1.0, 0.6, 0.1, 1),
+                Vec4(0.7, 0.3, 1.0, 1))
+
+# effect id -> (anim, sound names, effect class, seconds into the anim the puff starts, where the puff sits)
+GASSY = {
+    W.C_BURP: ('burp', ('burp', 'burp02', 'burp03'), BurpEffect, 1.2, lambda av: (0, 0.5, av.height - 0.6)),
+    W.C_FART: ('fart', ('fart', 'fart02', 'fart03', 'fart04', 'fart05'), FartEffect, 0.7,
+               lambda av: (0, -1.0, av.height / 2.0)),
+    W.C_VOMIT: ('barf', ('barf', 'barf02', 'barf03', 'barf04'), VomitEffect, 1.0, lambda av: (0, 0.6, av.height - 0.6))}
+
+_sounds = {}
+
+
+def _sfx(name):
+    if name not in _sounds:
+        _sounds[name] = loader.loadSfx('audio/sfx_pot_fx_%s.mp3' % name)
+
+    return _sounds[name]
+
+
+def _playSfx(av, name):
+    try:
+        SoundInterval(_sfx(name), node=av, cutOff=100).start()
+    except Exception:
+        pass
+
+
+class _AvatarPotionFx:
+
+    def __init__(self, av):
+        self.av = av
+        self.loops = {}
+        self.puffs = {}
+        self.headFire = None
+        self.sparks = None
+        self.rays = None
+        self.genericSeq = None
+        self.genericId = None
+        self.sizeIval = None
+        self.oldScale = None
+        self.oldColor = None
+        self.invisible = False
+
+    def geom(self):
+        return self.av.getGeomNode()
+
+    # -------- burp, fart, barf --------
+    def _puff(self, effectId):
+        anim, sounds, cls, delay, where = GASSY[effectId]
+        effect = cls.getEffect()
+        if effect:
+            effect.reparentTo(self.av)
+            effect.setPos(*where(self.av))
+            effect.effectScale = self.av.getEnemyScale()
+            effect.play()
+            self.puffs[effectId] = effect
+
+    def _gassyOnce(self, effectId):
+        anim, sounds, cls, delay, where = GASSY[effectId]
+        _playSfx(self.av, random.choice(sounds))
+        if self.av.getGameState() == 'LandRoam':
+            try:
+                self.av.actorInterval(anim, playRate=1.0, blendInT=0.2, blendOutT=0.2).start()
+            except Exception:
+                pass
+
+        taskMgr.doMethodLater(delay, self._puffLater, self._puffTask(effectId), extraArgs=[effectId])
+
+    def _puffLater(self, effectId):
+        self._puff(effectId)
+
+    def _puffTask(self, effectId):
+        return 'potionPuff-%s-%d' % (id(self), effectId)
+
+    def addGassy(self, effectId):
+        if effectId in self.loops:
+            return
+
+        loop = Sequence(Wait(0.75), Func(self._gassyOnce, effectId), Wait(GASSY_EFFECT_DELAY - 0.75))
+        self.loops[effectId] = loop
+        loop.loop()
+
+    def removeGassy(self, effectId):
+        loop = self.loops.pop(effectId, None)
+        if loop:
+            loop.pause()
+
+        taskMgr.remove(self._puffTask(effectId))
+        effect = self.puffs.pop(effectId, None)
+        if effect:
+            effect.stop()
+
+    # -------- head fire --------
+    def addHeadFire(self):
+        if self.headFire:
+            return
+
+        self.headFire = BlueFlame.getEffect()
+        if self.headFire:
+            self.headFire.reparentTo(self.av)
+            self.headFire.setPos(0, 0, self.av.height * 0.8)
+            self.headFire.effectScale = 0.3 * self.av.getEnemyScale()
+            self.headFire.startLoop()
+
+    def removeHeadFire(self):
+        if self.headFire:
+            self.headFire.stopLoop()
+            self.headFire = None
+
+    # -------- invisibility --------
+    def setInvisible(self, invisible):
+        if invisible == self.invisible:
+            return
+
+        self.invisible = invisible
+        geom = self.geom()
+        if self.av.isLocal():
+            if invisible:
+                geom.setTransparency(1)
+                geom.setAlphaScale(0.35)
+            else:
+                geom.setAlphaScale(1.0)
+                geom.clearTransparency()
+        elif invisible:
+            geom.hide()
+        else:
+            geom.show()
+
+    # -------- shrink and grow --------
+    def setSize(self, factor):
+        geom = self.geom()
+        if self.oldScale is None:
+            self.oldScale = geom.getScale()
+
+        if self.sizeIval:
+            self.sizeIval.finish()
+
+        self.sizeIval = LerpScaleInterval(geom, 1.0, self.oldScale * factor, blendType='easeInOut')
+        self.sizeIval.start()
+        if factor == 1.0:
+            self.oldScale = None
+
+    # -------- crazy skin colour --------
+    def setCrazyColor(self, on):
+        geom = self.geom()
+        if on:
+            if self.oldColor is None:
+                self.oldColor = geom.getColorScale()
+
+            geom.setColorScale(random.choice(CRAZY_COLORS))
+        elif self.oldColor is not None:
+            geom.setColorScale(self.oldColor)
+            self.oldColor = None
+
+    # -------- everything else: sparkles --------
+    def addGeneric(self, effectId):
+        if self.genericSeq and self.genericSeq.isPlaying():
+            return
+
+        self.genericId = effectId
+        self.genericSeq = Sequence(Func(self._startSparkles), Func(_playSfx, self.av, 'sparkle'),
+                                   Wait(GENERIC_EFFECT_DELAY), Func(self._stopSparkles))
+        self.genericSeq.start()
+
+    def _startSparkles(self):
+        if base.options.getSpecialEffectsSetting() >= base.options.SpecialEffectsMedium:
+            self.sparks = HealSparks.getEffect()
+            if self.sparks:
+                self.sparks.reparentTo(self.av)
+                self.sparks.setPos(0, 0, 4)
+                self.sparks.setScale(1.5, 1.5, 2)
+                self.sparks.setEffectColor(Vec4(0.3, 1, 1, 0.3))
+                self.sparks.startLoop()
+
+        if base.options.getSpecialEffectsSetting() >= base.options.SpecialEffectsHigh:
+            self.rays = HealRays.getEffect()
+            if self.rays:
+                self.rays.reparentTo(self.av)
+                self.rays.setPos(0, 0, 4)
+                self.rays.setScale(0.75, 0.75, 2)
+                self.rays.setEffectColor(Vec4(0.3, 1, 1, 1))
+                self.rays.startLoop()
+
+    def _stopSparkles(self):
+        for effect in (self.sparks, self.rays):
+            if effect:
+                effect.stopLoop()
+
+        self.sparks = self.rays = None
+
+    def removeGeneric(self, effectId):
+        if effectId == self.genericId and self.genericSeq:
+            self.genericSeq.finish()
+            self.genericSeq = None
+            self.genericId = None
+
+    def clear(self):
+        for effectId in list(self.loops):
+            self.removeGassy(effectId)
+
+        self.removeHeadFire()
+        if self.genericSeq:
+            self.genericSeq.finish()
+            self.genericSeq = None
+
+        if self.sizeIval:
+            self.sizeIval.finish()
+            self.sizeIval = None
+
+        self.setInvisible(False)
+        self.setCrazyColor(False)
+        if self.oldScale is not None:
+            self.geom().setScale(self.oldScale)
+            self.oldScale = None
+
+
+def _fx(av, make=True):
+    fx = getattr(av, '_potionFx', None)
+    if fx is None and make:
+        fx = av._potionFx = _AvatarPotionFx(av)
+
+    return fx
+
+
+def addStatusEffect(av, effectId):
+    fx = _fx(av)
+    if effectId in GASSY:
+        fx.addGassy(effectId)
+    elif effectId == W.C_HEAD_FIRE:
+        fx.addHeadFire()
+    elif effectId in PotionBuffs.INVISIBILITY:
+        fx.setInvisible(True)
+    elif effectId in SIZE_SCALE:
+        _playSfx(av, 'shrink' if SIZE_SCALE[effectId] < 1.0 else 'grow')
+        fx.setSize(SIZE_SCALE[effectId])
+    elif effectId == W.C_CRAZY_SKIN_COLOR:
+        _playSfx(av, 'transformation')
+        fx.setCrazyColor(True)
+    else:
+        fx.addGeneric(effectId)
+
+
+def removeStatusEffect(av, effectId):
+    fx = _fx(av)
+    if effectId in GASSY:
+        fx.removeGassy(effectId)
+    elif effectId == W.C_HEAD_FIRE:
+        fx.removeHeadFire()
+    elif effectId in PotionBuffs.INVISIBILITY:
+        fx.setInvisible(False)
+    elif effectId in SIZE_SCALE:
+        fx.setSize(1.0)
+    elif effectId == W.C_CRAZY_SKIN_COLOR:
+        fx.setCrazyColor(False)
+    else:
+        fx.removeGeneric(effectId)
+
+    _playSfx(av, 'debuff')
+
+
+def clear(av):
+    fx = _fx(av, make=False)
+    if fx:
+        av._potionFx = None
+        try:
+            fx.clear()
+        except Exception:
+            pass
